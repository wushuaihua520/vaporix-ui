<template>
	<view class="pnav">
		<view :class="prevClass" hover-class="pnav__item--pressed" :hover-stay-time="120" @click="goPrev">
			<view class="pnav__copy">
				<text class="pnav__label">上一个</text>
				<view class="pnav__name-row">
					<view v-if="prev != null" class="pnav__tile">
						<vx-icon :name="prev.icon" size="sm" color="var(--vx-color-primary)" />
					</view>
					<text class="pnav__name">{{ prev != null ? prev.name : '已经是第一个' }}</text>
				</view>
			</view>
		</view>
		<view :class="nextClass" hover-class="pnav__item--pressed" :hover-stay-time="120" @click="goNext">
			<view class="pnav__copy pnav__copy--end">
				<text class="pnav__label">下一个</text>
				<view class="pnav__name-row pnav__name-row--end">
					<text class="pnav__name">{{ next != null ? next.name : '已经是最后一个' }}</text>
					<view v-if="next != null" class="pnav__tile pnav__tile--end">
						<vx-icon :name="next.icon" size="sm" color="var(--vx-color-primary)" />
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	// 示例页统一的上/下一个导航：邻居和图标都从组件目录（catalog.ts）查表，
	// 页面只传 currentKey，不用再维护 prevPath / nextPath 一套变量。
	// 图标来自目录里登记的 icon 字段，装在主色浅底的小圆角块里，和页头的徽标、分区条同一套令牌。
	import { DEMO_COMPONENTS, demoPagePath } from '@/pages/demo/shared/catalog'
	import type { DemoComponent } from '@/pages/demo/shared/catalog'

	const props = defineProps<{
		/** 当前页面的组件 key，如 'button' */
		currentKey: string
	}>()

	let current = -1
	for (let i = 0; i < DEMO_COMPONENTS.length; i++) {
		if (DEMO_COMPONENTS[i].key === props.currentKey) {
			current = i
			break
		}
	}

	const prev: DemoComponent | null = current > 0 ? DEMO_COMPONENTS[current - 1] : null
	const next: DemoComponent | null =
		current > -1 && current < DEMO_COMPONENTS.length - 1 ? DEMO_COMPONENTS[current + 1] : null

	const prevClass = 'pnav__item' + (prev == null ? ' pnav__item--disabled' : '')
	const nextClass = 'pnav__item pnav__item--next' + (next == null ? ' pnav__item--disabled' : '')

	const goPrev = () => {
		if (prev == null) return
		uni.redirectTo({ url: demoPagePath(prev.key) })
	}

	const goNext = () => {
		if (next == null) return
		uni.redirectTo({ url: demoPagePath(next.key) })
	}
</script>

<style>
	/* 视觉基准来自 demo.css 的 demo-page-nav，换成组件自带的 pnav 前缀，自包含。
	   布局是「图标块 + 文字栈」的列表项：上一个图标块在左，下一个镜像在右。 */
	.pnav {
		flex-direction: row;
		margin-top: var(--vx-space-xl);
	}

	.pnav__item {
		flex: 1;
		min-height: 56px;
		flex-direction: row;
		align-items: center;
		padding: var(--vx-space-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-surface);
		margin-right: var(--vx-space-sm);
	}

	.pnav__item--next {
		margin-right: 0;
	}

	.pnav__item--pressed {
		background-color: var(--vx-color-surface-pressed);
	}

	.pnav__item--disabled {
		opacity: var(--vx-opacity-disabled);
	}

	/* 组件图标块：主色浅底小圆角块，和徽标、分区竖条同一套颜色。
	   图标块收在名字行内、与名字并排：标签、名字、图标块三者的边线全部对齐到同一条 padding 线。 */
	.pnav__tile {
		width: 28px;
		height: 28px;
		align-items: center;
		justify-content: center;
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-primary-soft);
		margin-right: var(--vx-space-sm);
	}

	/* 下一个的图标块镜像在名字右侧：间距换到左边，右边重新贴回 padding 线 */
	.pnav__tile--end {
		margin-left: var(--vx-space-sm);
		margin-right: 0;
	}

	.pnav__copy {
		flex: 1;
	}

	/* 下一个的文字栈靠右对齐 */
	.pnav__copy--end {
		align-items: flex-end;
	}

	.pnav__label {
		color: var(--vx-color-text-secondary);
		font-size: 12px;
		line-height: var(--vx-line-sm);
	}

	.pnav__name-row {
		flex-direction: row;
		align-items: center;
		margin-top: var(--vx-space-xs);
	}

	.pnav__name-row--end {
		justify-content: flex-end;
	}

	.pnav__name {
		color: var(--vx-color-text);
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-medium);
	}
</style>
