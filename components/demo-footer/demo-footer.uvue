<template>
	<view class="dfoot">
		<vx-footer style="padding-top: 12px; padding-bottom: 12px;">
			<vx-text :text="title" size="sm" weight="semibold" type="secondary" align="center" block />
			<view class="dfoot__sub">
				<vx-text :text="sub" size="sm" type="secondary" align="center" block />
			</view>
		</vx-footer>
	</view>
</template>

<script setup>
	import { DEMO_VERSION } from '@/pages/demo/shared/catalog'

	// 示例页统一页脚：默认文案跟免费库走，版本号单源在 catalog.ts（发版对 package.json）；
	// 首页等要换自己文案的页面传 title / sub，版式不变。
	// 注意 defineProps 默认值会被提升到 setup 外，只能引用模块级的 import，不能引 setup 内局部常量。
	withDefaults(defineProps<{
		title?: string
		sub?: string
	}>(), {
		title: '元汽UI · MIT',
		sub: 'VAPORIX UI · 组件演示 · ' + DEMO_VERSION
	})
</script>

<style>
