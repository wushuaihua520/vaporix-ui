<template>
	<view class="dfoot">
		<vx-footer style="padding-top: 12px; padding-bottom: 12px;">
			<vx-text :text="title" size="sm" weight="semibold" type="secondary" align="center" block />
			<view class="dfoot__sub">
				<vx-text :text="sub" size="sm" type="secondary" align="center" block />
			</view>
		</vx-footer>
	</view>
</template>

<script setup>
	// 示例页统一页脚：默认文案跟免费库走，发版时与 uni_modules/vaporix-ui/package.json 的
