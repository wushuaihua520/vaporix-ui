<template>
	<!-- 步骤条只画节点、连线和文字；表单、按钮和主操作放在外面。 -->
	<!-- 当前步骤用勾标记到达位置，带 icon 时换成图标；之前的步骤保留圆点或序号。 -->
	<view v-if="rows.length > 0" :class="rootClass">
		<view v-for="row in rows" :key="row.index" :class="row.itemClass" :hover-class="hoverClass"
			:hover-stay-time="VX_PRESSED_STAY_TIME">
			<!-- 连线拆成前后两半，各画在本步边界内：小程序和 App 的 view 都裁切溢出，跨步的整线会被截断。
			     后半从本节点中心画到步边缘，前半从步边缘接到本节点中心，拼起来仍是中心到中心。 -->
			<view v-if="row.lineInClass.length > 0" :class="row.lineInClass"></view>
			<view v-if="row.lineOutClass.length > 0" :class="row.lineOutClass"></view>

			<view :class="markerBoxClass">
				<view v-if="row.dot" :class="row.dotClass"></view>
				<view v-else :class="row.markerClass">
					<!-- 图标 14 / 18 / 22 放进 20 / 24 / 28 的节点，size 直接传下去。 -->
					<vx-icon v-if="row.hasIcon" :name="row.icon" :size="size" :variant="row.iconVariant" :type="type"
						:color="row.iconColor" />
					<text v-else-if="row.hasNumber" :class="row.numberClass">{{ row.number }}</text>
					<vx-icon v-else name="check" :size="size" :color="row.iconColor" />
				</view>
			</view>

			<view v-if="row.hasContent" :class="contentClass">
				<text v-if="row.title.length > 0" :class="row.titleClass">{{ row.title }}</text>
				<text v-if="row.description.length > 0" :class="row.descClass">{{ row.description }}</text>
				<text v-if="row.time.length > 0" :class="row.timeClass">{{ row.time }}</text>
			</view>

			<!-- 可点击时铺一层透明热区；不可点击时不挂这一层，点击继续落到外层。 -->
			<view v-if="clickable" class="vx-steps__hit" @click.stop="onClick(row.index)"></view>
		</view>
	</view>
</template>

<script setup>
	import { VxStepsProps, VxStepItem } from './props'
	import { VxIconName } from '../../libs/icons/codepoints'
	import { VxIconVariant } from '../../libs/types/common'
	import { VX_PRESSED_STAY_TIME } from '../../libs/motion'

	const props = withDefaults(defineProps<VxStepsProps>(), {
		items: (): Array<VxStepItem> => [],
		active: 0,
		direction: 'horizontal',
		variant: 'dot',
		size: 'md',
		type: 'primary',
		lineStyle: 'solid',
		clickable: false
	})

	const emit = defineEmits<{
		click: [index: number]
	}>()

	type StepsRow = {
		index: number
		itemClass: string
		lineInClass: string
		lineOutClass: string
		dot: boolean
		dotClass: string
		markerClass: string
		hasIcon: boolean
		icon: VxIconName
		iconVariant: VxIconVariant
		iconColor: string
		hasNumber: boolean
		number: string
		numberClass: string
		hasContent: boolean
		title: string
		titleClass: string
		description: string
		descClass: string
		time: string
		timeClass: string
	}

	// 当前步骤从 0 开始。负数在取整前就按未开始，避免 -0.4 被收成 0。
	const currentIndex = computed((): number => {
		const raw = props.active
		if (!(raw >= 0)) return -1
		const value = Math.round(raw)
		const last = props.items.length - 1
		if (value > last) return last
		return value
	})

	const rootClass = computed((): string => {
		const direction = props.direction === 'vertical' ? 'vertical' : 'horizontal'
		return `vx-steps vx-steps--${direction}`
	})

	// 空字符串关不掉按下态，要写 none。
	const hoverClass = computed((): string => {
		if (!props.clickable) return 'none'
		return 'vx-steps__item--pressed'
	})

	const markerBoxClass = computed((): string => {
		if (props.size === 'sm') return 'vx-steps__marker-box vx-steps__marker-box--sm'
		if (props.size === 'lg') return 'vx-steps__marker-box vx-steps__marker-box--lg'
		return 'vx-steps__marker-box'
	})

	const contentClass = computed((): string => {
		const vertical = props.direction === 'vertical'
		let name = 'vx-steps__content'
		name += vertical ? ' vx-steps__content--vertical' : ' vx-steps__content--horizontal'
		if (props.size === 'sm') name += vertical ? ' vx-steps__content--vertical-sm' : ' vx-steps__content--horizontal-sm'
		else if (props.size === 'lg') name += vertical ? ' vx-steps__content--vertical-lg' : ' vx-steps__content--horizontal-lg'
		return name
	})

	// 尺寸、方向和语义色整组相同，class 在循环外拼好；循环里只挑状态、图标和留白。
	// 连线的进出段和尺寸 class 写在方向后面，才能盖过 md 的 top / left / height。语义色写在最后。
	const rows = computed((): Array<StepsRow> => {
		const list: Array<StepsRow> = []
		const source = props.items
		const count = source.length
		const current = currentIndex.value
		const vertical = props.direction === 'vertical'
		const number = props.variant === 'number'
		const typeName = props.type
		const size = props.size
		// 实心节点上的图标要用 on-*。已完成图标不传 color，交给 vx-icon 的 type，warning-ink 不在这里再写一份。
		// 选择器写不到 vx-icon 内部的 text。
		const iconOn = typeName === 'default' ? 'var(--vx-color-text-inverse)' : `var(--vx-color-on-${typeName})`
		const iconPending = 'var(--vx-color-text-secondary)'

		const itemClick = props.clickable ? ' vx-steps__item--clickable' : ''
		const itemHorizontal = 'vx-steps__item vx-steps__item--horizontal' + itemClick
		const itemVertical = 'vx-steps__item vx-steps__item--vertical' + itemClick
		const itemVerticalLast = 'vx-steps__item vx-steps__item--vertical vx-steps__item--last' + itemClick

		let markerBase = 'vx-steps__marker'
		let dotBase = 'vx-steps__dot'
		let numBase = 'vx-steps__num'
		if (size === 'sm') {
			markerBase += ' vx-steps__marker--sm'
			dotBase += ' vx-steps__dot--sm'
			numBase += ' vx-steps__num--sm'
		} else if (size === 'lg') {
			markerBase += ' vx-steps__marker--lg'
			dotBase += ' vx-steps__dot--lg'
			numBase += ' vx-steps__num--lg'
		}
		const markerOutline = markerBase + ' vx-steps__marker--outline'
		const markerFill = markerBase + ` vx-steps__marker--fill-${typeName}`
		const markerSoft = markerBase + ` vx-steps__marker--soft-${typeName}`
		const dotDone = dotBase + ` vx-steps__dot--${typeName}`
		const numDone = numBase + ` vx-steps__num--${typeName}`

		let titleBase = 'vx-steps__title'
		if (size === 'sm') titleBase += ' vx-steps__title--sm'
		else if (size === 'lg') titleBase += ' vx-steps__title--lg'
		if (vertical) titleBase += ' vx-steps__title--vertical'
		const titlePending = titleBase + ' vx-steps__title--pending'
		// default 的当前标题就是正文色，不再挂一层同色 class。
		const titleCurrent = typeName === 'default' ? titleBase : titleBase + ` vx-steps__title--${typeName}`

		let descBase = 'vx-steps__desc'
		if (size === 'sm') descBase += ' vx-steps__desc--sm'
		if (vertical) descBase += ' vx-steps__desc--vertical'
		const descOffset = descBase + ' vx-steps__desc--offset'

		const timeBase = vertical ? 'vx-steps__time vx-steps__time--vertical' : 'vx-steps__time'
		const timeOffset = timeBase + ' vx-steps__time--offset'

		let lineIn = vertical ? 'vx-steps__line vx-steps__line--vertical vx-steps__line--vertical-in' : 'vx-steps__line vx-steps__line--horizontal vx-steps__line--horizontal-in'
		let lineOut = vertical ? 'vx-steps__line vx-steps__line--vertical vx-steps__line--vertical-out' : 'vx-steps__line vx-steps__line--horizontal vx-steps__line--horizontal-out'
		if (size === 'sm') {
			lineIn += vertical ? ' vx-steps__line--vertical-in-sm' : ' vx-steps__line--horizontal-sm'
			lineOut += vertical ? ' vx-steps__line--vertical-out-sm' : ' vx-steps__line--horizontal-sm'
		} else if (size === 'lg') {
			lineIn += vertical ? ' vx-steps__line--vertical-in-lg' : ' vx-steps__line--horizontal-lg'
			lineOut += vertical ? ' vx-steps__line--vertical-out-lg' : ' vx-steps__line--horizontal-lg'
		}
		if (props.lineStyle === 'dashed') {
			lineIn += ' vx-steps__line--dashed'
			lineOut += ' vx-steps__line--dashed'
		}
		const lineInDone = lineIn + ` vx-steps__line--${typeName}`
		const lineOutDone = lineOut + ` vx-steps__line--${typeName}`

		for (let index = 0; index < count; index++) {
			const entry = source[index]
			const title = entry.title != null ? entry.title : ''
			const description = entry.description != null ? entry.description : ''
			const time = entry.time != null ? entry.time : ''
			const named = entry.icon
			const hasIcon = named != null && named.length > 0
			// 没图标时给一个合法名字，模板只在 hasIcon 时渲染。
			let icon: VxIconName = 'check'
			if (hasIcon && named != null) icon = named
			const iconVariant = entry.iconVariant != null ? entry.iconVariant : 'regular'
			const isCurrent = current >= 0 && index === current
			const isCompleted = current >= 0 && index < current
			const last = index === count - 1

			let itemClass = itemHorizontal
			if (vertical) itemClass = last ? itemVerticalLast : itemVertical

			// 点状节点的完成态和待处理态是小圆点，当前步骤和数字节点用完整节点。
			const dot = !hasIcon && !number && !isCurrent
			let markerClass = markerOutline
			if (isCurrent || (isCompleted && number && !hasIcon)) markerClass = markerFill
			else if (isCompleted && hasIcon) markerClass = markerSoft

			let iconColor = ''
			if (isCurrent) iconColor = iconOn
			else if (!isCompleted) iconColor = iconPending

			const hasNumber = number && !hasIcon && !isCurrent
			let titleClass = titleBase
			if (isCurrent) titleClass = titleCurrent
			else if (!isCompleted) titleClass = titlePending

			// 前半段属于上一步的进度：上一步完成就染语义色；后半段看本步是否完成。
			let lineInClass = ''
			if (index > 0) lineInClass = index - 1 < current ? lineInDone : lineIn
			let lineOutClass = ''
			if (!last) lineOutClass = index < current ? lineOutDone : lineOut

			list.push({
				index: index,
				itemClass: itemClass,
				lineInClass: lineInClass,
				lineOutClass: lineOutClass,
				dot: dot,
				dotClass: isCompleted ? dotDone : dotBase,
				markerClass: markerClass,
				hasIcon: hasIcon,
				icon: icon,
				iconVariant: iconVariant,
				iconColor: iconColor,
				hasNumber: hasNumber,
				number: `${index + 1}`,
				numberClass: isCompleted ? numDone : numBase,
				hasContent: title.length > 0 || description.length > 0 || time.length > 0,
				title: title,
				titleClass: titleClass,
				description: description,
				descClass: title.length > 0 ? descOffset : descBase,
				time: time,
				timeClass: title.length > 0 || description.length > 0 ? timeOffset : timeBase
			})
		}
		return list
	})

	// 热区只在 clickable 时挂上，点击停在步骤上。
	const onClick = (index: number) => {
		emit('click', index)
	}
</script>

<style>
	/* App 不能把自定义变量定义成另一个 var()。
	   同一元素上，class 字符串里靠后的声明盖过靠前的；样式表顺序与此一致。 */

	/* 步骤条只占父级宽度，不加外部间距；放进卡片时由卡片内边距收口。
	   横向每步等宽，纵向每步占满一行。 */
	.vx-steps {
		width: 100%;
		min-width: 0;
	}

	.vx-steps--horizontal {
		flex-direction: row;
		align-items: flex-start;
	}

	.vx-steps--vertical {
		flex-direction: column;
		align-items: stretch;
	}

	/* 横向每一步等宽，节点在列中居中；纵向是节点列加内容，行间留 24。 */
	.vx-steps__item {
		position: relative;
		min-width: 0;
	}

	.vx-steps__item--horizontal {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.vx-steps__item--vertical {
		flex-direction: row;
		align-items: flex-start;
		width: 100%;
		padding-bottom: var(--vx-space-xl);
	}

	.vx-steps__item--last {
		padding-bottom: 0;
	}

	/* #ifdef WEB */
	.vx-steps__item--clickable {
		cursor: pointer;
	}
	/* #endif */

	/* 可点击时透明热区铺满整步。不写 hover-stop-propagation，按下态仍冒到 item。
	   App 上没有背景的定位层经常接不到点击，全透明也要占一块背景。 */
	.vx-steps__hit {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2;
		background-color: rgba(0, 0, 0, 0);
	}

	.vx-steps__item--pressed {
		opacity: var(--vx-opacity-pressed);
	}

	/* 节点列固定成节点直径，压住连线；横向由 item 居中，纵向靠左。 */
	.vx-steps__marker-box {
		position: relative;
		z-index: 1;
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: var(--vx-steps-node-md);
		height: var(--vx-steps-node-md);
	}

	.vx-steps__marker-box--sm {
		width: var(--vx-steps-node-sm);
		height: var(--vx-steps-node-sm);
	}

	.vx-steps__marker-box--lg {
		width: var(--vx-steps-node-lg);
		height: var(--vx-steps-node-lg);
	}

	/* 完整节点默认留一圈透明描边，待处理态只换描边色，尺寸不跳。 */
	.vx-steps__marker {
		box-sizing: border-box;
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: var(--vx-steps-node-md);
		height: var(--vx-steps-node-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: transparent;
		border-radius: var(--vx-radius-pill);
		background-color: var(--vx-color-surface);
	}

	.vx-steps__marker--sm {
		width: var(--vx-steps-node-sm);
		height: var(--vx-steps-node-sm);
	}

	.vx-steps__marker--lg {
		width: var(--vx-steps-node-lg);
		height: var(--vx-steps-node-lg);
	}

	.vx-steps__marker--outline {
		border-color: var(--vx-color-border);
	}

	/* 完成态和待处理态的小圆点；当前步骤不用它，改成完整节点里的勾。 */
	.vx-steps__dot {
		flex-shrink: 0;
		width: var(--vx-steps-dot-md);
		height: var(--vx-steps-dot-md);
		border-radius: var(--vx-radius-pill);
		background-color: var(--vx-color-text-secondary);
	}

	.vx-steps__dot--sm {
		width: var(--vx-steps-dot-sm);
		height: var(--vx-steps-dot-sm);
	}

	.vx-steps__dot--lg {
		width: var(--vx-steps-dot-lg);
		height: var(--vx-steps-dot-lg);
	}

	/* 序号用节点自己的字号档，和 20 / 24 / 28 的盒子配套。 */
	.vx-steps__num {
		flex-shrink: 0;
		color: var(--vx-color-text-secondary);
		font-size: var(--vx-steps-font-md);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		text-align: center;
	}

	.vx-steps__num--sm {
		font-size: var(--vx-steps-font-sm);
	}

	.vx-steps__num--lg {
		font-size: var(--vx-steps-font-lg);
		line-height: var(--vx-line-lg);
	}

	/* 内容吃掉剩余宽度，长文案换行，不把节点挤窄。 */
	.vx-steps__content {
		flex-direction: column;
		min-width: 0;
		overflow: hidden;
	}

	.vx-steps__content--horizontal {
		width: 100%;
		align-items: center;
		margin-top: var(--vx-space-md);
	}

	.vx-steps__content--horizontal-sm {
		margin-top: var(--vx-space-sm);
	}

	.vx-steps__content--horizontal-lg {
		margin-top: var(--vx-space-lg);
	}

	.vx-steps__content--vertical {
		flex: 1;
		align-items: flex-start;
		margin-left: var(--vx-space-md);
	}

	.vx-steps__content--vertical-sm {
		margin-left: var(--vx-space-sm);
	}

	.vx-steps__content--vertical-lg {
		margin-left: var(--vx-space-lg);
	}

	/* App 默认 keep、Web 默认 pre-line，写明 normal 才会换行。
	   纵向 flex 里收缩发生在高度上，文字不压缩。 */
	.vx-steps__title,
	.vx-steps__desc,
	.vx-steps__time {
		flex-shrink: 0;
		min-width: 0;
		width: 100%;
		white-space: normal;
	}

	/* 横向文案跟节点居中对齐；纵向改成左对齐。 */
	.vx-steps__title {
		color: var(--vx-color-text);
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-semibold);
		text-align: center;
	}

	.vx-steps__title--sm {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
	}

	.vx-steps__title--lg {
		font-size: var(--vx-font-lg);
		line-height: var(--vx-line-lg);
	}

	.vx-steps__title--vertical {
		text-align: left;
	}

	.vx-steps__title--pending {
		color: var(--vx-color-text-secondary);
	}

	/* 说明是辅助信息，三档里 sm 收到 13 / 20，md / lg 用 15 / 22。 */
	.vx-steps__desc {
		color: var(--vx-color-text-secondary);
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-regular);
		text-align: center;
	}

	.vx-steps__desc--sm {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
	}

	.vx-steps__desc--vertical {
		text-align: left;
	}

	.vx-steps__desc--offset,
	.vx-steps__time--offset {
		margin-top: var(--vx-space-xs);
	}

	/* 时间固定 13 / 20，三档都保持同一行高。 */
	.vx-steps__time {
		color: var(--vx-color-text-secondary);
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-regular);
		text-align: center;
	}

	.vx-steps__time--vertical {
		text-align: left;
	}

	/* 连线用 1px 边框画，solid / dashed 只换 border-style。
	   四边宽度先归零，只留一侧 1px；否则其余三边取默认 medium，线会被撑粗并向下 / 向右偏。
	   横向 translateY(-50%)、纵向 translateX(-50%) 让 1px 线压在节点中心。
	   小程序和 App 的 view 都裁切溢出，连线不能跨步：拆成前后两半各画在本步内，
	   后半从节点中心到步边缘，前半从步边缘到节点中心，前半颜色跟上一步进度。 */
	.vx-steps__line {
		box-sizing: border-box;
		position: absolute;
		z-index: 0;
		border-width: 0;
		border-style: solid;
		border-color: var(--vx-color-border);
	}

	.vx-steps__line--horizontal {
		top: var(--vx-steps-center-md);
		height: var(--vx-border-width);
		border-top-width: var(--vx-border-width);
		transform: translateY(-50%);
	}

	.vx-steps__line--horizontal-in {
		left: 0;
		width: 50%;
	}

	.vx-steps__line--horizontal-out {
		left: 50%;
		width: 50%;
	}

	.vx-steps__line--horizontal-sm {
		top: var(--vx-steps-center-sm);
	}

	.vx-steps__line--horizontal-lg {
		top: var(--vx-steps-center-lg);
	}

	.vx-steps__line--vertical {
		left: var(--vx-steps-center-md);
		width: var(--vx-border-width);
		border-left-width: var(--vx-border-width);
		transform: translateX(-50%);
	}

	.vx-steps__line--vertical-in {
		top: 0;
		height: var(--vx-steps-center-md);
	}

	.vx-steps__line--vertical-out {
		top: var(--vx-steps-center-md);
		bottom: 0;
	}

	.vx-steps__line--vertical-in-sm {
		left: var(--vx-steps-center-sm);
		height: var(--vx-steps-center-sm);
	}

	.vx-steps__line--vertical-out-sm {
		left: var(--vx-steps-center-sm);
		top: var(--vx-steps-center-sm);
	}

	.vx-steps__line--vertical-in-lg {
		left: var(--vx-steps-center-lg);
		height: var(--vx-steps-center-lg);
	}

	.vx-steps__line--vertical-out-lg {
		left: var(--vx-steps-center-lg);
		top: var(--vx-steps-center-lg);
	}

	.vx-steps__line--dashed {
		border-style: dashed;
	}

	/* 语义色写在节点自己的 class 上。不能用后代选择器，也不能把变量再套一层 var()。
