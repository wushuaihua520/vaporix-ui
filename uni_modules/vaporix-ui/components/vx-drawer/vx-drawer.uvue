<template>
	<!-- 抽屉是贴边浮层：遮罩铺满页面，面板从一条边滑出。挂在页面根节点，放进 scroll-view 会被裁掉。 -->
	<!-- 点遮罩、点关闭叉都收起并抛 close；open() / close() 只改 show。 -->
	<!-- 触摸只拦遮罩、头部和底栏：正文的 scroll-view 要接住手势，面板不能监听 touchmove。 -->
	<!-- 第一次打开后根节点常驻，关闭只切隐藏 class，不再卸载；正文的原生 scroll-view 也只创建一次。 -->
	<view v-if="rendered" :class="rootClass" :style="rootStyle">
		<view :class="maskClass" :style="maskStyle" @click="onMaskTap" @touchmove.stop.prevent></view>

		<!-- 外层只留阴影和圆角，内层裁出四角；App 默认 hidden 会把画出盒子的阴影裁掉。 -->
		<view :class="sheetClass" :style="sheetStyle" @click.stop>
			<view :class="panelClass" :style="panelStyle">
				<!-- 标题、关闭叉、prefix、extra 都没有时不渲染头部，正文直接从圆角内侧开始。 -->
				<view v-if="title.length > 0 || closable || $slots['prefix'] != null || $slots['extra'] != null"
					class="vx-drawer__head" @touchmove.stop.prevent>
					<view :class="headerClass">
						<view class="vx-drawer__heading">
							<view v-if="$slots['prefix'] != null" class="vx-drawer__prefix">
								<slot name="prefix"></slot>
							</view>
							<text v-if="title.length > 0" class="vx-drawer__title">{{ title }}</text>
						</view>
						<view v-if="$slots['extra'] != null" class="vx-drawer__extra">
							<slot name="extra"></slot>
						</view>
						<!-- 关闭叉是独立出口：热区 44，图标 18，和遮罩走同一个 close。 -->
						<view v-if="closable" class="vx-drawer__close" hover-class="vx-drawer__close--pressed"
							:hover-stay-time="VX_PRESSED_STAY_TIME" @click.stop="onCloseTap">
							<vx-icon name="close" color="var(--vx-color-text-secondary)" />
						</view>
					</view>
					<view class="vx-drawer__rule"></view>
				</view>

				<!-- 不监听 touchmove：这一层接住监听后，App 上的 scroll-view 不再滚动。 -->
				<scroll-view class="vx-drawer__body" direction="vertical" :scroll-top="bodyScrollTop">
					<view :class="contentClass">
						<slot></slot>
					</view>
				</scroll-view>

				<!-- 底栏固定，正文滚动时不跟着走；放 1–2 个动作，不做主导航。 -->
				<view v-if="$slots['suffix'] != null" class="vx-drawer__foot" @touchmove.stop.prevent>
					<view class="vx-drawer__rule"></view>
					<view class="vx-drawer__footer">
						<slot name="suffix"></slot>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import { VxDrawerPosition, VxDrawerProps } from './props'
	import { VX_POPUP_MASK_GUARD, VX_PRESSED_STAY_TIME } from '../../libs/motion'
	import { VX_OVERLAY_DURATION, VX_OVERLAY_DURATION_NONE, VX_OVERLAY_FRAME, VX_OVERLAY_LAYER, vxLockPageScroll, vxUnlockPageScroll } from '../../libs/overlay'

	const props = withDefaults(defineProps<VxDrawerProps>(), {
		position: 'right',
		width: '',
		height: '',
		title: '',
		closable: false,
		bodyPadded: true,
		maskClosable: true,
		maskColor: '',
		bgColor: '',
		zIndex: VX_OVERLAY_LAYER
	})

	// 关闭都写回 false，业务用 v-model:show 时状态能跟着变。
	const show = defineModel('show', {
		type: Boolean,
		default: false
	})

	const emit = defineEmits<{
		close: []
	}>()

	// 挂载和隐藏分开：rendered 控制根节点在不在（首开后常驻），hidden 控制整层是不是 display: none。
	// 首次渲染就显示时直接挂上；之后 rendered 只从 false 变 true，不再回头。
	const rendered = ref(show.value === true)
	const hidden = ref(show.value !== true)
	// 落位态：false 时面板停在起手 transform、遮罩全透明；挂上一帧后置 true 触发过渡。
	// 与 vx-popup 同款两帧式进出场（2026-11-14 起 App 端也有动画，此前关键帧只在 Web）。
	const inState = ref(show.value === true)

	let settleTimer = 0
	let leaveTimer = 0

	// 进出场时长：与 vx-popup 同源。5.36 alpha 的 uts2js 类型缓存不会因 props.ts 新增
	// 字段而失效（duration prop 编译不进去，实测 props.duration 恒为 undefined），
	// 所以这里直接读共享常量，先不暴露 duration prop。
	const animateDuration = computed((): number => VX_OVERLAY_DURATION)

	// 传进来不认识的方向落回 right，class 拼出来才是合法的。
	const placement = computed((): VxDrawerPosition => {
		const value = props.position
		if (value === 'left' || value === 'top' || value === 'bottom') return value
		return 'right'
	})

	// class 顺序：基础 → 方向 → 隐藏。样式表顺序与此一致。
	const rootClass = computed((): string => {
		let name = `vx-drawer vx-drawer--${placement.value}`
		if (hidden.value) name += ' vx-drawer--hidden'
		return name
	})

	const sheetClass = computed((): string => {
		let name = `vx-drawer__sheet vx-drawer__sheet--${placement.value}`
		if (animateDuration.value > 0) name += ' vx-drawer__sheet--animated'
		if (inState.value) {
			const axis = placement.value === 'left' || placement.value === 'right' ? 'x' : 'y'
			name += ` vx-drawer__sheet--in-${axis}`
		}
		return name
	})

	const panelClass = computed((): string => {
		return `vx-drawer__panel vx-drawer__panel--${placement.value}`
	})

	// 有关闭叉时右侧留 8，44 的热区右缘离面板 8；没有时回到正常内边距。
	const headerClass = computed((): string => {
		if (props.closable) return 'vx-drawer__header'
		return 'vx-drawer__header vx-drawer__header--plain'
	})

	const contentClass = computed((): string => {
		if (props.bodyPadded) return 'vx-drawer__content'
		return 'vx-drawer__content vx-drawer__content--flush'
	})

	// 不可关闭的遮罩不是按钮，Web 上不给指针。
	const maskClass = computed((): string => {
		let name = props.maskClosable ? 'vx-drawer__mask vx-drawer__mask--closable' : 'vx-drawer__mask'
		if (animateDuration.value > 0) name += ' vx-drawer__mask--animated'
		if (inState.value) name += ' vx-drawer__mask--in'
		return name
	})

	const rootStyle = computed((): string => {
		return `z-index: ${props.zIndex};`
	})

	// 只覆盖当前方向那一条边；另一条边的默认尺寸在样式表里。
	// 时长写行内：duration 是数值，过渡类只给属性和曲线，两处不重复。
	const sheetStyle = computed((): string => {
		let style = ''
		if ((placement.value === 'left' || placement.value === 'right') && props.width.length > 0) {
			style += `width: ${props.width};`
		}
		if ((placement.value === 'top' || placement.value === 'bottom') && props.height.length > 0) {
			style += `height: ${props.height};`
		}
		if (animateDuration.value > 0) style += ` transition-duration: ${animateDuration.value}ms;`
		return style
	})

	const panelStyle = computed((): string => {
		if (props.bgColor.length === 0) return ''
		return `background-color: ${props.bgColor};`
	})

	const maskStyle = computed((): string => {
		let style = ''
		if (props.maskColor.length > 0) style += `background-color: ${props.maskColor};`
		if (animateDuration.value > 0) style += ` transition-duration: ${animateDuration.value}ms;`
		return style
	})

	const hide = () => {
		if (!show.value) return
		show.value = false
	}

	// 点遮罩和点关闭叉走同一个出口：先收起再抛 close，父级在事件里改 show 也不会被覆盖。
	// 打开那一下抬起的触摸也会落到遮罩上，保护窗内直接丢掉，否则浮层会一闪就关。
	const onMaskTap = () => {
		if (!props.maskClosable || !show.value) return
		if (Date.now() - openedAt < VX_POPUP_MASK_GUARD) return
		hide()
		emit('close')
	}

	// 最近一次打开的时刻，遮罩保护窗用它判断这一下是不是「打开那一下的抬手」。
	let openedAt = 0

	// 根节点首开后常驻，正文 scroll-view 不会随打开重建：关闭时停在哪，下次打开还在那。
	const bodyScrollTop = ref(0)

	// 同 vx-select：scroll-top 写和当前值相同（或只差不到 1）时原生滚动区不动。
	// 先错开 0.01，下一帧再写回 0；只在打开时调，关闭时保留业务自己的位置。
	const resetBodyScrollTop = () => {
		if (Math.abs(bodyScrollTop.value) < 1) {
			bodyScrollTop.value = 0.01
			nextTick(() => {
				bodyScrollTop.value = 0
			})
			return
		}
		bodyScrollTop.value = 0
	}

	// 打开期间只记一次。叠了两个弹层时由底座计数，最后一个收起才解锁。
	let pageLocked = false

	const setPageLock = (locked: boolean) => {
		if (pageLocked === locked) return
		pageLocked = locked
		if (locked) vxLockPageScroll()
		else vxUnlockPageScroll()
	}

	// 打开：首次挂上根节点，之后只去掉隐藏 class；正文的原生 scroll-view 只创建一次。
	// duration>0 时先挂起手 class、等一帧再落位，过渡才有起点（与 vx-popup 同款）。
	const enter = () => {
		openedAt = Date.now()
		clearSettle()
		clearLeave()
		const justMounted = !rendered.value
		const wasHidden = hidden.value
		rendered.value = true
		hidden.value = false
		if (animateDuration.value === VX_OVERLAY_DURATION_NONE) {
			inState.value = true
		} else if (justMounted || wasHidden) {
			settleTimer = setTimeout(() => {
				settleTimer = 0
				inState.value = true
			}, VX_OVERLAY_FRAME)
		} else {
			inState.value = true
		}
		resetBodyScrollTop()
		setPageLock(true)
	}

	// 关闭：先退到起手位，duration 加一帧后只加隐藏 class；根节点和正文的原生子树都保留。
	// duration=0、还没落位就关，都直接隐藏；滚动锁跟着解开。
	const leave = () => {
		clearSettle()
		clearLeave()
		if (!rendered.value) return
		if (!inState.value) {
			hidden.value = true
			setPageLock(false)
			return
		}
		inState.value = false
		if (animateDuration.value === VX_OVERLAY_DURATION_NONE) {
			hidden.value = true
			setPageLock(false)
			return
		}
		leaveTimer = setTimeout(() => {
			leaveTimer = 0
			hidden.value = true
			setPageLock(false)
		}, animateDuration.value + VX_OVERLAY_FRAME)
	}

	const clearSettle = () => {
		if (settleTimer === 0) return
		clearTimeout(settleTimer)
		settleTimer = 0
	}

	const clearLeave = () => {
		if (leaveTimer === 0) return
		clearTimeout(leaveTimer)
		leaveTimer = 0
	}

	watch(show, (visible: boolean) => {
		if (visible) enter()
		else leave()
	})

	// 挂载时已经打开的，watch 不会走，保护窗和滚动锁从这一帧算起。
	if (show.value) {
		openedAt = Date.now()
		setPageLock(true)
	}

	onUnmounted(() => {
		clearSettle()
		clearLeave()
		setPageLock(false)
	})

	const onCloseTap = () => {
		if (!props.closable || !show.value) return
		hide()
		emit('close')
	}

	const open = () => {
		show.value = true
	}

	// 程序关闭只收起，不抛 close；close 只代表用户关闭。
	const close = () => {
		hide()
	}

	// 给页面 onBackPress 用：收起并抛 close，和点遮罩、关闭叉同一条路。close() 只收起。
	const cancel = () => {
		if (!show.value) return
		hide()
		emit('close')
	}

	defineExpose({
		open,
		close,
		cancel
	})
</script>

<style>
	/* App 不能把自定义变量定义成另一个 var()。
	   同一元素上，class 字符串里靠后的声明盖过靠前的；样式表顺序与此一致。 */

	/* 定位层铺满页面，主轴上端贴边或下端贴边。层级写在行内，默认 1000。
	   宽高再写一遍：只靠四边定位时，子项百分比高度在 App 上会落成 auto。
	   App 默认 overflow 是 hidden，面板阴影画出这层会被裁掉，需要 visible。
	   Android 拍平后 visible 不生效，这一层不要加 flatten。 */
	.vx-drawer {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* 左右抽屉横排贴边，上下抽屉纵排贴边。交叉轴的 100% 写在 sheet 上。 */
	.vx-drawer--left {
		flex-direction: row;
		justify-content: flex-start;
	}

	.vx-drawer--right {
		flex-direction: row;
		justify-content: flex-end;
	}

	.vx-drawer--top {
		flex-direction: column;
		justify-content: flex-start;
	}

	.vx-drawer--bottom {
		flex-direction: column;
		justify-content: flex-end;
	}

	/* 首开后根节点常驻。关闭只加这个 class：display: none 只停绘制，正文的原生 scroll-view 不销毁；
	   下次打开去掉它再入场。class 字符串排在最后，这条规则也排在方向类之后。 */
	.vx-drawer--hidden {
		display: none;
	}

	/* 遮罩垫在面板下面，只压页面，不压面板。 */
	.vx-drawer__mask {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 0;
		background-color: var(--vx-color-mask);
	}

	/* 外层只负责尺寸和内侧圆角；内层裁底色。
	   交叉轴写 100%，正文的 scroll-view 才有确定高度。
	   overflow 是 visible，最小尺寸默认跟内容走；压成 0，长文才不会把面板撑出屏幕。
	   主轴保留压缩：App 的 max-width 不支持百分比，宽或高大于屏幕时靠压缩收到这一层里。
	   和操作菜单不同，这里不能写 flex-shrink: 0，否则传入的 120% 不会缩回屏幕。
	   Android 拍平后 visible 不生效，这一层不要加 flatten。 */
	.vx-drawer__sheet {
		position: relative;
		z-index: 1;
		flex-direction: column;
		flex-shrink: 1;
		align-self: stretch;
		box-sizing: border-box;
		min-width: 0;
		min-height: 0;
		overflow: visible;
	}

	/* 贴住屏幕的一侧不圆角，朝向页面的两角用 lg；宽度和高度分别取令牌。 */
	.vx-drawer__sheet--left {
		width: var(--vx-drawer-width);
		height: 100%;
		border-top-right-radius: var(--vx-radius-lg);
		border-bottom-right-radius: var(--vx-radius-lg);
	}

	.vx-drawer__sheet--right {
		width: var(--vx-drawer-width);
		height: 100%;
		border-top-left-radius: var(--vx-radius-lg);
		border-bottom-left-radius: var(--vx-radius-lg);
	}

	.vx-drawer__sheet--top {
		width: 100%;
		height: var(--vx-drawer-height);
		border-bottom-left-radius: var(--vx-radius-lg);
		border-bottom-right-radius: var(--vx-radius-lg);
	}

	.vx-drawer__sheet--bottom {
		width: 100%;
		height: var(--vx-drawer-height);
		border-top-left-radius: var(--vx-radius-lg);
		border-top-right-radius: var(--vx-radius-lg);
	}

	/* 内层填满外层，四角和阴影层一致，轮廓才重合；底色和安全区都在这一层。
	   最小高度写 0：App 不按 overflow 把最小高度收成 0，正文超高会把这一层撑开。 */
	.vx-drawer__panel {
		flex-direction: column;
		flex: 1;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		background-color: var(--vx-color-surface);
		overflow: hidden;
	}

	.vx-drawer__panel--left {
		padding-top: var(--uni-safe-area-inset-top, 0px);
		padding-left: var(--uni-safe-area-inset-left, 0px);
		padding-bottom: var(--uni-safe-area-inset-bottom, 0px);
		border-top-right-radius: var(--vx-radius-lg);
		border-bottom-right-radius: var(--vx-radius-lg);
	}

	.vx-drawer__panel--right {
		padding-top: var(--uni-safe-area-inset-top, 0px);
		padding-right: var(--uni-safe-area-inset-right, 0px);
		padding-bottom: var(--uni-safe-area-inset-bottom, 0px);
		border-top-left-radius: var(--vx-radius-lg);
		border-bottom-left-radius: var(--vx-radius-lg);
	}

	.vx-drawer__panel--top {
		padding-top: var(--uni-safe-area-inset-top, 0px);
		padding-left: var(--uni-safe-area-inset-left, 0px);
		padding-right: var(--uni-safe-area-inset-right, 0px);
		border-bottom-left-radius: var(--vx-radius-lg);
		border-bottom-right-radius: var(--vx-radius-lg);
	}

	.vx-drawer__panel--bottom {
		padding-bottom: var(--uni-safe-area-inset-bottom, 0px);
		padding-left: var(--uni-safe-area-inset-left, 0px);
		padding-right: var(--uni-safe-area-inset-right, 0px);
		border-top-left-radius: var(--vx-radius-lg);
		border-top-right-radius: var(--vx-radius-lg);
	}

	/* 头部和底栏整块不收缩，分割线跟着自己那一行；正文滚动不带动它们。 */
	.vx-drawer__head,
	.vx-drawer__foot {
		flex-direction: column;
		flex-shrink: 0;
		width: 100%;
	}

	/* 头部用 --vx-overlay-head 52：标题单行省略，右侧留 8 给 44 的关闭叉。 */
	.vx-drawer__header {
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		box-sizing: border-box;
		width: 100%;
		min-height: var(--vx-overlay-head);
		padding-left: var(--vx-space-lg);
		padding-right: var(--vx-space-sm);
	}

	.vx-drawer__header--plain {
		padding-right: var(--vx-space-lg);
	}

	/* 标题占满中间，右侧的 extra 和关闭叉都压到行尾；没有标题时这层只负责把右侧推过去。
	   Web 默认 overflow 是 visible，长标题裁在这一层，不盖住右侧。 */
	.vx-drawer__heading {
		flex: 1;
		flex-direction: row;
		align-items: center;
		min-width: 0;
		overflow: hidden;
	}

	.vx-drawer__prefix {
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		margin-right: var(--vx-space-sm);
	}

	/* 占满 prefix 剩下的宽度后再省略。不能写 width: 100%，否则会盖住前面的 prefix。
	   App 默认 keep、Web 默认 pre-line，标题固定单行；换行交给正文。 */
	.vx-drawer__title {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		color: var(--vx-color-text);
		font-size: var(--vx-font-lg);
		line-height: var(--vx-line-lg);
		font-weight: var(--vx-weight-semibold);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.vx-drawer__extra {
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		margin-left: var(--vx-space-sm);
	}

	/* 关闭叉用热区令牌，不跟列表行；图标 18 居中。 */
	.vx-drawer__close {
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: var(--vx-hit-size);
		height: var(--vx-hit-size);
	}

	.vx-drawer__close--pressed {
		opacity: var(--vx-opacity-pressed);
	}

	/* 头部和底栏各用一条 1px divider；线在文档流里，占 1px。 */
	.vx-drawer__rule {
		flex-shrink: 0;
		width: 100%;
		height: var(--vx-border-width);
		background-color: var(--vx-color-divider);
	}

	/* 正文是唯一的滚动区：剩余高度都给 body，头部和底栏保持不动。
	   height: 0 先把 flex 基准压成 0，App 的 scroll-view 才会按分配到的空间滚。 */
	.vx-drawer__body {
		flex: 1;
		width: 100%;
		height: 0;
		min-height: 0;
	}

	/* 默认四边 16；列表、图片要贴边时传 bodyPadded=false，内容自己补左右留白。 */
	.vx-drawer__content {
		flex-direction: column;
		box-sizing: border-box;
		width: 100%;
		padding: var(--vx-space-lg);
	}

	.vx-drawer__content--flush {
		padding: 0;
	}

	/* 底栏固定在面板底部，上 12、左右 16；动作由业务排，组件只给一条边界。 */
	.vx-drawer__footer {
		flex-direction: column;
		flex-shrink: 0;
		box-sizing: border-box;
		width: 100%;
		padding: var(--vx-space-md) var(--vx-space-lg);
	}

	/* 5.31 前 App 端没有 CSS 关键帧，所以进出场统一用 vx-popup 同款 transition 两帧式，
	   全平台一条路径：面板常驻起手位（贴边那侧 100% 平移）、遮罩全透明；
	   inState 挂上 --in-* 后按行内时长过渡到落位，关闭反向播放后再隐藏。
	   duration=0 时不挂过渡类，enter 同帧置 inState，起手位不落屏。 */
	.vx-drawer__mask {
		opacity: 0;
	}

	.vx-drawer__mask--animated {
		transition-property: opacity;
		transition-timing-function: var(--vx-ease-standard);
	}

	.vx-drawer__mask--in {
		opacity: 1;
	}

	.vx-drawer__sheet--animated {
		transition-property: transform;
		transition-timing-function: var(--vx-ease-standard);
	}

	.vx-drawer__sheet--left {
		transform: translateX(-100%);
	}

	.vx-drawer__sheet--right {
		transform: translateX(100%);
	}

	.vx-drawer__sheet--top {
		transform: translateY(-100%);
	}

	.vx-drawer__sheet--bottom {
		transform: translateY(100%);
	}

	/* 落位规则排在方向之后，后写的才盖得住；起点和终点的变换函数一致，才按同一条轴补间。 */
	.vx-drawer__sheet--in-x {
		transform: translateX(0);
	}

	.vx-drawer__sheet--in-y {
		transform: translateY(0);
	}

	/* #ifdef WEB */
	/* 根节点首开后常驻；定位层关掉浏览器默认手势，页面在抽屉打开期间不跟着滚，
	   正文改回纵向滑动、滚到底不把页面一起带走。 */
	.vx-drawer {
		touch-action: none;
	}

	.vx-drawer__mask--closable {
		cursor: pointer;
	}

	.vx-drawer__close {
		cursor: pointer;
	}

	.vx-drawer__body {
		overscroll-behavior: contain;
		touch-action: pan-y;
	}
	/* #endif */
</style>
