<template>
	<!-- 操作菜单是底部弹层：遮罩铺满页面，面板贴底。挂在页面根节点，放进 scroll-view 会被裁掉。 -->
	<!-- 点遮罩、点取消都收起并抛 cancel；点动作默认收起并抛 select，由业务决定后续跳转。 -->
	<!-- 触摸只拦遮罩、头部和取消栏：动作行不监听，根节点接住后 App 上的 scroll-view 不再滚动。 -->
	<view v-if="visible" class="vx-actionsheet" :style="rootStyle">
		<view :class="maskClass" :style="maskStyle" @click="onMaskTap" @touchmove.stop.prevent></view>

		<!-- 外层只负责阴影和滑入；内层裁按下态，避免 overflow 把阴影一起裁掉。 -->
		<view class="vx-actionsheet__sheet" :style="sheetStyle" @click.stop>
			<view class="vx-actionsheet__panel">
				<!-- 头部两块都可选：title 用标题档，description 用次要色；都没有时不渲染。 -->
				<view v-if="hasHeader" class="vx-actionsheet__header" @touchmove.stop.prevent>
					<text v-if="title.length > 0" class="vx-actionsheet__title" :style="titleStyle">{{ title }}</text>
					<text v-if="description.length > 0" :class="descClass" :style="descriptionStyle">{{ description }}</text>
				</view>
				<view v-if="hasHeader" class="vx-actionsheet__header-divider"></view>

				<!-- 多出来的动作在这一层裁掉。行自己不收缩，52 的行高不会被挤矮。 -->
				<view class="vx-actionsheet__list">
					<view v-for="row in rows" :key="row.index" :class="row.itemClass" :hover-class="row.hoverClass"
						:hover-stay-time="VX_PRESSED_STAY_TIME" @click.stop="onSelect(row.index)">
						<text :class="row.textClass">{{ row.text }}</text>
						<!-- 选中态用勾和主色一起标出，不只靠颜色。勾不占文案宽度，切换时这一行不横跳。 -->
						<view v-if="row.selected" class="vx-actionsheet__check">
							<vx-icon name="check" size="sm" :color="row.checkColor" />
						</view>
						<view v-if="row.hasDivider" class="vx-actionsheet__divider"></view>
					</view>
				</view>

				<!-- 取消和动作之间留 4px default-soft 间隔带，取消像一块独立的白色按钮；安全区由面板底部内边距兜住。 -->
				<view v-if="showCancel" class="vx-actionsheet__cancel-wrap" @touchmove.stop.prevent>
					<view class="vx-actionsheet__gap"></view>
					<view class="vx-actionsheet__cancel" hover-class="vx-actionsheet__cancel--pressed"
						:hover-stay-time="VX_PRESSED_STAY_TIME" @click.stop="onCancelTap">
						<text class="vx-actionsheet__cancel-text">{{ cancelText }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import { VxActionSheetItem, VxActionSheetItemType, VxActionSheetProps } from './props'
	import { VX_POPUP_MASK_GUARD, VX_PRESSED_STAY_TIME } from '../../libs/motion'
	import { VX_OVERLAY_LAYER, vxLockPageScroll, vxUnlockPageScroll } from '../../libs/overlay'

	const props = withDefaults(defineProps<VxActionSheetProps>(), {
		items: (): Array<VxActionSheetItem> => [],
		title: '',
		description: '',
		showCancel: true,
		cancelText: '取消',
		maskClosable: true,
		closeOnSelect: true,
		maskColor: '',
		titleColor: '',
		descriptionColor: '',
		zIndex: VX_OVERLAY_LAYER
	})

	// 关闭都写回 false，业务用 v-model:show 时状态能跟着变。
	const show = defineModel('show', {
		type: Boolean,
		default: false
	})

	const emit = defineEmits<{
		select: [index: number, item: VxActionSheetItem]
		cancel: []
	}>()

	// 显式传 null / undefined 时按空数组处理，模板和 computed 里不直接读 .length。
	const itemsValue = computed((): Array<VxActionSheetItem> => props.items ?? [])

	// 没有动作时不铺遮罩，避免出现一张只有取消按钮的空面板。
	const visible = computed((): boolean => {
		return show.value && itemsValue.value.length > 0
	})

	const hasHeader = computed((): boolean => {
		return props.title.length > 0 || props.description.length > 0
	})

	// 只有跟标题同时出现时才补 4px，单独一行说明不加上边距。
	const descClass = computed((): string => {
		let name = 'vx-actionsheet__desc'
		if (props.title.length > 0) name += ' vx-actionsheet__desc--offset'
		return name
	})

	const titleStyle = computed((): string => {
		if (props.titleColor.length === 0) return ''
		return `color: ${props.titleColor};`
	})

	const descriptionStyle = computed((): string => {
		if (props.descriptionColor.length === 0) return ''
		return `color: ${props.descriptionColor};`
	})

	const maskStyle = computed((): string => {
		if (props.maskColor.length === 0) return ''
		return `background-color: ${props.maskColor};`
	})

	// 不可关闭的遮罩不是按钮，Web 上不给指针。
	const maskClass = computed((): string => {
		return props.maskClosable ? 'vx-actionsheet__mask vx-actionsheet__mask--closable' : 'vx-actionsheet__mask'
	})

	const rootStyle = computed((): string => {
		return `z-index: ${props.zIndex};`
	})

	// 上限写在 sheet 上：App 上 max-height 的百分比按父级内容高度解析，
	// 父级是 fixed 的整层 flex，解析不出来等于没限，所以按层高算成像素。
	// 只减顶部 24，留一点能看出遮罩还在；根节点已经让开原生导航栏，安全区不再减第二次。
	const VX_ACTIONSHEET_TOP_EDGE = 24

	// 打开那一下可能还没排版，量到 0 就隔一帧再量；补试完仍拿不到才退回窗口高。
	const VX_ACTIONSHEET_MEASURE_RETRY = 3
	const VX_ACTIONSHEET_MEASURE_DELAY = 50

	const instance = getCurrentInstance()

	const windowHeight = ref(0)

	// 从根节点量到的层高。windowHeight 比这一层实际占的高度多一截（App 上约 32），
	// 按它算上限，差额才不会落进留白或被挤出屏幕。量不到记 0。
	const layerHeight = ref(0)

	let measureTimer = 0
	let measureCount = 0
	let measureId = 0

	// 拿不到或不是正数就记 0：上限算成负数，sheetStyle 不写 max-height，面板按内容走。
	const readWindowHeight = () => {
		if (typeof uni === 'undefined' || typeof uni.getWindowInfo !== 'function') {
			windowHeight.value = 0
			return
		}
		const info = uni.getWindowInfo()
		if (info == null) {
			windowHeight.value = 0
			return
		}
		windowHeight.value = info.windowHeight > 0 ? info.windowHeight : 0
	}

	readWindowHeight()

	const clearMeasureTimer = () => {
		if (measureTimer === 0) return
		clearTimeout(measureTimer)
		measureTimer = 0
	}

	// 本组件作用域里量根节点。fixed 整层的高度就是这个浮层能占的全部空间，
	// 比 windowHeight 准；关着时没有节点，直接记 0。
	const measureLayer = () => {
		if (!visible.value) {
			layerHeight.value = 0
			return
		}
		if (typeof uni === 'undefined' || typeof uni.createSelectorQuery !== 'function') {
			layerHeight.value = 0
			return
		}
		const proxy = instance != null ? instance.proxy : null
		if (proxy == null) {
			layerHeight.value = 0
			return
		}
		const id = ++measureId
		uni.createSelectorQuery()
			.in(proxy)
			.select('.vx-actionsheet')
			.boundingClientRect()
			.exec((result) => {
				if (id !== measureId) return
				const rect = result != null && result.length > 0 ? result[0] as NodeInfo | null : null
				const height = rect != null ? rect.height : 0
				if (height != null && height > 0) {
					layerHeight.value = height
					measureCount = 0
					return
				}
				if (measureCount < VX_ACTIONSHEET_MEASURE_RETRY) {
					measureCount++
					clearMeasureTimer()
					measureTimer = setTimeout(() => {
						measureTimer = 0
						measureLayer()
					}, VX_ACTIONSHEET_MEASURE_DELAY)
					return
				}
				// 量不到才退回窗口高；两个都拿不到时 sheetStyle 不写上限。
				measureCount = 0
				layerHeight.value = 0
			})
	}

	// 优先用实测层高，量不到退回窗口高；两个都不是正数就不写上限。
	const sheetStyle = computed((): string => {
		const base = layerHeight.value > 0 ? layerHeight.value : windowHeight.value
		const limit = base - VX_ACTIONSHEET_TOP_EDGE
		if (limit <= 0) return ''
		return `max-height: ${limit}px;`
	})

	// 键盘收起、旋转和 Web 拖窗口都会走到这里，层高跟着变，两条一起重读。
	const onWindowResize = () => {
		readWindowHeight()
		measureLayer()
	}

	// 勾不继承文字色，选择器写不到 vx-icon 内部的 text。只在选中时调用。
	// danger 保留危险色；其余选中跟 primary 一样取 pressed 档。
	const checkColor = (type: VxActionSheetItemType, disabled: boolean): string => {
		if (disabled) return 'var(--vx-color-disabled-text)'
		if (type === 'danger') return 'var(--vx-color-danger-pressed)'
		return 'var(--vx-color-primary-pressed)'
	}

	type ActionSheetRow = {
		index: number
		text: string
		itemClass: string
		hoverClass: string
		textClass: string
		selected: boolean
		checkColor: string
		hasDivider: boolean
	}

	// class 顺序：基础 → 类型 → 状态。disabled 写在最后，盖过类型色。
	// 文案色放在 class 里，不给每一行拼 style。
	const rows = computed((): Array<ActionSheetRow> => {
		const list: Array<ActionSheetRow> = []
		const source = itemsValue.value
		const last = source.length - 1
		for (let index = 0; index < source.length; index++) {
			const entry = source[index]
			const text = entry.text != null ? entry.text : ''
			const type: VxActionSheetItemType = entry.type != null ? entry.type : 'default'
			const disabled = entry.disabled === true
			const selected = entry.selected === true

			let itemClass = 'vx-actionsheet__item'
			if (disabled) itemClass += ' vx-actionsheet__item--disabled'

			// uni-app 里空字符串关不掉按下态，要写 none。
			const hoverClass = disabled ? 'none' : 'vx-actionsheet__item--pressed'

			let textClass = 'vx-actionsheet__text'
			if (type === 'primary') textClass += ' vx-actionsheet__text--primary'
			else if (type === 'danger') textClass += ' vx-actionsheet__text--danger'
			else if (selected) textClass += ' vx-actionsheet__text--selected'
			if (disabled) textClass += ' vx-actionsheet__text--disabled'

			list.push({
				index: index,
				text: text,
				itemClass: itemClass,
				hoverClass: hoverClass,
				textClass: textClass,
				selected: selected,
				checkColor: selected ? checkColor(type, disabled) : '',
				hasDivider: index < last
			})
		}
		return list
	})

	// 点击停在动作上，禁用项不抛事件；默认先收起再抛，父级在事件里改 show 也不会被覆盖。
	const onSelect = (index: number) => {
		const item = itemsValue.value[index]
		if (item == null || item.disabled === true) return
		if (props.closeOnSelect) show.value = false
		emit('select', index, item)
	}

	const onCancelTap = () => {
		if (!show.value) return
		show.value = false
		emit('cancel')
	}

	// 遮罩可关闭时按取消处理，和点取消按钮走同一条出口。
	// 打开那一下抬起的触摸也会落到遮罩上，保护窗内直接丢掉，否则浮层会一闪就关。
	const onMaskTap = () => {
		if (!props.maskClosable) return
		if (Date.now() - openedAt < VX_POPUP_MASK_GUARD) return
		onCancelTap()
	}

	// 最近一次打开的时刻，遮罩保护窗用它判断这一下是不是「打开那一下的抬手」。
	let openedAt = 0

	// 没有动作时遮罩不铺，锁跟着 visible 走；打开期间只记一次。
	let pageLocked = false

	// 同一实例只警告一次。规范是 2–6 条，超 8 条时多出来的动作会被裁掉。
	let itemsWarned = false

	const warnItemCount = () => {
		if (itemsWarned) return
		if (itemsValue.value.length <= 8) return
		itemsWarned = true
		console.warn(`[vx-actionsheet] 规范是 2–6 条，当前 ${itemsValue.value.length} 条；更多改用页面或选择器。`)
	}

	watch((): number => itemsValue.value.length, () => {
		warnItemCount()
	})

	warnItemCount()

	const setPageLock = (locked: boolean) => {
		if (pageLocked === locked) return
		pageLocked = locked
		if (locked) vxLockPageScroll()
		else vxUnlockPageScroll()
	}

	watch(show, (visible: boolean) => {
		if (visible) openedAt = Date.now()
	})

	watch(visible, (open: boolean) => {
		// 根节点随 visible 重建，但组件实例不重建：打开这一下重读窗口并量层高，
		// 关着时窗口可能已经变了，重读放在打开这一下。
		if (open) {
			readWindowHeight()
			nextTick(() => {
				if (visible.value) measureLayer()
			})
		} else {
			measureId++
			clearMeasureTimer()
			measureCount = 0
			layerHeight.value = 0
		}
		setPageLock(open)
	})

	// 挂载时已经打开的，watch 不会走，保护窗和滚动锁从这一帧算起。
	if (show.value) openedAt = Date.now()
	if (visible.value) setPageLock(true)

	onMounted(() => {
		// watch 不会走这一遍，层高从这里补量。
		if (visible.value) nextTick(measureLayer)
		// #ifdef WEB
		if (typeof window !== 'undefined') window.addEventListener('resize', onWindowResize)
		// #endif
		// #ifndef WEB
		if (typeof uni !== 'undefined' && typeof uni.onWindowResize === 'function') {
			uni.onWindowResize(onWindowResize)
		}
		// #endif
	})

	onUnmounted(() => {
		clearMeasureTimer()
		// #ifdef WEB
		if (typeof window !== 'undefined') window.removeEventListener('resize', onWindowResize)
		// #endif
		// #ifndef WEB
		if (typeof uni !== 'undefined' && typeof uni.offWindowResize === 'function') {
			uni.offWindowResize(onWindowResize)
		}
		// #endif
		setPageLock(false)
	})

	const open = () => {
		show.value = true
	}

	// 程序关闭只收起，不抛 cancel；cancel 只代表用户取消。
	const close = () => {
		if (!show.value) return
		show.value = false
	}

	// 系统返回键等页面级出口：按用户取消处理，和点遮罩、点取消走同一条链路。
	const cancel = () => {
		onCancelTap()
	}

	defineExpose({
		open,
		close,
		cancel
	})
</script>

<style>
	/* App 不能把自定义变量定义成另一个 var()。
	   同一元素上，class 字符串里靠后的声明盖过靠前的；样式表顺序与此一致。 */

	/* 定位层铺满页面，面板贴底居中。层级写在行内，默认 1000，低于消息提示 1010、弹框 1020、加载浮层 1050 和轻提示 1100。 */
	.vx-actionsheet {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		box-sizing: border-box;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
	}

	.vx-actionsheet__mask {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 0;
		background-color: var(--vx-color-mask);
	}

	/* 外层留顶部圆角。上限按实测层高算成像素写在行内，这里不再写百分比：
	   App 上百分比按父级内容高度解析，等于没限。限高之后裁的是多出来的动作，行高仍然不缩。 */
	.vx-actionsheet__sheet {
		position: relative;
		z-index: 1;
		flex-direction: column;
		flex-shrink: 0;
		align-self: center;
		box-sizing: border-box;
		width: 100%;
		max-width: var(--vx-actionsheet-max-width);
		border-top-left-radius: var(--vx-radius-lg);
		border-top-right-radius: var(--vx-radius-lg);
		overflow: visible;
	}

	/* 内层裁按下态的四角，底色和安全区都在这一层。圆角和外层一致，轮廓才重合。
	   左右和底部安全区作为内边距，内容不压住刘海和手势条。
	   App 不会把 sheet 的 max-height 自动分给这个子项：不写 flex-shrink 时它仍按内容高撑出去，
	   取消栏被挤到屏幕下方。shrink 和 min-height 一起写，高度才传得进动作区。 */
	.vx-actionsheet__panel {
		flex-direction: column;
		flex-shrink: 1;
		min-height: 0;
		box-sizing: border-box;
		width: 100%;
		padding-left: var(--uni-safe-area-inset-left, 0px);
		padding-right: var(--uni-safe-area-inset-right, 0px);
		padding-bottom: var(--uni-safe-area-inset-bottom, 0px);
		border-top-left-radius: var(--vx-radius-lg);
		border-top-right-radius: var(--vx-radius-lg);
		background-color: var(--vx-color-surface);
		overflow: hidden;
	}

	/* 标题和说明都居中，左右留 24；说明和标题之间由 --offset 补 4。
	   头部不收缩，上下 16 才不会被短屏挤掉。 */
	.vx-actionsheet__header {
		flex-direction: column;
		flex-shrink: 0;
		align-items: center;
		box-sizing: border-box;
		width: 100%;
		padding: var(--vx-space-lg) var(--vx-space-xl);
	}

	/* App 默认 keep、Web 默认 pre-line，写明 normal，长文案才会换行。
	   纵向 flex 里收缩发生在高度上，文字不压缩。 */
	.vx-actionsheet__title,
	.vx-actionsheet__desc {
		flex-shrink: 0;
		width: 100%;
		min-width: 0;
		white-space: normal;
		text-align: center;
	}

	.vx-actionsheet__title {
		color: var(--vx-color-text);
		font-size: var(--vx-font-lg);
		line-height: var(--vx-line-lg);
		font-weight: var(--vx-weight-semibold);
	}

	.vx-actionsheet__desc {
		color: var(--vx-color-text-secondary);
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-regular);
	}

	.vx-actionsheet__desc--offset {
		margin-top: var(--vx-space-xs);
	}

	/* 头部和第一条动作之间的分割线在文档流里，占 1px。 */
	.vx-actionsheet__header-divider {
		flex-shrink: 0;
		width: 100%;
		height: var(--vx-border-width);
		background-color: var(--vx-color-divider);
	}

	/* App 上不写 min-height 时，这一层仍按内容高参与布局，把取消栏挤出面板；
	    显式写 0 才让得开。限高之后裁的是多出来的动作，行自己仍不收缩，行高不缩。 */
	.vx-actionsheet__list {
		flex-direction: column;
		flex-shrink: 1;
		box-sizing: border-box;
		width: 100%;
		min-height: 0;
		overflow: hidden;
	}

	/* 动作行是按钮，不是列表行：文案居中，行高沿用列表 md 的 52。
	   不写背景色，按下态是这一层唯一的 background-color。
	   限高之后裁的是多出来的动作，这一行不收缩，行高仍然不缩。 */
	.vx-actionsheet__item {
		position: relative;
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 100%;
		min-height: var(--vx-list-height-md);
		padding: var(--vx-space-md) var(--vx-space-xl);
	}

	.vx-actionsheet__item--pressed {
		background-color: var(--vx-color-surface-pressed);
	}

	/* 文案占满内容区后居中。勾是绝对定位，不参与这一行的宽度，切换选中时文案不横跳。 */
	.vx-actionsheet__text {
		flex-shrink: 1;
		width: 100%;
		min-width: 0;
		white-space: normal;
		color: var(--vx-color-text);
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-medium);
		text-align: center;
	}

	/* 样式表顺序与 class 字符串一致：类型、选中、disabled。disabled 写在最后，盖过前面的颜色。
	   primary 和选中都取 pressed 档，浅底上对比度更稳；danger 被选中时不挂选中色。 */
	.vx-actionsheet__text--primary {
		color: var(--vx-color-primary-pressed);
	}

	.vx-actionsheet__text--danger {
		color: var(--vx-color-danger-pressed);
	}

	.vx-actionsheet__text--selected {
		color: var(--vx-color-primary-pressed);
	}

	.vx-actionsheet__text--disabled {
		color: var(--vx-color-disabled-text);
	}

	/* 勾贴在右侧内边距里。宽高写死 14，只写 right、width 为 auto 时会落回静态位置。
	   top 50% 再上移自身一半，行被长文案撑高时仍垂直居中。
	   8 + 14 = 22，小于左右 24 的内边距，换行文案不会压到勾。 */
	.vx-actionsheet__check {
		position: absolute;
		top: 50%;
		right: var(--vx-space-sm);
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: var(--vx-icon-sm);
		height: var(--vx-icon-sm);
		transform: translateY(-50%);
	}

	/* 动作之间的分割线通栏，压在行底，不占高度。 */
	.vx-actionsheet__divider {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: var(--vx-border-width);
		background-color: var(--vx-color-divider);
	}

	/* 取消和动作之间用一条 default-soft 间隔带分开，不再画 border；
	   间隔带跟面板底色差一档，取消才像一块独立的按钮。 */
	.vx-actionsheet__cancel-wrap {
		flex-direction: column;
		flex-shrink: 0;
		box-sizing: border-box;
		width: 100%;
	}

	.vx-actionsheet__gap {
		flex-shrink: 0;
		width: 100%;
		height: var(--vx-space-xs);
		background-color: var(--vx-color-default-soft);
	}

	/* 取消按钮和动作同高、同字重，用间隔带和上面的动作分层。这一层不收缩，短屏上仍保持 52。 */
	.vx-actionsheet__cancel {
		flex-direction: row;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 100%;
		min-height: var(--vx-list-height-md);
		padding: var(--vx-space-md) var(--vx-space-xl);
		background-color: var(--vx-color-surface);
	}

	.vx-actionsheet__cancel--pressed {
		background-color: var(--vx-color-surface-pressed);
	}

	.vx-actionsheet__cancel-text {
		flex-shrink: 1;
		width: 100%;
		min-width: 0;
		white-space: normal;
		color: var(--vx-color-text);
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-medium);
		text-align: center;
	}

	/* 滑入和淡入：5.31 起 App 端支持 @keyframes（vx-loading 的转圈同款语法），
	   根节点 v-if 每次打开重建子树，动画每次都从头重播。
	   5.26–5.30 的 App 端不支持关键帧，元素直接按正常样式出现，不会留在透明态。
	   这一层接住触摸，页面在菜单打开期间不跟着滚。 */
	.vx-actionsheet__mask {
		animation-name: vx-actionsheet-fade;
		animation-duration: var(--vx-duration-normal);
		animation-timing-function: var(--vx-ease-standard);
	}

	.vx-actionsheet__sheet {
		animation-name: vx-actionsheet-up;
		animation-duration: var(--vx-duration-normal);
		animation-timing-function: var(--vx-ease-standard);
	}

	@keyframes vx-actionsheet-fade {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@keyframes vx-actionsheet-up {
		from {
			transform: translateY(100%);
		}

		to {
			transform: translateY(0);
		}
	}

	/* #ifdef WEB */
	.vx-actionsheet {
		touch-action: none;
	}

	.vx-actionsheet__mask--closable {
		cursor: pointer;
	}

	.vx-actionsheet__item {
		cursor: pointer;
	}

	.vx-actionsheet__item--disabled {
		cursor: not-allowed;
	}

	.vx-actionsheet__cancel {
		cursor: pointer;
	}
	/* #endif */
</style>
