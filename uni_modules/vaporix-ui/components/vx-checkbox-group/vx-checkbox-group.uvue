<template>
	<!-- 分组只维护选中的 value 集合和整组外观；标记、文案和点击由 vx-checkbox 提供。 -->
	<view v-if="$slots['default'] != null" :class="rootClass">
		<slot></slot>
	</view>
</template>

<script setup>
	import { VxCheckboxGroupProps, VxCheckboxLayout, VxCheckboxPlacement, VxCheckboxVariant, VxCheckboxValues } from './props'
	import { VX_CHECKBOX_CONTEXT, VxCheckboxContext } from './context'
	import { VxSemantic, VxSize } from '../../libs/types/common'

	const props = withDefaults(defineProps<VxCheckboxGroupProps>(), {
		size: 'md',
		type: 'primary',
		variant: 'box',
		placement: 'start',
		layout: 'inline',
		divider: true,
		card: false,
		disabled: false,
		max: 0
	})

	// v-model 是选中项的 value 集合。没有绑定时 defineModel 自己保存局部值，组件仍能勾选。
	const modelValue = defineModel({
		type: Array,
		default: (): Array<string> => []
	})

	const emit = defineEmits<{
		change: [values: VxCheckboxValues]
		exceed: [max: number]
	}>()

	// 登记顺序默认当挂载顺序。全部都带 index 时才改按最大 index 认最后一项。
	type VxCheckboxEntry = {
		id: string
		index: number | null
	}

	// 名单原地改。每次换成新数组会让每一项的分割线都重算，挂载是 O(N²)。
	const entries = ref<Array<VxCheckboxEntry>>([])
	// 子项只读这一项。最后一项没换人时不赋值，其余行的分割线不跟着重算。
	const lastId = ref('')

	const includes = (list: Array<string>, value: string): boolean => {
		return list.indexOf(value) >= 0
	}

	// 写回新数组。原地 push 不会触发 v-model，父级仍拿着旧的选中集合。
	const append = (list: Array<string>, value: string): Array<string> => {
		const next = list.slice()
		next.push(value)
		return next
	}

	// 同值可能有多条，一次清掉，取消后不再显示为选中。
	const remove = (list: Array<string>, value: string): Array<string> => {
		const next: Array<string> = []
		for (let index = 0; index < list.length; index++) {
			if (list[index] !== value) next.push(list[index])
		}
		return next
	}

	// 有一项 index 是 null，后挂载的不能代表视觉上的最后一项，退回登记顺序。
	const refreshLastId = () => {
		const list = entries.value
		let next = ''
		if (list.length > 0) {
			let indexed = true
			let maxIndex = 0
			let maxId = ''
			for (let cursor = 0; cursor < list.length; cursor++) {
				const order = list[cursor].index
				if (order == null) {
					indexed = false
					break
				}
				if (cursor === 0 || order >= maxIndex) {
					maxIndex = order
					maxId = list[cursor].id
				}
			}
			next = indexed ? maxId : list[list.length - 1].id
		}
		if (lastId.value !== next) lastId.value = next
	}

	const register = (id: string, index: number | null) => {
		const list = entries.value
		for (let cursor = 0; cursor < list.length; cursor++) {
			if (list[cursor].id !== id) continue
			if (list[cursor].index === index) return
			list[cursor].index = index
			refreshLastId()
			return
		}
		list.push({ id: id, index: index })
		refreshLastId()
	}

	const unregister = (id: string) => {
		const list = entries.value
		let at = -1
		for (let cursor = 0; cursor < list.length; cursor++) {
			if (list[cursor].id === id) {
				at = cursor
				break
			}
		}
		if (at < 0) return
		list.splice(at, 1)
		refreshLastId()
	}

	const isLast = (id: string): boolean => {
		return lastId.value.length > 0 && lastId.value === id
	}

	// 0 或负数表示不限，小数向下取整；非法数字时不启用上限，不在渲染里抛错。
	const maxCount = (): number => {
		const limit = props.max
		if (limit <= 0) return 0
		return Math.floor(limit)
	}

	// 子项每次刷新都会问一次。先收成表，N 项、M 个选中值才不是每次都扫 N×M。
	const checkedMap = computed((): Record<string, true> => {
		const selected: Record<string, true> = {}
		const list = modelValue.value
		for (let index = 0; index < list.length; index++) {
			const value = list[index]
			if (value.length === 0) continue
			selected[value] = true
		}
		return selected
	})

	const isChecked = (value: string): boolean => {
		return value.length > 0 && checkedMap.value[value] === true
	}

	// 取消勾选永远放行；新增勾选先看上限。被拦下时只抛 exceed，不改模型，也不抛 change。
	const toggle = (value: string): boolean => {
		if (props.disabled) return false
		if (value.length === 0) return false
		const current = modelValue.value
		if (includes(current, value)) {
			const next = remove(current, value)
			modelValue.value = next
			emit('change', next)
			return true
		}
		const limit = maxCount()
		if (limit > 0 && current.length >= limit) {
			emit('exceed', limit)
			return false
		}
		const next = append(current, value)
		modelValue.value = next
		emit('change', next)
		return true
	}

	// 不认识的尺寸按 md，不认识的语义色按 default；几项共用一个收口函数，class 只拼 sm / lg。
	const sizeKey = (value: VxSize): VxSize => {
		if (value === 'sm' || value === 'lg') return value
		return 'md'
	}

	const typeKey = (value: VxSemantic): VxSemantic => {
		if (value === 'primary' || value === 'success' || value === 'info' || value === 'warning' || value === 'danger') {
			return value
		}
		return 'default'
	}

	const variantKey = (value: VxCheckboxVariant): VxCheckboxVariant => {
		return value === 'check' ? 'check' : 'box'
	}

	const placementKey = (value: VxCheckboxPlacement): VxCheckboxPlacement => {
		return value === 'end' ? 'end' : 'start'
	}

	const layoutKey = (value: VxCheckboxLayout): VxCheckboxLayout => {
		return value === 'list' ? 'list' : 'inline'
	}

	// 单项通过 inject 读这里的函数；函数在单项的 computed 里执行时，依赖由单项的 computed 收集。
	const context: VxCheckboxContext = {
		isChecked: isChecked,
		toggle: toggle,
		size: (): VxSize => sizeKey(props.size),
		type: (): VxSemantic => typeKey(props.type),
		variant: (): VxCheckboxVariant => variantKey(props.variant),
		placement: (): VxCheckboxPlacement => placementKey(props.placement),
		layout: (): VxCheckboxLayout => layoutKey(props.layout),
		divider: (): boolean => props.divider,
		disabled: (): boolean => props.disabled,
		register: register,
		unregister: unregister,
		isLast: isLast
	}

	provide(VX_CHECKBOX_CONTEXT, context)

	// 卡片只给列表用：整组一圈描边和圆角，行自己铺满；inline 仍由外层容器提供边界。
	const rootClass = computed((): string => {
		const layout = layoutKey(props.layout)
		let name = 'vx-checkbox-group'
		if (layout === 'list') name += ' vx-checkbox-group--list'
		if (props.card && layout === 'list') name += ' vx-checkbox-group--card'
		return name
	})
</script>

<style>
	/* App 不能把自定义变量定义成另一个 var()。
	   同一元素上，class 字符串里靠后的声明盖过靠前的；样式表顺序与此一致。 */

	/* inline 横排并自动换行，项之间靠右外边距分开；宽度跟随父级，不加外部间距。
	   flex-shrink 归零，放进纵向 flex 页面时不会被压扁。 */
	.vx-checkbox-group {
		flex-direction: row;
		flex-wrap: wrap;
		flex-shrink: 0;
		align-items: center;
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
	}

	.vx-checkbox-group--list {
		flex-direction: column;
		align-items: stretch;
	}

	/* 卡片列表：surface 底、1px 描边、md 圆角，并裁掉行按下态的四角。 */
	.vx-checkbox-group--card {
		overflow: hidden;
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-surface);
	}
</style>
