<template>
	<!-- 整行点击由组件抛出，不再往外冒。 -->
	<view :class="rootClass" @click.stop="onClick">
		<view v-if="showLabel" :class="labelClass" :style="labelStyle">
			<text v-if="required" :class="requiredClass">*</text>
			<text :class="labelTextClass">{{ label }}</text>
		</view>

		<!-- 搜索变体的前置图标由组件画，业务不用再传 prefix。 -->
		<view v-if="isSearch" class="vx-input__search-icon">
			<vx-icon name="search" :size="searchIconSize" :color="searchIconColor" />
		</view>

		<view v-if="$slots['prefix'] != null" class="vx-input__prefix">
			<slot name="prefix"></slot>
		</view>

		<view v-if="readonly" class="vx-input__display">
			<text :class="valueClass">{{ displayValue }}</text>
		</view>
		<input v-else v-model="modelValue" :class="controlClass" :type="type" :password="password"
			:placeholder="placeholder" :placeholder-class="placeholderClass" :disabled="disabled"
			:maxlength="maxlength" :confirm-type="resolvedConfirmType" @input="onInput" @change="onChange"
			@confirm="onConfirm" @focus="onFocus" @blur="onBlur" />

		<text v-if="showUnit" :class="unitClass">{{ unit }}</text>

		<view v-if="showClear" :class="clearClass" hover-class="vx-input__clear--pressed"
			:hover-stay-time="VX_PRESSED_STAY_TIME" @click.stop="onClear">
			<view :class="clearMarkClass">
				<vx-icon name="close" :size="iconSize" color="var(--vx-color-text-secondary)" />
			</view>
		</view>

		<!-- 取消只在搜索变体出现：有值或聚焦时占位，其余时候不渲染也不留白。 -->
		<!-- Web 上 mousedown 会先让 input 失焦，prevent 保住焦点，空值取消才接得到 click。 -->
		<view v-if="showSearchCancel" :class="searchCancelClass" :hover-class="searchCancelHoverClass"
			:hover-stay-time="VX_PRESSED_STAY_TIME" @mousedown.prevent="onSearchCancelDown"
			@touchstart="onSearchCancelDown" @touchmove="onSearchCancelMove" @touchcancel="onSearchCancelUp"
			@click.stop="onSearchCancel">
			<text :class="searchCancelTextClass">取消</text>
		</view>

		<view v-if="$slots['suffix'] != null" class="vx-input__suffix">
			<slot name="suffix"></slot>
		</view>

		<view v-if="arrow" class="vx-input__arrow">
			<vx-icon name="chevron-right" :size="iconSize" :color="arrowColor" />
		</view>
	</view>
</template>

<script setup>
	import { VxInputProps, VxInputConfirmType } from './props'
	import { VX_PRESSED_STAY_TIME } from '../../libs/motion'

	const props = withDefaults(defineProps<VxInputProps>(), {
		type: 'text',
		size: 'md',
		variant: 'outline',
		shape: 'rounded',
		placeholder: '',
		password: false,
		clearable: false,
		disabled: false,
		readonly: false,
		maxlength: -1,
		invalid: false,
		confirmType: '',
		label: '',
		labelWidth: '',
		required: false,
		align: 'left',
		unit: '',
		arrow: false
	})

	const modelValue = defineModel({
		type: String,
		default: ''
	})

	const emit = defineEmits<{
		input: [value: string]
		change: [value: string]
		confirm: [value: string]
		search: [value: string]
		cancel: []
		clear: []
		focus: []
		blur: []
		click: []
	}>()

	const focused = ref(false)
	// App 点按不会被 preventDefault 留住焦点。按下期间为真，取消按钮在失焦后仍挂着，click 才接得到。
	// #ifdef APP
	const cancelPressing = ref(false)
	// 按下时量一次取消热区；滑出这块区域就复位，不等 click / touchcancel。
	const instance = getCurrentInstance()
	let cancelRect: NodeInfo | null = null

	const measureCancelRect = () => {
		const proxy = instance != null ? instance.proxy : null
		if (proxy == null) return
		uni.createSelectorQuery()
			.in(proxy)
			.select('.vx-input__search-cancel')
			.boundingClientRect()
			.exec((result) => {
				if (result.length === 0) return
				cancelRect = result[0] as NodeInfo | null
			})
	}
	// #endif

	// search 是搜索语义：没有标题位，取消按钮跟焦点和值走。
	const isSearch = computed((): boolean => {
		return props.variant === 'search'
	})

	// 键盘右下角按键：显式传了就用传入值；没传时 search 落到搜索键，其余变体仍是完成键。
	// 用计算值而不是 prop，variant 从 search 切回 outline / line 时键面跟着回到 done。
	const resolvedConfirmType = computed((): VxInputConfirmType => {
		if (props.confirmType.length > 0) return props.confirmType
		return isSearch.value ? 'search' : 'done'
	})

	const showLabel = computed((): boolean => {
		return !isSearch.value && props.label.length > 0
	})

	const showUnit = computed((): boolean => {
		return !isSearch.value && props.unit.length > 0
	})

	// md 不加尺寸 class。state 为空不加状态 class。
	const partClass = (base: string, size: string, state: string): string => {
		let name = base
		if (size !== 'md') name += ` ${base}--${size}`
		if (state.length > 0) name += ` ${base}--${state}`
		return name
	}

	const rootClass = computed((): string => {
		let name = 'vx-input'
		if (props.size !== 'md') name += ` vx-input--${props.size}`
		// line 只有下边框，圆角没有可作用的对象；search 固定胶囊圆角，不吃 shape。
		if (props.variant === 'line') name += ' vx-input--line'
		else if (props.variant === 'search') name += ' vx-input--search'
		else if (props.shape === 'pill') name += ' vx-input--pill'
		else if (props.shape === 'square') name += ' vx-input--square'
		// 搜索的左右内边距收在一档：sm 12、md / lg 16，写在 search 之后才能盖掉档位值。
		if (props.variant === 'search' && props.size === 'sm') name += ' vx-input--search-sm'

		if (props.disabled) {
			name += props.variant === 'line' ? ' vx-input--line-disabled' : ' vx-input--disabled'
		} else {
			if (focused.value && !props.readonly) name += ' vx-input--focused'
			if (props.invalid) name += ' vx-input--invalid'
			if (props.readonly) name += ' vx-input--readonly'
		}
		// 箭头图标自带 em 框留白，右侧内边距收紧一档，让视觉边距接近 12px。
		if (props.arrow) name += ' vx-input--arrow'
		return name
	})

	const labelClass = computed((): string => {
		return partClass('vx-input__label', props.size, '')
	})

	const requiredClass = computed((): string => {
		return partClass('vx-input__required', props.size, props.disabled ? 'disabled' : '')
	})

	const labelTextClass = computed((): string => {
		return partClass('vx-input__label-text', props.size, props.disabled ? 'disabled' : '')
	})

	const controlClass = computed((): string => {
		let name = partClass('vx-input__control', props.size, props.disabled ? 'disabled' : '')
		if (props.align === 'right') name += ' vx-input__control--right'
		return name
	})

	const valueClass = computed((): string => {
		let state = ''
		if (props.disabled) state = 'disabled'
		else if (modelValue.value.length === 0) state = 'placeholder'
		let name = partClass('vx-input__value', props.size, state)
		if (props.align === 'right') name += ' vx-input__value--right'
		return name
	})

	const unitClass = computed((): string => {
		return partClass('vx-input__unit', props.size, props.disabled ? 'disabled' : '')
	})

	const clearClass = computed((): string => {
		let name = partClass('vx-input__clear', props.size, '')
		// 搜索变体右侧要先让位给取消，清除收成图标宽，不再占一个控件高度。
		if (isSearch.value) name += ' vx-input__clear--search'
		return name
	})

	const clearMarkClass = computed((): string => {
		return partClass('vx-input__clear-mark', props.size, '')
	})

	const searchCancelClass = computed((): string => {
		return partClass('vx-input__search-cancel', props.size, props.disabled ? 'disabled' : '')
	})

	const searchCancelTextClass = computed((): string => {
		return partClass('vx-input__search-cancel-text', props.size, props.disabled ? 'disabled' : '')
	})

	const searchCancelHoverClass = computed((): string => {
		return props.disabled ? 'none' : 'vx-input__search-cancel--pressed'
	})

	// 搜索图标走 vx-icon 的 sm / md 两档（14 / 18），lg 与 md 同档，不新增第四种图标尺寸。
	const searchIconSize = computed((): 'sm' | 'md' => {
		return props.size === 'sm' ? 'sm' : 'md'
	})

	const searchIconColor = computed((): string => {
		return props.disabled ? 'var(--vx-color-disabled-text)' : 'var(--vx-color-text-secondary)'
	})

	// 有值或聚焦时出现，其余时候不占位；只读行不出取消，避免一个点了没反应的按钮。
	const showSearchCancel = computed((): boolean => {
		if (!isSearch.value || props.readonly) return false
		// #ifdef APP
		if (cancelPressing.value) return true
		// #endif
		return focused.value || modelValue.value.length > 0
	})

	// 清除和选择箭头都比输入框字号小一档，避免图标撑满控件高度。
	const iconSize = computed((): 'sm' | 'md' => {
		return props.size === 'lg' ? 'md' : 'sm'
	})

	const arrowColor = computed((): string => {
		return props.disabled ? 'var(--vx-color-disabled-text)' : 'var(--vx-color-text-secondary)'
	})

	const placeholderClass = computed((): string => {
		return partClass('vx-input__placeholder', props.size, props.disabled ? 'disabled' : '')
	})

	// 有值就显示，不看焦点。
	const showClear = computed((): boolean => {
		if (!props.clearable || props.disabled || props.readonly) return false
		return modelValue.value.length > 0
	})

	const labelStyle = computed((): string => {
		if (props.labelWidth.length === 0) return ''
		return `width: ${props.labelWidth};`
	})

	const displayValue = computed((): string => {
		if (modelValue.value.length === 0) return props.placeholder
		if (props.password) return '•'.repeat(modelValue.value.length)
		return modelValue.value
	})

	// detail 在原生端是权威值；普通 input 没有 detail 时退回已经同步的模型值。
	const onInput = (event: UniInputEvent) => {
		emit('input', event.detail != null ? event.detail.value : modelValue.value)
	}

	const onChange = (event: UniInputChangeEvent) => {
		emit('change', event.detail != null ? event.detail.value : modelValue.value)
	}

	// 搜索变体的确认键多抛一次 search，值仍是当前文本；confirm 照常保留。
	const onConfirm = (event: UniInputConfirmEvent) => {
		const value = event.detail != null ? event.detail.value : modelValue.value
		emit('confirm', value)
		if (isSearch.value) emit('search', value)
	}

	const onFocus = () => {
		focused.value = true
		emit('focus')
	}

	const onBlur = () => {
		focused.value = false
		emit('blur')
	}

	// 点清除：有值时写回空串，先抛 clear，再补抛一次 input('')，绑 @input 过滤的业务也能收到空串。
	// change 仍只走失焦和确认，这里不抛；已经是空串时没有可清的值，不补抛。
	const onClear = () => {
		if (modelValue.value.length === 0) return
		modelValue.value = ''
		emit('clear')
		emit('input', '')
	}

	const onSearchCancelDown = () => {
		// #ifdef APP
		cancelPressing.value = true
		measureCancelRect()
		// #endif
	}

	const onSearchCancelUp = () => {
		// #ifdef APP
		cancelPressing.value = false
		// #endif
	}

	// 滑出取消热区就复位：App 上手指滑出去不会补 click，也不会补 touchcancel。
	const onSearchCancelMove = (event: UniTouchEvent) => {
		// #ifdef APP
		if (!cancelPressing.value) return
		const rect = cancelRect
		if (rect == null) return
		const touches = event.touches
		if (touches.length === 0) return
		const touch = touches[0]
		// 量到的矩形和 clientX / clientY 都在视口坐标系，不用减页面滚动。
		const outsideX = touch.clientX < rect.left || touch.clientX > rect.left + rect.width
		const outsideY = touch.clientY < rect.top || touch.clientY > rect.top + rect.height
		if (!outsideX && !outsideY) return
		cancelPressing.value = false
		// #endif
	}

	// 取消：先清空、收起键盘，再抛 cancel。禁用时不响应，只读不出取消。
	const onSearchCancel = () => {
		onSearchCancelUp()
		if (props.disabled) return
		modelValue.value = ''
		focused.value = false
		// 收键盘走平台 API；文档站预览没有 uni 运行时会静默跳过。
		if (typeof uni !== 'undefined' && typeof uni.hideKeyboard === 'function') {
			try {
				uni.hideKeyboard()
			} catch (error) {
				// 拿不到键盘不影响清空和事件。
			}
		}
		emit('cancel')
	}

	// 禁用不抛 click。只读行仍抛，用来开选择器。
	const onClick = () => {
		if (props.disabled) return
		emit('click')
	}

	// 搜索框没有标题位：同时传了 label / required / unit 时提示一次，渲染时也不画。
	let warnedSearchSlot = false

	const warnSearchSlot = () => {
		if (warnedSearchSlot) return
		if (!isSearch.value) return
		if (props.label.length === 0 && !props.required && props.unit.length === 0) return
		warnedSearchSlot = true
		console.warn('[vx-input] variant="search" 不渲染 label / required / unit；标题和单位请放到输入框外面。')
	}

	watch((): string => `${props.variant}|${props.label}|${props.required ? '1' : '0'}|${props.unit}`, () => {
		warnSearchSlot()
	})

	onMounted(() => {
		warnSearchSlot()
	})
</script>

<style>
	/* App 不能把自定义变量定义成另一个 var()。
	   同一元素上，class 字符串里靠后的声明盖过靠前的；样式表顺序与此一致。 */
	.vx-input {
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
		height: var(--vx-control-height-md);
		padding-left: var(--vx-space-lg);
		padding-right: var(--vx-space-lg);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-control-radius-md);
		background-color: var(--vx-color-surface);
	}

	.vx-input--lg {
		height: var(--vx-control-height-lg);
		padding-left: var(--vx-space-xl);
		padding-right: var(--vx-space-xl);
		border-radius: var(--vx-control-radius-lg);
	}

	.vx-input--sm {
		height: var(--vx-control-height-sm);
		padding-left: var(--vx-space-md);
		padding-right: var(--vx-space-md);
		border-radius: var(--vx-control-radius-sm);
	}

	.vx-input--line {
		border-top-width: 0;
		border-left-width: 0;
		border-right-width: 0;
		border-radius: 0;
	}

	.vx-input--pill {
		border-radius: var(--vx-radius-pill);
	}

	.vx-input--square {
		border-radius: 0;
	}

	/* 搜索框：浅底胶囊，默认不画可见描边。描边留 1px 透明，
	   聚焦和错误只换颜色，于是状态切换不改内宽、也不跳行高。 */
	.vx-input--search {
		padding-left: var(--vx-space-lg);
		padding-right: var(--vx-space-lg);
		border-color: transparent;
		border-radius: var(--vx-radius-pill);
		background-color: var(--vx-color-default-soft);
	}

	/* 小号搜索框收一档左右内边距，跟控件内边距 12 对齐。 */
	.vx-input--search-sm {
		padding-left: var(--vx-space-md);
		padding-right: var(--vx-space-md);
	}

	.vx-input--focused {
		border-color: var(--vx-color-primary);
	}

	.vx-input--invalid {
		border-color: var(--vx-color-danger);
	}

	.vx-input--disabled {
		background-color: var(--vx-color-disabled-bg);
		border-color: var(--vx-color-disabled-bg);
	}

	.vx-input--line-disabled {
		background-color: var(--vx-color-surface);
		border-color: var(--vx-color-border);
	}

	.vx-input__label {
		flex-direction: row;
		align-items: center;
		flex-shrink: 0;
		margin-right: var(--vx-space-md);
	}

	.vx-input__label--lg {
		margin-right: var(--vx-space-lg);
	}

	.vx-input__label--sm {
		margin-right: var(--vx-space-sm);
	}

	.vx-input__required,
	.vx-input__label-text,
	.vx-input__control,
	.vx-input__value,
	.vx-input__unit {
		font-size: var(--vx-font-control-md);
		line-height: var(--vx-line-md);
	}

	.vx-input__required--lg,
	.vx-input__label-text--lg,
	.vx-input__control--lg,
	.vx-input__value--lg,
	.vx-input__unit--lg {
		font-size: var(--vx-font-control-lg);
		line-height: var(--vx-line-lg);
	}

	.vx-input__required--sm,
	.vx-input__label-text--sm,
	.vx-input__control--sm,
	.vx-input__value--sm,
	.vx-input__unit--sm {
		font-size: var(--vx-font-control-sm);
		line-height: var(--vx-line-sm);
	}

	.vx-input__required {
		margin-right: var(--vx-space-xs);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-danger);
	}

	.vx-input__label-text,
	.vx-input__control,
	.vx-input__value {
		color: var(--vx-color-text);
	}

	/* 标题比内容重一档，长表单里更容易扫读。 */
	.vx-input__label-text {
		font-weight: var(--vx-weight-medium);
	}

	.vx-input__value--placeholder,
	.vx-input__unit {
		color: var(--vx-color-text-secondary);
	}

	.vx-input__required--disabled,
	.vx-input__label-text--disabled,
	.vx-input__control--disabled,
	.vx-input__value--disabled,
	.vx-input__unit--disabled {
		color: var(--vx-color-disabled-text);
	}

	.vx-input__prefix {
		flex-shrink: 0;
		margin-right: var(--vx-space-sm);
	}

	.vx-input__suffix {
		flex-shrink: 0;
		margin-left: var(--vx-space-sm);
	}

	.vx-input__control {
		flex: 1;
		/* 盖掉原生 input 的默认宽度，剩下的空间交给 flex。 */
		width: 0;
		min-width: 0;
		height: 100%;
		padding-top: 0;
		padding-right: 0;
		padding-bottom: 0;
		padding-left: 0;
		border-width: 0;
		background-color: transparent;
	}

	.vx-input__control--right,
	.vx-input__value--right {
		text-align: right;
	}

	/* 高度不写 100%：App 端固定高容器里的 text 会把 frame 拉满整行，
	   行盒只在顶部，值文字就顶上去了；auto 高让根节点的 align-items 居中。 */
	.vx-input__display {
		flex: 1;
		width: 0;
		min-width: 0;
		flex-direction: row;
		align-items: center;
		overflow: hidden;
	}

	.vx-input__value {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* iOS 量比例字符（% 等）比字形窄，末字符会被自己的边界裁掉；
	   padding 补出余量、负 margin 找回位置，墨迹不动，只是裁剪边界右移。 */
	.vx-input__unit {
		flex-shrink: 0;
		margin-left: var(--vx-space-sm);
		padding-right: 6px;
		margin-right: -6px;
	}

	.vx-input__clear {
		flex-direction: row;
		flex-shrink: 0;
		/* sm / md 图标 14，热区再加左右各 8，合计 30；不再占用整档控件高度。 */
		width: 30px;
		align-self: stretch;
		align-items: center;
		/* 图标靠右，和箭头、后缀图标落在同一条右侧基线上。 */
		justify-content: flex-end;
		margin-left: var(--vx-space-xs);
	}

	.vx-input__clear--lg {
		/* lg 图标 18，合计 34。 */
		width: 34px;
	}

	/* 搜索的清除收成图标宽，和取消挤在同一条右侧基线上。 */
	.vx-input__clear--search {
		width: auto;
		justify-content: center;
		margin-left: var(--vx-space-xs);
	}

	.vx-input__search-icon {
		flex-shrink: 0;
		flex-direction: row;
		align-items: center;
		margin-right: var(--vx-space-sm);
	}

	/* 取消整格是热区，高度撑满控件；文案只占自身宽度，不预先留白。 */
	.vx-input__search-cancel {
		flex-shrink: 0;
		flex-direction: row;
		align-self: stretch;
		align-items: center;
		padding-left: var(--vx-space-sm);
	}

	.vx-input__search-cancel--pressed {
		opacity: var(--vx-opacity-pressed);
	}

	.vx-input__search-cancel-text {
		color: var(--vx-color-text-secondary);
		font-size: var(--vx-font-control-md);
		line-height: var(--vx-line-md);
	}

	.vx-input__search-cancel-text--lg {
		font-size: var(--vx-font-control-lg);
