<template>
	<!-- 列只负责宽度、偏移和间距；底色、描边、圆角和内容都由插槽自己带。 -->
	<!-- 非 Web 的 stretch 才写 id，测量结果靠它把矩形对回这一列。 -->
	<view :id="nodeId" :class="rootClass" :style="rootStyle">
		<slot></slot>
	</view>
</template>

<script setup>
	import { VxColProps } from './props'
	import { VX_ROW_CONTEXT, VxRowContext, readWindowWidth } from '../vx-row/context'

	const props = withDefaults(defineProps<VxColProps>(), {
		span: 24,
		offset: 0,
		push: 0,
		pull: 0,
		sm: -1,
		md: -1,
		lg: -1,
		xl: -1
	})

	// inject 只能在 setup 里调。没有外层行时没有间距，宽度仍按父级的份数算。
	const row = inject(VX_ROW_CONTEXT, null) as VxRowContext | null

	// 测量标记在 setup 里领，和节点一起出现；卸载再交还。没有行时不登记。
	let mark = 0
	if (row != null) mark = row.claimMark()

	// 断点取 Web 上常见的 min-width 数值：576 平板竖屏、768 平板横屏、992 桌面、1200 宽屏。
	// 蒸汽模式不支持 @media，列宽改用窗口宽度在脚本里算。
	const VX_COL_SM = 576
	const VX_COL_MD = 768
	const VX_COL_LG = 992
	const VX_COL_XL = 1200

	const VX_COL_TOTAL = 24

	// 行里的列共用行上的那一次测量，不读这个值。单独使用才听 onResize，不挂 window。
	const windowWidth = ref(0)
	if (row == null) {
		windowWidth.value = readWindowWidth()
		onResize(() => {
			windowWidth.value = readWindowWidth()
		})
	}

	// 列数只认 0–24 的整数：0 表示这一档不显示，负数按 0，超过 24 按整行。
	const toUnits = (value: number): number => {
		const rounded = Math.round(value)
		if (!(rounded > 0)) return 0
		return rounded > VX_COL_TOTAL ? VX_COL_TOTAL : rounded
	}

	// 断点从窄到宽依次覆盖，没传（-1）的那一档保持上一档；span 是兜底。
	// 四个断点都没写时不读窗口宽度，旋转和键盘弹起不会让这一列重排。
	const spanUnits = computed((): number => {
		let value = props.span
		if (props.sm < 0 && props.md < 0 && props.lg < 0 && props.xl < 0) return toUnits(value)
		let width = 0
		if (row != null) width = row.windowWidth()
		else width = windowWidth.value
		if (width >= VX_COL_SM && props.sm >= 0) value = props.sm
		if (width >= VX_COL_MD && props.md >= 0) value = props.md
		if (width >= VX_COL_LG && props.lg >= 0) value = props.lg
		if (width >= VX_COL_XL && props.xl >= 0) value = props.xl
		return toUnits(value)
	})

	// 占 0 列就是不显示：留在 DOM 里，切回宽屏时不用重建。
	const hidden = computed((): boolean => spanUnits.value <= 0)

	// 偏移和跨度一起收口，写超了也不会把列挤到下一行。
	const offsetUnits = computed((): number => {
		if (hidden.value) return 0
		const limit = VX_COL_TOTAL - spanUnits.value
		const units = toUnits(props.offset)
		return units > limit ? limit : units
	})

	// 两个位移取净值：push 向右、pull 向左，同时传时互相抵消。
	const shiftUnits = computed((): number => {
		return toUnits(props.push) - toUnits(props.pull)
	})

	// 24 栅格的百分比。向下取到 6 位小数，24 个 1 加起来不会超过 100%，
	// 最后一列才不会因为多出来的那一点点被挤到下一行。
	const percentOf = (units: number): string => {
		const absolute = units < 0 ? -units : units
		if (absolute >= VX_COL_TOTAL) return units < 0 ? '-100%' : '100%'
		const value = Math.floor((absolute * 100 / VX_COL_TOTAL) * 1000000) / 1000000
		return units < 0 ? `-${value}%` : `${value}%`
	}

	// App 把多值 padding 收成同一个方向，左右分开写。占 0 列时不留宽度和间距。
	const rootStyle = computed((): string => {
		if (hidden.value) return ''
		let style = `width: ${percentOf(spanUnits.value)};`
		const offset = offsetUnits.value
		if (offset > 0) style += ` margin-left: ${percentOf(offset)};`
		const shift = shiftUnits.value
		if (shift !== 0) style += ` left: ${percentOf(shift)};`
		if (row != null) {
			const inset = row.inset()
			if (inset > 0) style += ` padding-right: ${inset}px; padding-left: ${inset}px;`
			const lineGutter = row.lineGutter()
			if (lineGutter > 0) style += ` margin-top: ${lineGutter}px;`
			// 只有 stretch 才写高度。离开 stretch 时这一支不走，上一轮写上的 height 会从样式里拿掉。
			// 高度为 0 也不写：Web 不测量，App 还没量到或正在重测时列高跟内容走。
			if (row.align() === 'stretch') {
				const stretchHeight = row.stretchHeight(mark)
				if (stretchHeight > 0) style += ` height: ${stretchHeight}px;`
			}
		}
		return style
	})

	// 行要求 stretch 时列自己再声明一次：App 端自定义组件根节点有时接不住父级
	// align-items，显式 align-self 才能让列和同行最高列等高。
	const stretch = computed((): boolean => {
		return row != null && row.align() === 'stretch'
	})

	// 非 Web 的 stretch 才写 id，测量结果才能对回这一列。
	const nodeId = computed((): string => {
		if (row == null || hidden.value || !stretch.value) return ''
		// #ifdef WEB
		return ''
		// #endif
		// #ifndef WEB
		return 'vx-c-' + row.id() + '-' + mark
		// #endif
	})

	// class 顺序：基础 → 位移 → 拉伸 → 隐藏。隐藏时不挂位移：display: none 下 left 没有意义。
	const rootClass = computed((): string => {
		if (hidden.value) return 'vx-col vx-col--hidden'
		let name = 'vx-col'
		if (shiftUnits.value !== 0) name += ' vx-col--shift'
		if (stretch.value && row != null) name += ' vx-col--stretch vx-col--row-' + row.id()
		return name
	})

	// #ifdef APP
	let contentObserver: UniResizeObserver | null = null
	let contentBindTimer = 0
	let contentBindTries = 0

	const isNestedGrid = (element: UniElement): boolean => {
		const id = element.id
		if (id != null && id.indexOf('vx-c-') === 0) return true
		const names = element.classList
		if (names == null) return false
		for (let index = 0; index < names.length; index++) {
			const name = '' + names[index]
			if (name === 'vx-col' || name === 'vx-row') return true
		}
		return false
	}

	const watchContent = (element: UniElement) => {
		if (contentObserver == null) return
		const children = element.children
		if (children == null) return
		for (let index = 0; index < children.length; index++) {
			const child = children[index]
			if (child == null) continue
			// 嵌套栅格自己量。只听它的外框，内容变高时外层这一列才跟着重测。
			if (isNestedGrid(child)) {
				contentObserver.observe(child)
				continue
			}
			contentObserver.observe(child)
			watchContent(child)
		}
	}

	const observedHeight = (entry: UniResizeObserverEntry): number => {
		const borders = entry.borderBoxSize
		if (borders != null && borders.length > 0) {
			const border = borders[0]
			if (border != null && border.blockSize > 0) return border.blockSize
		}
		const rect = entry.contentRect
		if (rect == null || rect.height == null || !(rect.height > 0)) return 0
		return rect.height
	}

	const disconnectContent = () => {
		if (contentBindTimer !== 0) {
			clearTimeout(contentBindTimer)
			contentBindTimer = 0
		}
		if (contentObserver == null) return
		contentObserver.disconnect()
		contentObserver = null
	}

	const bindContent = () => {
		if (contentBindTimer !== 0) {
			clearTimeout(contentBindTimer)
			contentBindTimer = 0
		}
		if (row == null || hidden.value || row.align() !== 'stretch') {
			disconnectContent()
			return
		}
		if (typeof UniResizeObserver !== 'function') return
		const id = nodeId.value
		if (id.length === 0) return
		const element = uni.getElementById(id)
		if (element == null) {
			if (contentBindTries >= 3) return
			contentBindTries += 1
			contentBindTimer = setTimeout(bindContent, 60)
			return
		}
		contentBindTries = 0
		if (contentObserver != null) {
			contentObserver.disconnect()
			contentObserver = null
		}
		contentObserver = new UniResizeObserver((entries: Array<UniResizeObserverEntry>) => {
			if (row == null) return
			const locked = row.stretchHeight(mark)
			for (let index = 0; index < entries.length; index++) {
				const entry = entries[index]
				if (entry == null) continue
				const height = observedHeight(entry)
				if (!(height > 0)) continue
				// 行把列撑高时，被撑开的子节点会再报一次，高度和列高一样。
				if (locked > 0 && Math.abs(height - locked) <= 0.5) continue
				row.notifyContent()
				return
			}
		})
		watchContent(element)
	}
	// #endif

	onMounted(() => {
		// #ifdef APP
		nextTick(() => bindContent())
		// #endif
	})

	onUnmounted(() => {
		if (row != null) row.releaseMark(mark)
		// #ifdef APP
		disconnectContent()
		// #endif
	})

	if (row != null) {
		watch(hidden, (value: boolean) => {
			row.requestStretch()
			// #ifdef APP
			if (value) disconnectContent()
			else nextTick(() => bindContent())
			// #endif
		})
		// #ifdef APP
		watch(stretch, (value: boolean) => {
			if (value && !hidden.value) nextTick(() => bindContent())
			else disconnectContent()
		})
		// #endif
		// 小程序没有元素尺寸监听。折叠、换文案会让列重新渲染，靠这次补量。
		// #ifndef APP
		// #ifndef WEB
		onUpdated(() => {
			row.notifyContent()
		})
		// #endif
		// #endif
	}
</script>

<style>
	/* 宽度、偏移和间距由内联样式给。
	   Web 默认 content-box，百分比宽度再加左右内边距会把最后一列挤下去，所以固定 border-box。
	   App 的 position 只认 relative/absolute/fixed，基础列不写；需要 left 的位移列再单独设 relative。
	   min-width 压成 0，长文案在列里换行，不会把列撑过份数。
	   flex-shrink 归 1：行关掉换行时，超出的列按比例压缩，不会撑出父级。
	   overflow 可见：push / pull 画出列框，裁切会把内容切掉。 */
	.vx-col {
		flex-direction: column;
		flex-shrink: 1;
		box-sizing: border-box;
		min-width: 0;
		overflow: visible;
	}

	/* 位移是视觉上的左右移动，不改变占位；left 的百分比按行宽算，和 24 栅格同一套单位。 */
	.vx-col--shift {
		position: relative;
	}

	/* 等高行：列拉伸到这一行的行高，列里的内容再用 flex: 1 填满。 */
	.vx-col--stretch {
		align-self: stretch;
	}

	/* 当前宽度下占 0 列：整列不显示，但仍留在页面里，切回宽屏时不用重建。 */
	.vx-col--hidden {
		display: none;
	}
</style>
