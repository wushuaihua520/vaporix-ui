						<text class="demo-div-label demo-div-label--spaced">align="right"</text>
						<vx-divider text="展开全部" align="right" />
					</view>
					<text class="demo-hint demo-div-hint">文字 13 / 20 次要灰，和线之间留 12；left 只画右侧线、right 只画左侧线、center 两侧等宽。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">虚线</text>
							<text class="demo-section__desc">dashed 只把边框样式换成虚线，不画背景渐变。</text>
						</view>
					</view>
					<view class="demo-card">
						<text class="demo-div-label">虚线横线</text>
						<vx-divider dashed />
						<text class="demo-div-label demo-div-label--spaced">虚线 + 文字</text>
						<vx-divider dashed text="更多内容" />
						<view class="demo-div-dash-row">
							<view class="demo-div-dash__bar">
								<text class="demo-div-dash__text">上一格</text>
							</view>
							<vx-divider direction="vertical" dashed spacing="12" />
							<view class="demo-div-dash__bar">
								<text class="demo-div-dash__text">下一格</text>
							</view>
						</view>
					</view>
					<text class="demo-hint demo-div-hint">1px 虚线在屏幕上会显得略淡；要更醒目时换 color，不要加粗到 2px。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">04</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">纵向</text>
							<text class="demo-section__desc">高度空串时撑满父级那一行，不自动水平居中。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-div-stats">
							<view class="demo-div-stat">
								<text class="demo-div-stat__value">128</text>
								<text class="demo-div-stat__label">订单</text>
							</view>
							<vx-divider direction="vertical" />
							<view class="demo-div-stat">
								<text class="demo-div-stat__value">36</text>
								<text class="demo-div-stat__label">收藏</text>
							</view>
							<vx-divider direction="vertical" />
							<view class="demo-div-stat">
								<text class="demo-div-stat__value">4.9</text>
								<text class="demo-div-stat__label">评分</text>
							</view>
						</view>
						<view class="demo-div-height">
							<view class="demo-div-height__box">
								<text class="demo-div-height__text">上一格</text>
							</view>
							<vx-divider direction="vertical" height="40px" />
							<view class="demo-div-height__box">
								<text class="demo-div-height__text">40 高的线</text>
							</view>
						</view>
					</view>
					<text class="demo-hint demo-div-hint">竖线宽 1px，由父级 flex 排布；传 height 才固定高度，不传就撑满整行。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">05</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">自定义间距与颜色</text>
							<text class="demo-section__desc">spacing 数字按 px，字符串带单位；color 同时改线和文字。</text>
						</view>
					</view>
					<view class="demo-card">
						<text class="demo-div-label">spacing 0</text>
						<vx-divider :spacing="0" />
						<text class="demo-div-label demo-div-label--spaced">spacing 24</text>
						<vx-divider :spacing="24" />
						<text class="demo-div-label demo-div-label--spaced">spacing 32px</text>
						<vx-divider spacing="32px" />
						<text class="demo-div-label demo-div-label--spaced">color · 主色</text>
						<vx-divider text="品牌分隔" color="var(--vx-color-primary)" />
						<text class="demo-div-label demo-div-label--spaced">color · 危险色</text>
						<vx-divider dashed text="危险操作" color="var(--vx-color-danger)" />
					</view>
					<text class="demo-hint demo-div-hint">color 是字面值，只覆盖线色和文字色，不跟随主题；跟主题时传 var(--vx-color-*)。</text>
				</view>

				<view class="demo-page-nav">
					<view class="demo-page-nav__item"
						:class="prevPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goPrev">
						<text class="demo-page-nav__label">上一个</text>
						<text class="demo-page-nav__name">{{ prevName }}</text>
					</view>
					<view class="demo-page-nav__item demo-page-nav__item--next"
						:class="nextPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goNext">
						<text class="demo-page-nav__label">下一个</text>
						<text class="demo-page-nav__name">{{ nextName }}</text>
					</view>
				</view>

				<view class="demo-footer">
					<text class="demo-footer__text">元汽UI · MIT</text>
					<text class="demo-footer__meta">VAPORIX UI · 组件演示 · v0.64.0</text>
