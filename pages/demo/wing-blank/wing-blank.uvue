</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/white-space/white-space'
	const nextPath: string = '/pages/demo/grid/grid'
	const prevName = '上下留白'
	const nextName = '宫格'

	const onCellClick = (label: string) => {
		uni.showToast({ title: label, icon: 'none' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
	/* 留白本身透明，演示用带底色的框把左右内边距显出来。 */
	.demo-wb-frame {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-md);
		padding-bottom: var(--vx-space-md);
		border-width: var(--vx-border-width);
