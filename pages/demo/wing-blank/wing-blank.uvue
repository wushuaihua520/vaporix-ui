<template>
	<view :class="pageClass">
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<view class="demo-shell">
				<view class="demo-pagebar">
					<view class="demo-crumb">
						<view class="demo-crumb__back" hover-class="demo-crumb__back--pressed" @click="goCatalog">
							<vx-icon name="chevron-left" size="sm" />
							<text class="demo-crumb__back-text">组件</text>
						</view>
						<text class="demo-crumb__sep">/</text>
						<text class="demo-crumb__current">布局</text>
					</view>
					<view class="demo-theme-toggle" hover-class="demo-theme-toggle--pressed"
						@click="toggleDemoPageTheme">
						<vx-icon :name="isDark ? 'sun' : 'moon'" size="md" />
					</view>
				</view>

				<view class="demo-hero">
					<text class="demo-hero__eyebrow">VAPORIX UI · vx-wing-blank</text>
					<view class="demo-hero__top">
						<view class="demo-hero__icon">
							<vx-icon name="align-left" size="lg" type="primary" />
						</view>
						<view class="demo-hero__heading">
							<view class="demo-hero__title-wrap">
								<text class="demo-hero__title">左右留白</text>
								<text class="demo-hero__title demo-hero__title--accent">5 组示例</text>
							</view>
						</view>
					</view>
					<text class="demo-hero__lead">只加左右内边距：三档间距、自定义宽度，页面边距只收一次。</text>
					<view class="demo-hero__chips">
						<view class="demo-chip">
							<text class="demo-chip__text">布局</text>
						</view>
						<view class="demo-chip demo-chip--neutral">
							<text class="demo-chip__text demo-chip__text--neutral">vx-wing-blank</text>
						</view>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">01</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">基础</text>
							<text class="demo-section__desc">默认 md 在左右各留 12，内容放在默认插槽里。</text>
						</view>
					</view>
					<view class="demo-wb-frame">
						<vx-wing-blank>
							<view class="demo-wb-box">
								<text class="demo-wb-box__eyebrow">DEFAULT SLOT</text>
								<text class="demo-wb-box__title">内容放进左右留白</text>
								<text class="demo-wb-box__body">组件只加左右内边距，不画外框、底色和阴影，高度由内容撑开。</text>
							</view>
						</vx-wing-blank>
					</view>
					<text class="demo-hint demo-wb-hint">宽度跟随父级；左右各 12，移动端内容不会贴住屏幕边缘。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">02</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">三档尺寸</text>
							<text class="demo-section__desc">sm / md / lg 对应 8 / 12 / 16，直接取间距令牌。</text>
						</view>
					</view>
					<view class="demo-wb-scale">
						<view class="demo-wb-scale__head">
							<text class="demo-wb-scale__name">sm</text>
							<text class="demo-wb-scale__meta">8px</text>
						</view>
						<view class="demo-wb-frame">
							<vx-wing-blank size="sm">
								<view class="demo-wb-box demo-wb-box--compact">
									<text class="demo-wb-box__body">左右各留 8，适合紧凑的工具条和密集列表。</text>
								</view>
							</vx-wing-blank>
						</view>
					</view>
					<view class="demo-wb-scale">
						<view class="demo-wb-scale__head">
							<text class="demo-wb-scale__name">md</text>
							<text class="demo-wb-scale__meta">12px</text>
						</view>
						<view class="demo-wb-frame">
							<vx-wing-blank>
								<view class="demo-wb-box demo-wb-box--compact">
									<text class="demo-wb-box__body">左右各留 12，是页面里最常用的一档。</text>
								</view>
							</vx-wing-blank>
						</view>
					</view>
					<view class="demo-wb-scale demo-wb-scale--last">
						<view class="demo-wb-scale__head">
							<text class="demo-wb-scale__name">lg</text>
							<text class="demo-wb-scale__meta">16px</text>
						</view>
						<view class="demo-wb-frame">
							<vx-wing-blank size="lg">
								<view class="demo-wb-box demo-wb-box--compact">
									<text class="demo-wb-box__body">左右各留 16，和页面左右边距同值。</text>
								</view>
							</vx-wing-blank>
						</view>
					</view>
					<text class="demo-hint demo-wb-hint">同一层级用同一档；页面已经有 16 边距时，再套 lg 就是 32。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">自定义间距</text>
							<text class="demo-section__desc">gap 传带单位的值时盖过 size，px、rpx 和百分比都可以。</text>
						</view>
					</view>
					<view class="demo-wb-scale">
						<view class="demo-wb-scale__head">
							<text class="demo-wb-scale__name">24px</text>
							<text class="demo-wb-scale__meta">区块</text>
						</view>
						<view class="demo-wb-frame">
							<vx-wing-blank gap="24px">
								<view class="demo-wb-box demo-wb-box--compact">
									<text class="demo-wb-box__body">左右各留 24，内容再收进一段。</text>
								</view>
							</vx-wing-blank>
						</view>
					</view>
					<view class="demo-wb-scale">
						<view class="demo-wb-scale__head">
							<text class="demo-wb-scale__name">32px</text>
							<text class="demo-wb-scale__meta">章节</text>
						</view>
						<view class="demo-wb-frame">
							<vx-wing-blank size="sm" gap="32px">
								<view class="demo-wb-box demo-wb-box--compact">
									<text class="demo-wb-box__body">size 被 gap 盖过，标称档位不再参与。</text>
								</view>
							</vx-wing-blank>
						</view>
					</view>
					<view class="demo-wb-scale demo-wb-scale--last">
						<view class="demo-wb-scale__head">
							<text class="demo-wb-scale__name">64rpx</text>
							<text class="demo-wb-scale__meta">随屏宽</text>
						</view>
						<view class="demo-wb-frame">
							<vx-wing-blank gap="64rpx">
								<view class="demo-wb-box demo-wb-box--compact">
									<text class="demo-wb-box__body">只有确实要随屏宽变化时才用 rpx。</text>
								</view>
							</vx-wing-blank>
						</view>
					</view>
					<text class="demo-hint demo-wb-hint">gap 是左右内边距，不是子项间距；百分比按父级宽度算，记得给内容留足宽度。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">04</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">页面边距</text>
							<text class="demo-section__desc">通栏区块用 lg 把内容拉回页面边距，和上面的标题对齐。</text>
						</view>
					</view>
					<view class="demo-wb-page">
						<text class="demo-wb-page__eyebrow">PAGE MARGIN</text>
						<text class="demo-wb-page__title">页面标题</text>
						<text class="demo-wb-page__body">下面是一块通栏卡片，左右不再留页面边距。</text>
						<view class="demo-wb-bleed">
							<vx-wing-blank size="lg">
								<text class="demo-wb-page__title">卡片内容</text>
								<text class="demo-wb-page__body">靠 wing-blank 的 16 和上面的标题左对齐。</text>
							</vx-wing-blank>
						</view>
					</view>
					<text class="demo-hint demo-wb-hint">页面边距只留一次；通栏卡片自己贴边，再用 lg 把内容收回来。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">05</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">组合</text>
							<text class="demo-section__desc">左右交给 wing-blank，上下交给 white-space，内容再用列表和标题栏排。</text>
						</view>
					</view>
					<view class="demo-wb-bleed">
						<vx-wing-blank size="lg">
							<vx-section title="账户与安全" description="最近 30 天内更新" marker />
							<vx-white-space size="md" />
							<vx-list-view variant="card">
								<vx-list-cell title="登录密码" value="已设置" arrow @click="onCellClick('登录密码')">
									<template #prefix>
										<vx-icon name="lock" size="md" type="primary" />
									</template>
								</vx-list-cell>
								<vx-list-cell title="绑定手机" value="138****8888" arrow @click="onCellClick('绑定手机')">
									<template #prefix>
										<vx-icon name="smartphone" size="md" type="info" />
									</template>
								</vx-list-cell>
								<vx-list-cell title="登录设备" value="3 台" arrow :divider="false"
									@click="onCellClick('登录设备')">
									<template #prefix>
										<vx-icon name="laptop" size="md" type="success" />
									</template>
								</vx-list-cell>
							</vx-list-view>
							<vx-white-space height="24px" />
						</vx-wing-blank>
					</view>
					<text class="demo-hint demo-wb-hint">两个组件都不承载点击；行、按钮和链接由插槽内容自己提供。</text>
				</view>

				<view class="demo-page-nav">
					<view class="demo-page-nav__item"
						:class="prevPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goPrev">
						<text class="demo-page-nav__label">上一个</text>
						<text class="demo-page-nav__name">{{ prevName }}</text>
					</view>
					<view class="demo-page-nav__item demo-page-nav__item--next"
						:class="nextPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goNext">
						<text class="demo-page-nav__label">下一个</text>
						<text class="demo-page-nav__name">{{ nextName }}</text>
					</view>
				</view>

				<view class="demo-footer">
					<text class="demo-footer__text">元汽UI · MIT</text>
					<text class="demo-footer__meta">VAPORIX UI · 组件演示 · v0.58.0</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/white-space/white-space'
	const nextPath: string = '/pages/demo/grid/grid'
	const prevName = '上下留白'
	const nextName = '宫格'

	const onCellClick = (label: string) => {
		uni.showToast({ title: label, icon: 'none' })
	}

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
	/* 留白本身透明，演示用带底色的框把左右内边距显出来。 */
	.demo-wb-frame {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-md);
		padding-bottom: var(--vx-space-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-lg);
		background-color: var(--vx-color-bg);
	}

	.demo-wb-box {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-md);
		padding-right: var(--vx-space-lg);
		padding-bottom: var(--vx-space-md);
		padding-left: var(--vx-space-lg);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-surface);
	}

	.demo-wb-box--compact {
		padding-top: var(--vx-space-sm);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-sm);
		padding-left: var(--vx-space-md);
	}

	.demo-wb-box__eyebrow {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		letter-spacing: 1px;
		color: var(--vx-color-primary);
		margin-bottom: var(--vx-space-xs);
	}

	.demo-wb-box__title {
		font-size: var(--vx-font-lg);
		line-height: var(--vx-line-lg);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
		margin-bottom: var(--vx-space-xs);
	}

	.demo-wb-box__body {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	.demo-wb-scale {
		width: 100%;
		margin-bottom: var(--vx-space-md);
	}

	.demo-wb-scale--last {
		margin-bottom: 0;
	}

	.demo-wb-scale__head {
		flex-direction: row;
		align-items: center;
		margin-bottom: var(--vx-space-xs);
	}

	.demo-wb-scale__name {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
		margin-right: var(--vx-space-sm);
	}

	.demo-wb-scale__meta {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	.demo-wb-page {
		width: 100%;
	}

	.demo-wb-page__eyebrow {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		letter-spacing: 1px;
		color: var(--vx-color-primary);
		margin-bottom: var(--vx-space-xs);
	}

	.demo-wb-page__title {
		font-size: var(--vx-font-lg);
		line-height: var(--vx-line-lg);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
		margin-bottom: var(--vx-space-xs);
	}

	.demo-wb-page__body {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* 通栏贴住 demo-shell 的左右 16。负外边距和 --vx-space-lg 相同；蒸汽模式没有 calc，不能写成负的变量。
	   不写 width:100%：列布局靠 stretch 吃掉负外边距，写死 100% 时右边会缩回去。 */
	.demo-wb-bleed {
		box-sizing: border-box;
		margin-top: var(--vx-space-md);
		margin-right: -16px;
		margin-left: -16px;
		padding-top: var(--vx-space-lg);
		padding-bottom: var(--vx-space-lg);
		border-top-width: var(--vx-border-width);
		border-top-style: solid;
		border-top-color: var(--vx-color-border);
		border-bottom-width: var(--vx-border-width);
		border-bottom-style: solid;
		border-bottom-color: var(--vx-color-border);
		background-color: var(--vx-color-surface);
	}

	.demo-wb-hint {
		margin-top: var(--vx-space-sm);
	}
</style>
