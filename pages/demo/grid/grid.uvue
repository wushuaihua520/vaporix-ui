<template>
	<view :class="pageClass">
		<demo-topbar title="宫格" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="grid" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="宫格基础" desc="三列入口，图标在上、文案在下；第一行和第一列不画内部线。" />
					<view class="demo-grid-lab">
						<vx-grid>
							<vx-grid-item v-for="(entry, index) in gridEntries" :key="entry.title" :columns="3"
								:index="index" :icon="entry.icon" :title="entry.title"
								@click="onGridAction(entry.title)" />
						</vx-grid>
					</view>
					<text class="demo-hint demo-grid-hint">列数写在格子上，同一组用同一个 columns；点击停在格子上，不会冒到外层。最近点击：{{ gridLastAction }}。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="列数" desc="两列、四列和五列。列数越多，文案越短。" />
					<view class="demo-grid-lab">
						<view class="demo-grid-lab__item">
							<text class="demo-grid-label">两列</text>
							<vx-grid>
								<vx-grid-item v-for="(entry, index) in gridWideEntries" :key="entry.title" :columns="2"
									:index="index" :icon="entry.icon" :title="entry.title" :description="entry.description"
								 @click="onGridAction(entry.title)" />
							</vx-grid>
						</view>
						<view class="demo-grid-lab__item">
							<text class="demo-grid-label">四列</text>
							<vx-grid>
								<vx-grid-item v-for="(entry, index) in gridFourEntries" :key="entry.title" :columns="4"
