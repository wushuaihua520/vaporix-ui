						<view class="demo-grid-lab__item demo-grid-lab__item--last">
							<text class="demo-grid-label">五列</text>
							<vx-grid>
								<vx-grid-item v-for="(entry, index) in gridFiveEntries" :key="entry.title" :columns="5"
									:index="index" size="sm" :icon="entry.icon" :title="entry.title"
