										</view>
									</vx-badge>
								</template>
								<template #extra>
									<view class="demo-nav-search">
										<vx-input v-model="navSearchKeyword" size="sm" shape="pill"
											placeholder="搜索消息" clearable @confirm="onNavSearch" />
									</view>
								</template>
							</vx-navigation-bar>
							<view class="demo-nav-body">
								<view class="demo-nav-message">
									<text class="demo-nav-message__title">订单已发货</text>
									<text class="demo-nav-message__meta">刚刚</text>
								</view>
								<view class="demo-nav-message">
									<text class="demo-nav-message__title">会员权益到账</text>
									<text class="demo-nav-message__meta">10 分钟前</text>
								</view>
								<view class="demo-nav-message demo-nav-message--last">
									<text class="demo-nav-message__title">优惠券即将过期</text>
									<text class="demo-nav-message__meta">昨天</text>
								</view>
							</view>
						</view>
						<view class="demo-tabs-status">
							<text class="demo-tabs-status__label">confirm</text>
							<text class="demo-tabs-status__text">{{ navSearchText }}</text>
						</view>
						<text class="demo-hint">插槽自己带颜色和字号；小程序上 suffix 要让出胶囊，更多动作放 extra。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">07</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">商品页组合</text>
							<text class="demo-section__desc">透明头图导航、搜索、消息和商品卡片放在同一屏。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-nav-compose">
							<view class="demo-nav-compose__hero">
								<vx-navigation-bar :fixed="false" :status-bar="false" transparent title="鲜果商城"
									back color="#ffffff">
									<template #suffix>
										<view class="demo-nav-action" hover-class="demo-nav-action--pressed"
											:hover-stay-time="120" @click="onNavAction('消息')">
											<vx-icon name="message-square" size="lg" color="#ffffff" />
										</view>
									</template>
									<template #extra>
										<view class="demo-nav-search">
											<vx-input v-model="navComposeKeyword" size="sm" shape="pill"
												placeholder="搜索商品" clearable @confirm="onNavSearch" />
										</view>
									</template>
								</vx-navigation-bar>
								<text class="demo-nav-compose__eyebrow">今日到货</text>
								<text class="demo-nav-compose__title">早上摘，晚上到</text>
								<view class="demo-nav-compose__tags">
									<vx-tag text="当季" type="warning" variant="soft" />
									<vx-tag text="包邮" type="success" variant="soft" />
								</view>
							</view>
							<view class="demo-nav-compose__body">
								<view class="demo-nav-compose__grid">
									<view v-for="item in navComposeItems" :key="item.name"
										class="demo-nav-compose__card">
										<image class="demo-nav-compose__image" :src="item.image" mode="aspectFill" />
										<view class="demo-nav-compose__copy">
											<text class="demo-nav-compose__name">{{ item.name }}</text>
											<text class="demo-nav-compose__meta">{{ item.meta }}</text>
										</view>
									</view>
								</view>
							</view>
						</view>
						<text class="demo-hint">导航栏负责标题、返回、搜索和消息；分类要吸顶时放进 vx-sticky，不要叠第二个导航栏。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">08</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">固定与事件</text>
							<text class="demo-section__desc">打开一个 placeholder=false 的固定实例，ready 回传布局。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block type="primary" text="打开固定导航栏"
									@click="navFixedVisible = true" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block text="关闭固定导航栏" @click="navFixedVisible = false" />
							</view>
						</view>
						<view class="demo-tabs-status">
							<text class="demo-tabs-status__label">ready</text>
							<text class="demo-tabs-status__text">{{ navFixedReadyText }}</text>
						</view>
						<text class="demo-hint">fixed 默认打开，占位自动补；这里用 placeholder=false 让导航栏盖在页面上，层级 30 高于吸顶条。</text>
					</view>
				</view>

				<view class="demo-page-nav">
					<view class="demo-page-nav__item"
						:class="prevPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goPrev">
						<text class="demo-page-nav__label">上一个</text>
						<text class="demo-page-nav__name">{{ prevName }}</text>
					</view>
					<view class="demo-page-nav__item demo-page-nav__item--next"
						:class="nextPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goNext">
						<text class="demo-page-nav__label">下一个</text>
						<text class="demo-page-nav__name">{{ nextName }}</text>
					</view>
				</view>

				<view class="demo-footer">
					<text class="demo-footer__text">元汽UI · MIT</text>
					<text class="demo-footer__meta">VAPORIX UI · 组件演示 · v0.59.0</text>
				</view>
			</view>
		</scroll-view>

		<!-- 固定实例挂在页面根上，和滚动容器平级；placeholder=false 时不再占位。 -->
		<vx-navigation-bar v-if="navFixedVisible" :status-bar="false" title="固定导航栏" back divider
			:placeholder="false" :z-index="30" @back="onNavFixedBack" @ready="onNavFixedReady">
			<template #suffix>
				<view class="demo-nav-action" hover-class="demo-nav-action--pressed" :hover-stay-time="120"
					@click="navFixedVisible = false">
					<vx-icon name="close" size="lg" />
				</view>
			</template>
		</vx-navigation-bar>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	type NavigationBarDemoInfo = {
		width: number
		height: number
		statusBarHeight: number
		opacity: number
		windowWidth: number
		windowHeight: number
	}

	const navReadyInfo = ref<NavigationBarDemoInfo | null>(null)

	const navFixedInfo = ref<NavigationBarDemoInfo | null>(null)

	const navActionText = ref('还没有操作')

	const navSearchKeyword = ref('')

	const navComposeKeyword = ref('')

	const navSearchText = ref('还没有确认')

	const navFadeScrollTop = ref(0)

	const navFadeOpacity = ref(0)

	const navFixedVisible = ref(false)

	const navFadeRows = [
		{ title: '采摘与烘焙', meta: '3 月 12 日' },
		{ title: '顺丰冷链', meta: '次日达' },
		{ title: '冲泡建议', meta: '85°C / 3 分钟' },
		{ title: '售后保障', meta: '7 天无理由' }
	]

	const navComposeItems = [
		{ name: '春见耙耙柑', meta: '¥39.9 / 5 斤', image: '/static/demo/card/grid-1.jpg' },
		{ name: '丹东草莓', meta: '¥59.9 / 2 盒', image: '/static/demo/card/grid-2.jpg' },
		{ name: '海南小台芒', meta: '¥29.9 / 3 斤', image: '/static/demo/card/grid-3.jpg' },
		{ name: '赣南脐橙', meta: '¥45.9 / 5 斤', image: '/static/demo/card/grid-4.jpg' }
	]

	const navInfoText = (info: NavigationBarDemoInfo | null): string => {
		if (info == null) return '等待 ready'
		return `${Math.round(info.width)} × ${Math.round(info.height)} · 状态栏 ${Math.round(info.statusBarHeight)}`
	}

	const navReadyText = computed((): string => {
		return navInfoText(navReadyInfo.value)
	})

	const navFixedReadyText = computed((): string => {
		return navInfoText(navFixedInfo.value)
	})

	const navFadeOpacityText = computed((): string => {
		return navFadeOpacity.value.toFixed(2)
	})

	// 背景够实之后标题和图标才换深色；透明度由 change 回传。
	const navFadeColor = computed((): string => {
		return navFadeOpacity.value > 0.6 ? 'var(--vx-color-text)' : '#ffffff'
	})

	const onNavReady = (info: NavigationBarDemoInfo) => {
		navReadyInfo.value = info
	}

	const onNavFixedReady = (info: NavigationBarDemoInfo) => {
		navFixedInfo.value = info
	}

	const onNavBack = () => {
		navActionText.value = 'back · 返回由页面处理'
	}

	const onNavAction = (label: string) => {
		navActionText.value = `click · ${label}`
	}

	const onNavSearch = (value: string) => {
		navSearchText.value = value.length > 0 ? `搜索「${value}」` : '关键词为空'
	}

	const onNavFadeScroll = (event: UniScrollEvent) => {
		navFadeScrollTop.value = event.detail.scrollTop
	}

	const onNavFadeChange = (opacity: number) => {
		navFadeOpacity.value = opacity
	}

	const onNavFixedBack = () => {
		navFixedVisible.value = false
		navActionText.value = 'back · 已关闭固定导航栏'
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/sticky/sticky'
	const nextPath: string = '/pages/demo/status-bar/status-bar'
	const prevName = '吸顶容器'
	const nextName = '状态栏'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>
