									</view>
								</template>
							</vx-navigation-bar>
							<view class="demo-nav-body">
								<text class="demo-nav-body__title">订单 20261026001</text>
								<text class="demo-nav-body__text">已付款，商家正在备货。</text>
								<view class="demo-nav-body__line"></view>
								<view class="demo-nav-body__line demo-nav-body__line--short"></view>
							</view>
						</view>
						<view class="demo-tabs-status">
							<text class="demo-tabs-status__label">ready</text>
							<text class="demo-tabs-status__text">{{ navReadyText }}</text>
						</view>
						<view class="demo-tabs-status">
							<text class="demo-tabs-status__label">click</text>
							<text class="demo-tabs-status__text">{{ navActionText }}</text>
						</view>
						<text class="demo-hint">示例用 fixed=false 放进画布；页面根节点固定时默认占位。组件只抛 back，跳转留在业务。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">02</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">沉浸式与非沉浸式</text>
							<text class="demo-section__desc">状态栏高度由页面决定；真机打开 statusBar，组件自己留白。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-nav-status">
							<view class="demo-nav-status__item">
								<text class="demo-nav-status__label">沉浸式 · 状态栏算在导航栏里</text>
								<view class="demo-nav-strip">
									<view class="demo-nav-fake-status">
										<text class="demo-nav-fake-status__time">9:41</text>
										<view class="demo-nav-fake-status__marks">
											<view class="demo-nav-fake-status__dot"></view>
											<view class="demo-nav-fake-status__dot"></view>
											<view class="demo-nav-fake-status__dot demo-nav-fake-status__dot--bar"></view>
										</view>
									</view>
									<vx-navigation-bar :fixed="false" :status-bar="false" title="沉浸式"
										back />
								</view>
							</view>
							<view class="demo-nav-status__item demo-nav-status__item--last">
								<text class="demo-nav-status__label">非沉浸式 · 导航栏从内容顶部开始</text>
								<view class="demo-nav-strip">
									<vx-navigation-bar :fixed="false" :status-bar="false" title="非沉浸式"
										back />
								</view>
							</view>
						</view>
						<text class="demo-hint">画布上排多出的 24 是模拟状态栏；真机用 statusBar 让出 --uni-safe-area-inset-top。嵌在原生导航下面时关掉。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">透明与渐变</text>
							<text class="demo-section__desc">transparent 只保留内容；bgColor 接受颜色或渐变。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-nav-art">
							<vx-navigation-bar :fixed="false" :status-bar="false" transparent title="城市漫游"
								back color="#ffffff">
								<template #suffix>
									<view class="demo-nav-action" hover-class="demo-nav-action--pressed"
										:hover-stay-time="120" @click="onNavAction('分享')">
										<vx-icon name="share" size="lg" color="#ffffff" />
									</view>
								</template>
							</vx-navigation-bar>
							<view class="demo-nav-art__body">
								<text class="demo-nav-art__title">把导航栏交给头图</text>
								<text class="demo-nav-art__text">背景和分割线都不画，正文仍保持不透明。</text>
							</view>
						</view>
						<view class="demo-nav-strips">
							<view class="demo-nav-strip-item">
								<vx-navigation-bar :fixed="false" :status-bar="false" title="品牌底色" back
									color="#ffffff" bg-color="#d92d20" />
							</view>
							<view class="demo-nav-strip-item demo-nav-strip-item--last">
								<vx-navigation-bar :fixed="false" :status-bar="false" title="渐变背景" back
									color="#ffffff" bg-color="linear-gradient(90deg, #f79009, #e11d48)" />
							</view>
						</view>
						<text class="demo-hint">自定义底色是字面值，不跟随主题；标题、返回和插槽图标要一起改成白色，对比度由业务保证。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">04</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">滚动渐显</text>
							<text class="demo-section__desc">fade 让背景从 0 增到 maxOpacity，change 回传透明度。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-nav-fade">
							<view class="demo-nav-fade__bar">
								<vx-navigation-bar :fixed="false" :status-bar="false" fade
									:scroll-top="navFadeScrollTop" :color="navFadeColor" title="商品详情" back
									divider @change="onNavFadeChange">
									<template #suffix>
										<view class="demo-nav-action" hover-class="demo-nav-action--pressed"
											:hover-stay-time="120" @click="onNavAction('收藏')">
											<vx-icon name="heart" size="lg" :color="navFadeColor" />
										</view>
									</template>
								</vx-navigation-bar>
							</view>
							<scroll-view class="demo-nav-fade__scroll" direction="vertical"
								@scroll="onNavFadeScroll">
								<view class="demo-nav-fade__hero">
									<text class="demo-nav-fade__hero-eyebrow">VAPORIX TEA</text>
									<text class="demo-nav-fade__hero-title">明前新茶</text>
									<text class="demo-nav-fade__hero-text">早春采摘 · 当日发货</text>
								</view>
								<view class="demo-nav-fade__body">
									<view v-for="row in navFadeRows" :key="row.title"
										class="demo-nav-fade__row">
										<text class="demo-nav-fade__row-title">{{ row.title }}</text>
										<text class="demo-nav-fade__row-meta">{{ row.meta }}</text>
									</view>
								</view>
							</scroll-view>
						</view>
						<view class="demo-tabs-status">
							<text class="demo-tabs-status__label">opacity</text>
							<text class="demo-tabs-status__text">{{ navFadeOpacityText }}</text>
						</view>
						<text class="demo-hint">标题和图标在 change 过 0.6 后换深色；分割线到 0.85 才出现。背景变化只作用于背景层。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">05</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">分割线与阴影</text>
							<text class="demo-section__desc">divider 画线，shadow 用 --vx-shadow-md 并代替线。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-nav-shadow">
							<view class="demo-nav-shadow__item">
								<text class="demo-nav-shadow__label">divider</text>
								<view class="demo-nav-shadow__panel">
									<view class="demo-nav-shadow__bar">
										<vx-navigation-bar :fixed="false" :status-bar="false" title="分割线"
											back divider />
									</view>
									<view class="demo-nav-shadow__body">
										<text class="demo-nav-shadow__text">1px border，通栏，不抢正文。</text>
									</view>
								</view>
							</view>
							<view class="demo-nav-shadow__item demo-nav-shadow__item--last">
								<text class="demo-nav-shadow__label">shadow</text>
								<view class="demo-nav-shadow__panel">
									<view class="demo-nav-shadow__bar">
										<vx-navigation-bar :fixed="false" :status-bar="false" title="阴影"
											back shadow />
									</view>
									<view class="demo-nav-shadow__body">
										<text class="demo-nav-shadow__text">--vx-shadow-md，透明底上不出现。</text>
									</view>
								</view>
							</view>
						</view>
						<text class="demo-hint">分割线和阴影只在背景透明度到 0.85 以上时出现；两者同时打开时以 shadow 为准。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">06</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">插槽与搜索</text>
							<text class="demo-section__desc">prefix 换头像，suffix 放通知，extra 再排一行搜索。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-nav-device">
							<vx-navigation-bar :fixed="false" :status-bar="false" title="消息">
								<template #prefix>
									<view class="demo-nav-avatar">
										<image class="demo-nav-avatar__image"
											src="/static/demo/card/avatar-cs.png" mode="aspectFill" />
									</view>
