<template>
	<view :class="pageClass">
		<demo-topbar title="标签栏" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="tabbar" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="标签栏基础" desc="四个页签等宽排列，选中项换文字色和字重。" />
					<view class="demo-card">
						<vx-tabbar v-model="basicActive" :items="basicEntries" :fixed="false" :safe-area="false" @change="onBasicChange"
							@click="onBasicClick" />
						<view class="demo-tabbar-status">
							<view class="demo-tabbar-status__cell">
								<text class="demo-tabbar-status__label">click</text>
								<text class="demo-tabbar-status__text">{{ basicClickText }}</text>
							</view>
							<view class="demo-tabbar-status__cell demo-tabbar-status__cell--last">
								<text class="demo-tabbar-status__label">change</text>
								<text class="demo-tabbar-status__text">{{ basicChangeText }}</text>
							</view>
						</view>
						<text class="demo-hint demo-tabbar-hint">点击当前项不抛 change，只抛 click；tabbar 放在页面末尾，fixed=false 时留在文档流里。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="字体图标与图片图标" desc="字体图标跟随选中色，选中可转实心；图片成对传 activeImage，亮暗各一套。" />
					<view class="demo-card">
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">字体图标 · regular</text>
							<vx-tabbar v-model="iconFontActive" :items="iconFontEntries" :fixed="false" :safe-area="false" />
						</view>
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">字体图标 · 选中 fill</text>
							<vx-tabbar v-model="fillIconActive" :items="fillIconEntries" :fixed="false" :safe-area="false"
								active-icon-variant="fill" />
						</view>
						<view class="demo-tabbar-group demo-tabbar-group--last">
							<text class="demo-tabbar-label">图片图标 · 亮暗两套</text>
							<vx-tabbar v-model="imageActive" :items="imageEntries" :fixed="false" :safe-area="false" />
						</view>
						<text class="demo-hint demo-tabbar-hint">图片优先于字体图标；图片不能改色，选中态靠 activeImage。activeIcon 的 fill 字重用 activeIconVariant。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="凸起主按钮" desc="中间项凸起成圆钮，用 action 只做按钮、不参与选中。" />
					<view class="demo-card">
						<vx-tabbar v-model="raisedActive" :items="raisedEntries" :fixed="false" :safe-area="false" @click="onRaisedClick" />
						<view class="demo-tabbar-status">
							<view class="demo-tabbar-status__cell demo-tabbar-status__cell--last">
								<text class="demo-tabbar-status__label">click</text>
								<text class="demo-tabbar-status__text">{{ raisedClickText }}</text>
							</view>
						</view>
						<text class="demo-hint demo-tabbar-hint">一个标签栏最多一个凸起项；只有圆钮能点，透明带上的点击落到页面。action 项不写 v-model。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="角标与圆点" desc="计数超过 badgeMax 显示 max+，dot 优先于计数。" />
					<view class="demo-card">
						<vx-tabbar v-model="badgeActive" :items="badgeEntries" :fixed="false" :safe-area="false" />
						<text class="demo-hint demo-tabbar-hint">角标默认 danger，不参与布局；同一含义的计数一屏只出现一处。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="标签栏尺寸" desc="栏高 48 / 56 / 64，图标位 20 / 24 / 28，角标跟着换档。" />
					<view class="demo-card">
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">sm · 48</text>
							<vx-tabbar v-model="sizeSmActive" :items="basicEntries" :fixed="false" :safe-area="false" size="sm" />
						</view>
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">md · 56</text>
							<vx-tabbar v-model="sizeMdActive" :items="basicEntries" :fixed="false" :safe-area="false" />
						</view>
						<view class="demo-tabbar-group demo-tabbar-group--last">
							<text class="demo-tabbar-label">lg · 64</text>
							<vx-tabbar v-model="sizeLgActive" :items="basicEntries" :fixed="false" :safe-area="false" size="lg" />
						</view>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="语义色" desc="type 同时改选中文字、图标和凸起圆钮；warning 用 ink。" />
					<view class="demo-card">
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">success</text>
							<vx-tabbar v-model="typeSuccessActive" :items="basicEntries" :fixed="false" :safe-area="false"
								type="success" />
						</view>
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">warning</text>
							<vx-tabbar v-model="typeWarningActive" :items="basicEntries" :fixed="false" :safe-area="false"
								type="warning" />
						</view>
						<view class="demo-tabbar-group demo-tabbar-group--last">
							<text class="demo-tabbar-label">danger · 凸起</text>
							<vx-tabbar v-model="typeDangerActive" :items="raisedEntries" :fixed="false" :safe-area="false" type="danger" />
						</view>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="禁用" desc="单项禁用只停这一项：图标、文字和角标一起转灰。" />
					<view class="demo-card">
						<vx-tabbar v-model="disabledActive" :items="disabledEntries" :fixed="false" :safe-area="false" />
						<text class="demo-hint demo-tabbar-hint">不可用入口优先隐藏，禁用不要用来掩盖权限问题；当前项不要设成禁用。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="分割线" desc="默认 1px 分割线；放进卡片或自己带边界时关掉。" />
					<view class="demo-card">
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">divider = true</text>
							<vx-tabbar v-model="dividerOnActive" :items="basicEntries" :fixed="false" :safe-area="false" />
						</view>
						<view class="demo-tabbar-group demo-tabbar-group--last">
							<text class="demo-tabbar-label">divider = false</text>
							<vx-tabbar v-model="dividerOffActive" :items="basicEntries" :fixed="false" :safe-area="false"
								:divider="false" />
						</view>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="液态玻璃" desc="不传 liquidGlass 时跟随『我的』页的全局控件风格；显式传 true 强制玻璃（全局关闭时也生效）。玻璃档 iOS 26+ 是系统液态玻璃材质，Android / 鸿蒙 / Web 磨砂，小程序半透明底，选中项用浅色胶囊滑过去。" />
					<view class="demo-card">
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">primary · 跟随全局</text>
							<vx-tabbar v-model="glassActive" :items="glassEntries" :fixed="false" :safe-area="false" />
						</view>
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">danger · 显式开启</text>
							<vx-tabbar v-model="glassAltActive" :items="glassAltEntries" :fixed="false" :safe-area="false"
								liquid-glass type="danger" />
						</view>
						<view class="demo-tabbar-group demo-tabbar-group--last">
							<text class="demo-tabbar-label">clear · 透档</text>
							<vx-tabbar v-model="glassClearActive" :items="glassEntries" :fixed="false" :safe-area="false"
								liquid-glass glass-style="clear" />
						</view>
						<text class="demo-hint demo-tabbar-hint">示例一不传 liquidGlass，跟随全局开关；示例二显式传 true，全局关闭时也强制玻璃。iOS 用 glass-effect-view 出系统液态玻璃并跟随系统外观，glassStyle=clear 换更透的系统材质；Android / 鸿蒙 / Web 磨砂，小程序半透明底。玻璃底不接 bgColor。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="自定义颜色" desc="bgColor 改整条底色，color 改未选中文字和字体图标。" />
					<view class="demo-card">
						<view class="demo-tabbar-group">
							<text class="demo-tabbar-label">bgColor = primary-soft</text>
							<vx-tabbar v-model="customActive" :items="basicEntries" :fixed="false" :safe-area="false"
								bg-color="var(--vx-color-primary-soft)" />
						</view>
						<view class="demo-tabbar-group demo-tabbar-group--last">
							<text class="demo-tabbar-label">bgColor = transparent</text>
							<vx-tabbar v-model="plainActive" :items="basicEntries" :fixed="false" :safe-area="false"
								bg-color="transparent" />
						</view>
						<text class="demo-hint demo-tabbar-hint">字面值不跟随主题；传 var(--vx-color-*) 时才会亮暗各用各的。图片不受 color 影响。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="固定与安全区" desc="打开固定后贴住屏幕底部，栏底色铺到安全区，页面内容自动让位。" />
					<view class="demo-card">
						<view class="demo-tabbar-actions">
							<view class="demo-tabbar-actions__button">
								<vx-button :text="fixedVisible ? '收起固定标签栏' : '显示固定标签栏'" type="primary"
									variant="soft" size="sm" @click="toggleFixed" />
							</view>
							<text class="demo-tabbar-actions__state">{{ fixedVisible ? 'fixed = true' : 'fixed = false' }}</text>
						</view>
						<text class="demo-hint demo-tabbar-hint">固定时默认补一个等高占位（placeholder），放在页面末尾才不会被盖住；safeArea 把底部手势条让出来。真机上安全区由系统变量给出，Web 为 0。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="标签栏与内容" desc="标签栏只切视图，内容按索引换；外框交给画布或页面。" />
					<view class="demo-card demo-tabbar-stage-card">
						<view class="demo-tabbar-screen">
							<view class="demo-tabbar-screen__head">
								<text class="demo-tabbar-screen__eyebrow">元汽UI</text>
								<text class="demo-tabbar-screen__title">{{ composePanel.title }}</text>
							</view>
							<view class="demo-tabbar-screen__body">
								<text class="demo-tabbar-screen__copy">{{ composePanel.body }}</text>
								<view class="demo-tabbar-screen__row">
									<text class="demo-tabbar-screen__row-title">推荐内容</text>
									<text class="demo-tabbar-screen__row-value">{{ composePanel.value }}</text>
								</view>
								<view class="demo-tabbar-screen__row demo-tabbar-screen__row--last">
									<text class="demo-tabbar-screen__row-title">今日更新</text>
									<text class="demo-tabbar-screen__row-value">12 条</text>
								</view>
							</view>
							<vx-tabbar v-model="composeActive" :items="composeEntries" :fixed="false" :safe-area="false" />
						</view>
						<text class="demo-hint demo-tabbar-hint">画布里用 fixed=false，真实页面打开 fixed 就能贴底；放进卡片或画布时关掉 safeArea，避免多出一截。</text>
					</view>
				</view>

				<demo-page-nav current-key="tabbar" />

				<demo-footer />
			</view>
		</scroll-view>

		<!-- 固定演示：放在页面根节点的末尾。玻璃风格时占位关掉，滚动内容从玻璃栏和底部透明段穿过；
		     内容末尾由 demo-footer 自带的留白兜底，末尾条目不会被栏压住。 -->
		<vx-tabbar v-if="fixedVisible" v-model="fixedActive" :items="fixedEntries" liquid-glass :placeholder="false" />
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 标签栏演示：图标、角标、凸起和内容组合各用一份数据，切换尺寸和颜色时文字不变。
	type TabbarDemoItem = {
		text: string
		icon?: string
		activeIcon?: string
		image?: string
		activeImage?: string
		badge?: number
		dot?: boolean
		disabled?: boolean
		raised?: boolean
		action?: boolean
	}

	type TabbarDemoPanel = {
		title: string
		body: string
		value: string
	}

	const basicEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '分类', icon: 'grid-2x2' },
		{ text: '消息', icon: 'bell' },
		{ text: '我的', icon: 'user' }
	]

	const iconFontEntries: TabbarDemoItem[] = [
		{ text: '代码', icon: 'code' },
		{ text: '复制', icon: 'copy' },
		{ text: '指南', icon: 'compass' }
	]

	const fillIconEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '收藏', icon: 'heart' },
		{ text: '我的', icon: 'user' }
	]

	const raisedEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '发布', icon: 'plus', raised: true, action: true },
		{ text: '我的', icon: 'user' }
	]

	const badgeEntries: TabbarDemoItem[] = [
		{ text: '消息', icon: 'bell', badge: 1 },
		{ text: '通知', icon: 'mail', dot: true },
		{ text: '收藏', icon: 'heart', badge: 128 },
		{ text: '我的', icon: 'user' }
	]

	const disabledEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '会员', icon: 'star', disabled: true },
		{ text: '我的', icon: 'user' }
	]

	const glassEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '分类', icon: 'grid-2x2' },
		{ text: '消息', icon: 'bell' },
		{ text: '会员', icon: 'star' },
		{ text: '我的', icon: 'user' }
	]

	const glassAltEntries: TabbarDemoItem[] = [
		{ text: '代码', icon: 'code' },
		{ text: '复制', icon: 'copy' },
		{ text: '指南', icon: 'compass' }
	]

	const composeEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '分类', icon: 'grid-2x2' },
		{ text: '消息', icon: 'bell', badge: 2 },
		{ text: '我的', icon: 'user' }
	]

	const fixedEntries: TabbarDemoItem[] = [
		{ text: '首页', icon: 'home' },
		{ text: '分类', icon: 'grid-2x2' },
		{ text: '消息', icon: 'bell' },
		{ text: '我的', icon: 'user' }
	]

	const composePanels: TabbarDemoPanel[] = [
		{ title: '发现好物', body: '按你的浏览记录挑了 12 件，挑一件今天就能发出。', value: '12 件' },
		{ title: '全部分类', body: '数码、家居、服饰和食品，四个大类都能从这里进。', value: '4 类' },
		{ title: '消息中心', body: '2 条未读，订单状态和售后进度都会推到这里。', value: '2 条未读' },
		{ title: '我的账户', body: '订单、收藏和优惠券都在这一页，登录后可同步。', value: '已登录' }
	]

	const basicActive = ref(0)
	const iconFontActive = ref(0)
	const fillIconActive = ref(0)
	const imageActive = ref(0)
	const raisedActive = ref(0)
	const badgeActive = ref(0)
	const sizeSmActive = ref(0)
	const sizeMdActive = ref(1)
	const sizeLgActive = ref(2)
	const typeSuccessActive = ref(0)
	const typeWarningActive = ref(1)
	const typeDangerActive = ref(0)
	const disabledActive = ref(0)
	const dividerOnActive = ref(1)
	const dividerOffActive = ref(1)
	const glassActive = ref(0)
	const glassAltActive = ref(1)
	const glassClearActive = ref(0)
	const customActive = ref(0)
	const plainActive = ref(0)
	const fixedActive = ref(0)
	const composeActive = ref(0)
	const fixedVisible = ref(false)

	const basicClickText = ref('还没有点击')
	const basicChangeText = ref('还没有切换')
	const raisedClickText = ref('点一下中间的圆钮')

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	// 原生 tabBar 的图标有亮暗两套，自定义标签栏沿用同一批素材。
	const imageEntries = computed((): TabbarDemoItem[] => {
		const suffix = isDark.value ? '-dark' : ''
		return [
			{
				text: '组件',
				image: `/static/tabbar/components${suffix}.png`,
				activeImage: `/static/tabbar/components-active${suffix}.png`
			},
			{
				text: '接口',
				image: `/static/tabbar/api${suffix}.png`,
				activeImage: `/static/tabbar/api-active${suffix}.png`
			},
			{
				text: '我的',
				image: `/static/tabbar/mine${suffix}.png`,
				activeImage: `/static/tabbar/mine-active${suffix}.png`
			}
		]
	})

	const composePanel = computed((): TabbarDemoPanel => {
		const panel = composePanels[composeActive.value]
		return panel != null ? panel : composePanels[0]
	})

	const onBasicClick = (index: number) => {
		basicClickText.value = `第 ${index + 1} 项`
	}

	const onBasicChange = (index: number) => {
		basicChangeText.value = `第 ${index + 1} 项`
	}

	// 凸起项是 action，点击只抛 click；这里按索引看是圆钮还是两侧页签。
	const onRaisedClick = (index: number) => {
		if (index === 1) {
			raisedClickText.value = '点击了发布圆钮'
			return
		}
		raisedClickText.value = index === 0 ? '点击了首页' : '点击了我的'
	}

	const toggleFixed = () => {
		fixedVisible.value = !fixedVisible.value
	}


	onShow(() => {
		syncDemoTheme()
	})
</script>
