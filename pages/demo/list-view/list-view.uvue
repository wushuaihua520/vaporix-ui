</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	// 列表演示：多个分组共用一个「最近点击」，用来对照 click 和静态 / 禁用行。
	const listLastAction = ref('还没有点击')

	const onListAction = (label: string) => {
		listLastAction.value = label
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/bubble-popup/bubble-popup'
	const nextPath: string = '/pages/demo/card/card'
	const prevName = '气泡弹框'
	const nextName = '卡片'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
	/* 同一节里两组标题，隔开 24，方便对左缘。 */
	.demo-list-size-gap {
		margin-top: var(--vx-space-xl);
	}
</style>
