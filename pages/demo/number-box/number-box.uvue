<template>
	<view :class="pageClass">
		<demo-topbar title="数字框" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="number-box" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="基本用法" desc="v-model 绑定数值，中间可以直接输入。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">基本用法</text>
							<vx-number-box v-model="numberBoxBasic" @change="onNumberBoxChange" />
						</view>
						<text class="demo-hint demo-number-box-hint">当前值：{{ numberBoxBasic }} · change 最近一次：{{ numberBoxLastChange }}</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="设置最小值和最大值" desc="到边界后对应按钮转灰，另一个方向仍然可用。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">1–10</text>
							<vx-number-box v-model="numberBoxRange" :min="1" :max="10" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">0–100 · soft</text>
							<vx-number-box v-model="numberBoxWideRange" :min="0" :max="100" variant="soft" />
						</view>
						<text class="demo-hint demo-number-box-hint">当前：{{ numberBoxRange }} / {{ numberBoxWideRange }}。输入越界值，失焦后夹回区间。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="设置步长" desc="step 只决定加减量，小数按参与运算的精度收口。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">步长 0.1</text>
							<vx-number-box v-model="numberBoxStepSmall" :min="0" :max="10" :step="0.1" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">步长 10 · soft</text>
							<vx-number-box v-model="numberBoxStepLarge" :min="0" :max="100" :step="10"
								variant="soft" />
						</view>
						<text class="demo-hint demo-number-box-hint">当前：{{ numberBoxStepSmall }} / {{ numberBoxStepLarge }}。0.1 连加不会出现浮点尾巴。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="设置大小" desc="三档高度 32 / 40 / 48，数值区宽度和图标同步。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">sm · 32</text>
							<vx-number-box v-model="numberBoxSizeSm" size="sm" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">md · 40</text>
							<vx-number-box v-model="numberBoxSizeMd" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">lg · 48</text>
							<vx-number-box v-model="numberBoxSizeLg" size="lg" />
						</view>
						<text class="demo-hint demo-number-box-hint">sm 用于密集行，独立表单优先 lg；按钮宽度等于控件高度。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="调整样式" desc="outline 给表单，soft 给列表行；shape 控制整组轮廓。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">描边 · rounded</text>
							<vx-number-box v-model="numberBoxOutline" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">浅底 · rounded</text>
							<vx-number-box v-model="numberBoxSoft" variant="soft" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">描边 · pill</text>
							<vx-number-box v-model="numberBoxPill" shape="pill" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">浅底 · square</text>
							<vx-number-box v-model="numberBoxSquare" variant="soft" shape="square" />
						</view>
						<text class="demo-hint demo-number-box-hint">形态不改变结构、尺寸和按钮位置；同一屏圆角不超过两档。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="状态" desc="invalid 只改描边；disabled 同时停下输入和加减。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">校验失败</text>
							<vx-number-box v-model="numberBoxInvalid" invalid />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">禁用 · soft</text>
							<vx-number-box v-model="numberBoxDisabled" disabled variant="soft" />
						</view>
						<text class="demo-hint demo-number-box-hint">禁用不抛 change，也不响应输入和按钮；错误说明放在组件外。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="调整颜色" desc="bgColor / color / iconColor 分别覆盖底色、数值和图标。" />
					<view class="demo-card">
						<view class="demo-number-box-row">
							<text class="demo-number-box-label">暖色底</text>
							<vx-number-box v-model="numberBoxWarm" variant="soft" bg-color="#fff5e5" color="#8a4b00"
								icon-color="#8a4b00" />
						</view>
						<view class="demo-number-box-row demo-number-box-row--spaced">
							<text class="demo-number-box-label">品牌蓝</text>
							<vx-number-box v-model="numberBoxCool" variant="soft" bg-color="#eef3ff" color="#245cc2"
								icon-color="#245cc2" />
						</view>
						<text class="demo-hint demo-number-box-hint">自定义颜色是字面值，不跟随主题；禁用时都不生效，对比度由业务保证。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="组合与取值" desc="放进购物车行，组件只把数值交给业务计算。" />
					<view class="demo-card">
						<view class="demo-number-box-product">
							<view class="demo-number-box-product__copy">
								<text class="demo-number-box-label">Vaporix 帆布包</text>
								<text class="demo-number-box-meta">¥129 / 件 · 最多 9 件</text>
							</view>
							<vx-number-box v-model="numberBoxCartBag" variant="soft" :min="1" :max="9" />
						</view>
						<view class="demo-number-box-product demo-number-box-product--spaced">
							<view class="demo-number-box-product__copy">
								<text class="demo-number-box-label">元汽UI 贴纸</text>
								<text class="demo-number-box-meta">¥29 / 件 · 最多 20 件</text>
							</view>
							<vx-number-box v-model="numberBoxCartSticker" variant="soft" :min="1" :max="20" />
						</view>
						<view class="demo-number-box-total">
							<text class="demo-number-box-label">合计</text>
							<text class="demo-number-box-total__value">¥{{ numberBoxCartTotal }}</text>
						</view>
						<text class="demo-hint demo-number-box-hint">数字框的点击停在自己身上；金额、库存和提交入口都放在业务里。</text>
					</view>
				</view>

				<demo-page-nav current-key="number-box" />

				<demo-footer />
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 数字框演示：每组独立一份值，改一档不牵动另一档。
	const numberBoxBasic = ref(1)

	const numberBoxLastChange = ref(1)

	const numberBoxRange = ref(5)

	const numberBoxWideRange = ref(50)

	const numberBoxStepSmall = ref(1)

	const numberBoxStepLarge = ref(10)

	const numberBoxSizeSm = ref(1)

	const numberBoxSizeMd = ref(2)

	const numberBoxSizeLg = ref(3)

	const numberBoxOutline = ref(1)

	const numberBoxSoft = ref(2)

	const numberBoxPill = ref(3)

	const numberBoxSquare = ref(4)

	const numberBoxInvalid = ref(1)

	const numberBoxDisabled = ref(3)

	const numberBoxWarm = ref(2)

	const numberBoxCool = ref(1)

	const numberBoxCartBag = ref(1)

	const numberBoxCartSticker = ref(2)

	const numberBoxCartTotal = computed((): string => {
		return (numberBoxCartBag.value * 129 + numberBoxCartSticker.value * 29).toFixed(2)
	})

	const onNumberBoxChange = (value: number) => {
		numberBoxLastChange.value = value
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>
