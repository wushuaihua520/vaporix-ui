		justify-content: space-between;
		padding-top: var(--vx-space-sm);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-sm);
		padding-left: var(--vx-space-md);
		border-bottom-width: var(--vx-border-width);
		border-bottom-style: solid;
		border-bottom-color: var(--vx-color-divider);
		background-color: var(--vx-color-surface);
	}

	.demo-safe-nav__title {
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
	}

	.demo-safe-height {
		margin-bottom: var(--vx-space-lg);
	}

	.demo-safe-height--last {
		margin-bottom: 0;
	}

	.demo-safe-height__head {
		flex-direction: row;
