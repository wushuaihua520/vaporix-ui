						</view>
						<view class="demo-size-row demo-size-row--last">
							<view class="demo-size-row__key">
								<text class="demo-size-row__name">lg</text>
								<text class="demo-size-row__meta">36</text>
							</view>
							<view class="demo-size-row__control">
								<view class="demo-tag-wall demo-tag-wall--flush">
									<view class="demo-tag-wall__item demo-tag-wall__item--line">
										<vx-tag size="lg" type="primary" text="主色" />
									</view>
									<view class="demo-tag-wall__item demo-tag-wall__item--line">
										<vx-tag size="lg" type="success" variant="soft" text="浅底" />
									</view>
									<view class="demo-tag-wall__item demo-tag-wall__item--line">
										<vx-tag size="lg" type="warning" variant="plain" text="空心" />
									</view>
									<view class="demo-tag-wall__item demo-tag-wall__item--line">
										<vx-tag size="lg" type="default" text="中性" />
									</view>
								</view>
							</view>
						</view>
						<text class="demo-hint">字号同时跟档位走：12 / 13 / 14。</text>
					</view>
