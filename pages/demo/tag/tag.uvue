	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	// 演示页不引用组件库的类型：script setup 里只有 defineProps 用到的类型会被擦除，
	// 普通 type 导入会留在运行时代码里，页面加载时报 missing export。
	type TagSemantic = 'primary' | 'success' | 'info' | 'warning' | 'danger' | 'default'

	type TagVariant = 'solid' | 'soft' | 'plain'

	type TagTone = {
		type: TagSemantic
		label: string
	}

	type RemovableTag = {
		id: string
		label: string
		type: TagSemantic
		variant: TagVariant
	}

	const tagTones: TagTone[] = [
		{ type: 'primary', label: '主色' },
		{ type: 'success', label: '成功' },
		{ type: 'info', label: '信息' },
		{ type: 'warning', label: '警告' },
		{ type: 'danger', label: '危险' },
		{ type: 'default', label: '中性' }
	]

	const initialRemovableTags = (): RemovableTag[] => {
		return [
			{ id: 'inbox', label: '未读消息', type: 'primary', variant: 'solid' },
			{ id: 'paid', label: '已支付', type: 'success', variant: 'soft' },
			{ id: 'limit', label: '额度不足', type: 'danger', variant: 'plain' }
		]
	}

	const removableTags = ref<RemovableTag[]>(initialRemovableTags())

	const onRemoveTag = (id: string) => {
		removableTags.value = removableTags.value.filter((item: RemovableTag): boolean => item.id !== id)
	}

	const resetRemovableTags = () => {
		removableTags.value = initialRemovableTags()
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/icon/icon'
	const nextPath: string = '/pages/demo/badge/badge'
	const prevName = '图标'
	const nextName = '徽章'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>
