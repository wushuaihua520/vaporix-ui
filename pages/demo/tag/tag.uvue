				<view class="demo-section">
					<demo-section-head title="轮廓" desc="圆角、胶囊、半圆角、平角。" />
					<view class="demo-card">
						<view class="demo-tag-wall">
							<view class="demo-tag-wall__item">
								<vx-tag text="默认圆角" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" text="胶囊" shape="pill" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" text="半圆角" shape="half" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" text="平角" shape="square" />
							</view>
						</view>
						<view class="demo-tag-wall">
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" variant="plain" text="空心圆角" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" variant="plain" text="空心胶囊" shape="pill" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" variant="plain" text="空心半圆角" shape="half" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" variant="plain" text="空心平角" shape="square" />
							</view>
						</view>
						<text class="demo-hint">半圆角是左边胶囊、右边平角，适合贴边排列。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="自定义颜色" desc="三个颜色各管一处，不做明暗推导。" />
					<view class="demo-card">
						<view class="demo-tag-wall">
							<view class="demo-tag-wall__item">
								<vx-tag text="自定义实心" bg-color="#2ba471" border-color="#2ba471" color="#ffffff" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag type="primary" text="自定义空心" variant="plain" color="#2ba471" border-color="#2ba471" />
							</view>
							<view class="demo-tag-wall__item">
								<vx-tag text="自定义浅底" variant="soft" bg-color="#e6f4ec" border-color="#e6f4ec" color="#1f6b4a" />
							</view>
						</view>
						<text class="demo-hint">没传的颜色继续跟 type，对比度由业务保证。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="可关闭" desc="点 × 抛 close，标签由业务移除。" />
					<view class="demo-card">
						<view class="demo-tag-wall">
							<view v-for="item in removableTags" :key="item.id" class="demo-tag-wall__item">
								<vx-tag :type="item.type" :variant="item.variant" :text="item.label" closable
									@close="onRemoveTag(item.id)" />
							</view>
						</view>
						<text class="demo-hint">还剩 {{ removableTags.length }} 个。</text>
						<view class="demo-tag-reset">
							<vx-button size="sm" type="default" text="恢复标签" @click="resetRemovableTags" />
						</view>
					</view>
				</view>

				<demo-page-nav current-key="tag" />

				<demo-footer />


			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 演示页不引用组件库的类型：script setup 里只有 defineProps 用到的类型会被擦除，
	// 普通 type 导入会留在运行时代码里，页面加载时报 missing export。
	type TagSemantic = 'primary' | 'success' | 'info' | 'warning' | 'danger' | 'default'

	type TagVariant = 'solid' | 'soft' | 'plain'

	type TagTone = {
		type: TagSemantic
		label: string
	}

	type RemovableTag = {
		id: string
		label: string
		type: TagSemantic
		variant: TagVariant
	}

	const tagTones: TagTone[] = [
		{ type: 'primary', label: '主色' },
		{ type: 'success', label: '成功' },
		{ type: 'info', label: '信息' },
		{ type: 'warning', label: '警告' },
		{ type: 'danger', label: '危险' },
		{ type: 'default', label: '中性' }
	]

	const initialRemovableTags = (): RemovableTag[] => {
		return [
			{ id: 'inbox', label: '未读消息', type: 'primary', variant: 'solid' },
			{ id: 'paid', label: '已支付', type: 'success', variant: 'soft' },
			{ id: 'limit', label: '额度不足', type: 'danger', variant: 'plain' }
		]
	}

	const removableTags = ref<RemovableTag[]>(initialRemovableTags())

	const onRemoveTag = (id: string) => {
		removableTags.value = removableTags.value.filter((item: RemovableTag): boolean => item.id !== id)
	}

	const resetRemovableTags = () => {
		removableTags.value = initialRemovableTags()
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>
