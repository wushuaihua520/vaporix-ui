<template>
	<view :class="pageClass">
		<!-- 吸顶线要贴到顶栏下沿：offsetTop 直接用导航栏内容行高（--vx-navigation-bar-height = 48，
		     与 vx-page 插槽 navHeight 同源），滚动值走 scroll-view 的 @scroll 自己取整。 -->
		<demo-topbar title="吸顶容器" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical" @scroll="onContentScroll">
			<demo-hero current-key="sticky" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="吸顶基础" desc="吸顶条贴到顶栏下沿后停住，suffix 里的内容滚完再复位。" />
					<view class="demo-sticky-card">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight"
							@change="onStickyBasicChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">商品详情</text>
									<text class="demo-sticky-bar__meta">共 12 条</text>
								</view>
								<vx-tag size="sm" :type="stickyBasicStuck ? 'success' : 'default'"
									:variant="stickyBasicStuck ? 'soft' : 'plain'"
									:text="stickyBasicStuck ? '已吸顶' : '未吸顶'" />
							</view>
							<template #suffix>
								<view class="demo-sticky-rows">
									<vx-list-cell v-for="(row, index) in stickyDetailRows" :key="row.title"
										:title="row.title" :value="row.value" :clickable="false"
										:divider="index < stickyDetailRows.length - 1" />
								</view>
							</template>
						</vx-sticky>
					</view>
					<text class="demo-hint">吸顶条在文档流里保持透明，贴到顶部后才铺 surface 底、加 1px 分割线；不传 suffix 时会一直吸到页面末尾。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="吸顶距离" desc="在安全区之外再让出 56px，吸顶位置比上一组更低，用阴影和下面的内容分开。" />
					<view class="demo-sticky-card">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="56" shadow
							@change="onStickyOffsetChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">吸顶距离 56</text>
									<text class="demo-sticky-bar__meta">距安全区 56px</text>
								</view>
								<text class="demo-sticky-bar__state">{{ stickyOffsetStuck ? '吸顶中' : '未吸顶' }}</text>
							</view>
							<template #suffix>
								<view class="demo-sticky-rows">
									<vx-list-cell v-for="(row, index) in stickyOffsetRows" :key="row.title"
										:title="row.title" :value="row.value" :clickable="false"
										:divider="index < stickyOffsetRows.length - 1" />
								</view>
							</template>
						</vx-sticky>
					</view>
					<text class="demo-hint">offsetTop 是在顶部安全区之外再让出的距离，单位 px；基础组让出的是顶栏内容行（48），这一组固定让 56。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="指定范围" desc="两组各自带 suffix，上一组滚完把吸顶条顶出去，下一组接上。" />
					<view class="demo-sticky-card">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight"
							@change="onStickyRangeFirstChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">第一组</text>
									<text class="demo-sticky-bar__meta">待付款订单</text>
								</view>
								<vx-tag size="sm" :type="stickyRangeFirstStuck ? 'primary' : 'default'"
									:variant="stickyRangeFirstStuck ? 'soft' : 'plain'"
									:text="stickyRangeFirstStuck ? '吸顶中' : '未吸顶'" />
							</view>
							<template #suffix>
								<view class="demo-sticky-rows">
									<vx-list-cell v-for="(row, index) in stickyRangeFirstRows" :key="row.title"
										:title="row.title" :value="row.value" :clickable="false"
										:divider="index < stickyRangeFirstRows.length - 1" />
								</view>
							</template>
						</vx-sticky>
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight"
							@change="onStickyRangeSecondChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">第二组</text>
									<text class="demo-sticky-bar__meta">已发货订单</text>
								</view>
								<vx-tag size="sm" :type="stickyRangeSecondStuck ? 'primary' : 'default'"
									:variant="stickyRangeSecondStuck ? 'soft' : 'plain'"
									:text="stickyRangeSecondStuck ? '吸顶中' : '未吸顶'" />
							</view>
							<template #suffix>
								<view class="demo-sticky-rows">
									<vx-list-cell v-for="(row, index) in stickyRangeSecondRows" :key="row.title"
										:title="row.title" :value="row.value" :clickable="false"
										:divider="index < stickyRangeSecondRows.length - 1" />
								</view>
							</template>
						</vx-sticky>
					</view>
					<text class="demo-hint">suffix 插槽放吸顶条后面的内容；两组之间用最后一行分割线收口，容器底边往上推时吸顶条一起推出，切换不跳高度。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="阴影与底色" desc="shadow 用浮层阴影代替分割线；bgColor 不跟主题，未吸顶也生效。" />
					<view class="demo-sticky-card">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight" shadow
							@change="onStickyShadowChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">浮层阴影</text>
									<text class="demo-sticky-bar__meta">shadow</text>
								</view>
								<text class="demo-sticky-bar__state">{{ stickyShadowStuck ? '吸顶中' : '未吸顶' }}</text>
							</view>
							<template #suffix>
								<view class="demo-sticky-rows">
									<vx-list-cell v-for="(row, index) in stickyShadowRows" :key="row.title"
										:title="row.title" :value="row.value" :clickable="false"
										:divider="index < stickyShadowRows.length - 1" />
								</view>
							</template>
						</vx-sticky>
					</view>
					<view class="demo-sticky-card demo-sticky-card--gap">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight" bg-color="#2b6be0" shadow
							@change="onStickyBrandChange">
							<view :class="stickyBrandBarClass">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title demo-sticky-bar__title--brand">品牌底色</text>
									<text class="demo-sticky-bar__meta demo-sticky-bar__meta--brand">bgColor #2b6be0</text>
								</view>
								<text class="demo-sticky-bar__state demo-sticky-bar__state--brand">{{ stickyBrandStuck ? '吸顶中' : '未吸顶' }}</text>
							</view>
							<template #suffix>
								<view class="demo-sticky-rows">
									<vx-list-cell v-for="(row, index) in stickyBrandRows" :key="row.title"
										:title="row.title" :value="row.value" :clickable="false"
										:divider="index < stickyBrandRows.length - 1" />
								</view>
							</template>
						</vx-sticky>
					</view>
					<text class="demo-hint">阴影只使用 --vx-shadow-md；bgColor 是字面值，亮色、暗色都保持同一个品牌色，对比度由业务保证。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="液态玻璃" desc="吸顶后条面换玻璃：滚动的彩底从条下穿过实时折射。示例一不传 liquidGlass，跟随『我的』页的全局控件风格；示例二显式传 true，全局关闭时也强制玻璃。" />
					<view class="demo-sticky-card">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight"
							@change="onStickyGlassFollowChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">跟随全局</text>
									<text class="demo-sticky-bar__meta">不传 liquidGlass</text>
								</view>
								<text class="demo-sticky-bar__state">{{ stickyGlassFollowStuck ? '吸顶中' : '未吸顶' }}</text>
							</view>
							<template #suffix>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--red">
									<text class="demo-sticky-glass-band__text">GLASS · 红</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--orange">
									<text class="demo-sticky-glass-band__text">GLASS · 橙</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--green">
									<text class="demo-sticky-glass-band__text">GLASS · 绿</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--blue demo-sticky-glass-band--last">
									<text class="demo-sticky-glass-band__text">GLASS · 蓝</text>
								</view>
							</template>
						</vx-sticky>
					</view>
					<view class="demo-sticky-card demo-sticky-card--gap">
						<vx-sticky :scroll-top="demoScrollTop" :offset-top="navHeight" liquid-glass
							@change="onStickyGlassForceChange">
							<view class="demo-sticky-bar">
								<view class="demo-sticky-bar__main">
									<text class="demo-sticky-bar__title">显式开启</text>
									<text class="demo-sticky-bar__meta">liquid-glass</text>
								</view>
								<text class="demo-sticky-bar__state">{{ stickyGlassForceStuck ? '吸顶中' : '未吸顶' }}</text>
							</view>
							<template #suffix>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--blue">
									<text class="demo-sticky-glass-band__text">穿过 · 上</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--green">
									<text class="demo-sticky-glass-band__text">穿过 · 中</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--red">
									<text class="demo-sticky-glass-band__text">穿过 · 下</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--purple">
									<text class="demo-sticky-glass-band__text">穿过 · 紫</text>
								</view>
								<view class="demo-sticky-glass-band demo-sticky-glass-band--orange-deep demo-sticky-glass-band--last">
									<text class="demo-sticky-glass-band__text">穿过 · 琥珀</text>
								</view>
							</template>
						</vx-sticky>
					</view>
					<text class="demo-hint">把这一组滚到吸顶：玻璃条浮在彩底上，内容从条下穿过。玻璃态不画分割线也不叠 --shadow，浮起感由玻璃分层阴影接管。iOS 用 glass-effect-view 系统材质并跟随系统外观；Android / 鸿蒙 / Web 磨砂，小程序实底近似。</text>
				</view>

				<demo-page-nav current-key="sticky" />

				<demo-footer />
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 顶栏内容行高：--vx-navigation-bar-height 的值（48）。vx-sticky 的 offsetTop 从安全区
	// 之外算起，让出这一档吸顶条正好停在顶栏下沿（vx-page 插槽 navHeight 同源同值）。
	const navHeight = 48

	// scroll-view 的 @scroll 取整后喂给所有吸顶条；回弹的负值按 0 收口。
	const demoScrollTop = ref(0)

	const onContentScroll = (event: UniScrollEvent) => {
		const top = Math.max(0, Math.round(event.detail.scrollTop))
		if (demoScrollTop.value === top) return
		demoScrollTop.value = top
	}

	// 吸顶演示：suffix 里的内容决定推到哪结束，这里记每个示例的吸顶状态。
	type StickyDemoRow = {
		title: string
		value: string
	}

	const stickyDetailRows: StickyDemoRow[] = [
		{ title: '库存与价格', value: '现货' },
		{ title: '规格参数', value: '6 种' },
		{ title: '售后保障', value: '7 天无理由' },
		{ title: '配送说明', value: '包邮' },
		{ title: '常见问题', value: '12 条' },
		{ title: '用户评价', value: '4.9 分' }
	]

	const stickyOffsetRows: StickyDemoRow[] = [
		{ title: '吸顶距离', value: '56px' },
		{ title: '阴影', value: 'shadow' },
		{ title: '分割线', value: '不画' },
		{ title: '覆盖关系', value: '压住内容' }
	]

	const stickyRangeFirstRows: StickyDemoRow[] = [
		{ title: '订单 20261024001', value: '待付款' },
		{ title: '订单 20261024002', value: '待付款' },
		{ title: '订单 20261024003', value: '待付款' },
		{ title: '订单 20261024004', value: '待付款' }
	]

	const stickyRangeSecondRows: StickyDemoRow[] = [
		{ title: '订单 20261023008', value: '已发货' },
		{ title: '订单 20261023009', value: '已发货' },
		{ title: '订单 20261023010', value: '已发货' },
		{ title: '订单 20261023011', value: '已发货' }
	]

	const stickyShadowRows: StickyDemoRow[] = [
		{ title: '分割线', value: '换成阴影' },
		{ title: '阴影档位', value: 'md' },
		{ title: '底色', value: 'surface' }
	]

	// 最后一组的 suffix 多给几行：页面要有足够的尾部内容，最后两根条才滚得到吸顶线，
	// shadow 和吸顶后的品牌底色才看得见。
	const stickyBrandRows: StickyDemoRow[] = [
		{ title: '底色来源', value: 'bgColor' },
		{ title: '跟随主题', value: '否' },
		{ title: '未吸顶也生效', value: '是' },
		{ title: '吸顶后底色', value: '品牌色不变' },
		{ title: '文字对比', value: '白字 4.5:1' },
		{ title: '暗色模式', value: '同一品牌色' },
		{ title: '分割线', value: '不画' },
		{ title: '阴影', value: 'shadow' },
		{ title: '滚过内容', value: '从条下穿过' },
		{ title: '占位高度', value: '与条等高' },
		{ title: '复位时机', value: 'suffix 滚完' }
	]

	const stickyBasicStuck = ref(false)

	const stickyOffsetStuck = ref(false)

	const stickyRangeFirstStuck = ref(false)

	const stickyRangeSecondStuck = ref(false)

	const stickyShadowStuck = ref(false)

	const stickyBrandStuck = ref(false)

	const stickyGlassFollowStuck = ref(false)

	const stickyGlassForceStuck = ref(false)

	const onStickyBasicChange = (stuck: boolean) => {
		stickyBasicStuck.value = stuck
	}

	const onStickyOffsetChange = (stuck: boolean) => {
		stickyOffsetStuck.value = stuck
	}

	const onStickyRangeFirstChange = (stuck: boolean) => {
		stickyRangeFirstStuck.value = stuck
	}

	const onStickyRangeSecondChange = (stuck: boolean) => {
		stickyRangeSecondStuck.value = stuck
	}

	const onStickyShadowChange = (stuck: boolean) => {
		stickyShadowStuck.value = stuck
	}

	const onStickyBrandChange = (stuck: boolean) => {
		stickyBrandStuck.value = stuck
	}

	const onStickyGlassFollowChange = (stuck: boolean) => {
		stickyGlassFollowStuck.value = stuck
	}

	const onStickyGlassForceChange = (stuck: boolean) => {
		stickyGlassForceStuck.value = stuck
	}

	// 未吸顶时跟上卡片上圆角；吸顶后条离开卡片，不再收角。
	const stickyBrandBarClass = computed((): string => {
		let name = 'demo-sticky-bar'
		if (!stickyBrandStuck.value) name += ' demo-sticky-bar--card'
		return name
	})

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>
