</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	const saving = ref(false)

	const submitting = ref(false)

	const keyword = ref('')

	const phone = ref('')

	const note = ref('')

	const onKeywordChange = (value: string) => {
		console.log('[Vaporix] input change:', value)
	}

	const onSave = () => {
		if (saving.value) return
		saving.value = true
		setTimeout(() => {
			saving.value = false
			uni.showToast({ title: '演示：保存完成', icon: 'none' })
		}, 1200)
	}

	const onSubmit = () => {
		if (submitting.value) return
		submitting.value = true
		setTimeout(() => {
			submitting.value = false
			uni.showToast({ title: '演示：提交完成', icon: 'none' })
		}, 1200)
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = ''
	const nextPath: string = '/pages/demo/icon/icon'
	const prevName = '已经是第一个'
	const nextName = '图标'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>
