							</view>
							<view class="bt-flow__item">
								<vx-button type="success" text="112 × 36" width="112px" height="36px" />
							</view>
							<view class="bt-flow__item">
								<vx-button type="default" text="mini" size="sm" width="88px" height="28px" />
							</view>
						</view>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="组合操作" desc="主次并排，或整行提交。" />
					<view class="demo-card">
						<view class="bt-row">
							<view class="bt-row__item bt-row__item--gap">
								<vx-button block type="default" text="取消" variant="plain" />
							</view>
							<view class="bt-row__item">
								<vx-button block type="primary" text="保存更改" :loading="saving" @click="onSave" />
							</view>
						</view>
						<view class="bt-block">
							<vx-button block type="primary" text="提交订单" :loading="submitting" @click="onSubmit" />
