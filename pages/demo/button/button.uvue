</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	const saving = ref(false)

	const submitting = ref(false)

	const keyword = ref('')

	const phone = ref('')

	const note = ref('')

	const onKeywordChange = (value: string) => {
		console.log('[Vaporix] input change:', value)
	}

	const onSave = () => {
		if (saving.value) return
		saving.value = true
		setTimeout(() => {
			saving.value = false
			uni.showToast({ title: '演示：保存完成', icon: 'none' })
		}, 1200)
	}

	const onSubmit = () => {
		if (submitting.value) return
		submitting.value = true
		setTimeout(() => {
			submitting.value = false
			uni.showToast({ title: '演示：提交完成', icon: 'none' })
		}, 1200)
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	// 雨棚波浪的扇齿数：按屏宽算，多铺一枚防右端缝隙。
	// App（蒸汽模式）不支持 background-size / repeat，波浪只能用视图拼。
	const teeth = computed((): number[] => {
		const width = uni.getWindowInfo().windowWidth
		const count = Math.ceil(width / 28) + 1
		const list: number[] = []
		for (let i = 0; i < count; i++) {
			list.push(i)
		}
		return list
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
	/* 按钮示例页专属样式，只在本页使用，名字带 bt- 前缀避免和共享 demo.css 冲突。
	   版式借 ThorUI / uView 的示例页：页头平铺不套卡片，分区头是主色小竖条 + 加粗标题 + 灰说明，
	   按钮成行陈列，不再一列到底。页头尽量用自家组件（vx-tag / vx-text / vx-divider），
	   自绘文本只留需要 1.5px 字距的眉标。颜色全走令牌，暗色主题自动跟随。 */
	/* ---------- 页脚 ---------- */
	/* 页脚和页导航都抽成了共享组件（components/demo-footer、demo-page-nav），
	   这里只负责把壳的底部留白收小，让页脚贴一点。 */
	.bt-shell {
		padding-bottom: var(--vx-space-sm);
	}

	/* ---------- 按钮陈列 ---------- */
	/* 两列 / 三列等分行：行距一档，列距半档。
	   运行时默认 view overflow hidden，会把带阴影按钮的阴影裁成矩形，这里统一放开。 */
	.bt-row {
		flex-direction: row;
		margin-bottom: var(--vx-space-md);
		overflow: visible;
	}

	.bt-row--last {
		margin-bottom: 0;
	}

	/* 阴影按钮所在行：底部留出比阴影扩散（8 偏移 + 20 模糊 ≈ 28px）更大的空档，
	   让阴影在卡片内部完整渐隐，不顶到卡片描边。 */
	.bt-row--shadow {
		margin-bottom: 24px;
	}

	.bt-row__item {
		flex: 1;
		overflow: visible;
	}

	.bt-row__item--gap {
		margin-right: var(--vx-space-sm);
	}

	/* 按内容宽度流式排：纯文字按钮、自定义尺寸用 */
	.bt-flow {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.bt-flow__item {
		margin-right: var(--vx-space-sm);
		margin-bottom: var(--vx-space-sm);
	}

	.bt-block {
		width: 100%;
	}

	/* 尺寸行：左侧是尺寸名和高度，右侧是按钮 */
	.bt-size {
		flex-direction: row;
		align-items: center;
		margin-bottom: var(--vx-space-md);
	}

	.bt-size--last {
		margin-bottom: 0;
	}

	.bt-size__key {
		width: 48px;
	}

	.bt-size__name {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
	}

	.bt-size__meta {
		font-size: 11px;
		line-height: 15px;
		color: var(--vx-color-text-secondary);
	}

	.bt-size__control {
		flex: 1;
	}

	/* ---------- 按钮里的图标组合 ---------- */
	/* 和组件内部文字同字号同字重，图标与文案留半档间距 */
	.bt-inline {
		flex-direction: row;
		align-items: center;
	}

	.bt-inline__text {
		margin-left: var(--vx-space-sm);
		font-size: var(--vx-font-control-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-medium);
	}

	.bt-inline__text--on-primary {
		color: var(--vx-color-on-primary);
	}

	/* 黄描边配 ink 色，白底上才够对比 */
	.bt-inline__text--warning-ink {
		color: var(--vx-color-warning-ink);
	}
</style>
