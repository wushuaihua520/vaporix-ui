							<vx-input v-model="keyword" placeholder="请输入关键词" clearable @change="onKeywordChange" />
						</view>
						<view class="demo-field">
							<vx-input v-model="phone" type="number" size="sm" placeholder="小号输入框" />
						</view>
						<view class="demo-field">
							<vx-input v-model="note" placeholder="校验失败状态" invalid />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input model-value="禁用状态" disabled />
