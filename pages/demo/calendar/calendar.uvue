<template>
	<view :class="pageClass">
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<view class="demo-shell">
				<view class="demo-pagebar">
					<view class="demo-crumb">
						<view class="demo-crumb__back" hover-class="demo-crumb__back--pressed" @click="goCatalog">
							<vx-icon name="chevron-left" size="sm" />
							<text class="demo-crumb__back-text">组件</text>
						</view>
						<text class="demo-crumb__sep">/</text>
						<text class="demo-crumb__current">表单</text>
					</view>
					<view class="demo-theme-toggle" hover-class="demo-theme-toggle--pressed"
						@click="toggleDemoPageTheme">
						<vx-icon :name="isDark ? 'sun' : 'moon'" size="md" />
					</view>
				</view>

				<view class="demo-hero">
					<text class="demo-hero__eyebrow">VAPORIX UI · vx-calendar</text>
					<view class="demo-hero__top">
						<view class="demo-hero__icon">
							<vx-icon name="calendar" size="lg" type="primary" />
						</view>
						<view class="demo-hero__heading">
							<view class="demo-hero__title-wrap">
								<text class="demo-hero__title">日历</text>
								<text class="demo-hero__title demo-hero__title--accent">10 组示例</text>
							</view>
						</view>
					</view>
					<text class="demo-hero__lead">42 格固定网格，五周和六周按当月收行；弹层点确定才写回模型。</text>
					<view class="demo-hero__chips">
						<view class="demo-chip">
							<text class="demo-chip__text">表单</text>
						</view>
						<view class="demo-chip demo-chip--neutral">
							<text class="demo-chip__text demo-chip__text--neutral">vx-calendar</text>
						</view>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">01</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">单个日期</text>
							<text class="demo-section__desc">默认模式，打开时停在已选的那个月。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-button block type="default" text="选择日期" @click="onCalendarSingle" />
						<view class="demo-datetime-status">
							<text class="demo-datetime-status__text">已选：{{ calendarValue.length > 0 ? calendarValue : '还没选' }}</text>
							<text class="demo-datetime-status__meta">mode="single"</text>
						</view>
						<text class="demo-hint">点确定才写回 v-model；关闭叉、遮罩和 close() 都不改已提交的值，再次打开还是上一次的结果。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">02</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">日期区间</text>
							<text class="demo-section__desc">第一下点起点、第二下点终点，中间铺一层浅底。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-button block type="default" text="选择日期区间" @click="onCalendarRange" />
						<view class="demo-datetime-status">
							<text class="demo-datetime-status__text">已选：{{ calendarRangeText }}</text>
							<text class="demo-datetime-status__meta">mode="range"</text>
						</view>
						<text class="demo-hint">两端各写回一个模型：v-model:start 和 v-model:end；点到起点之前会重新起头，再点一次起点得到一天的区间。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">农历</text>
							<text class="demo-section__desc">日期下方排一行农历日，初一、廿一这样的写法。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="显示农历"
									@click="onCalendarLunar(true)" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" type="default" text="只看日期"
									@click="onCalendarLunar(false)" />
							</view>
						</view>
						<text class="demo-hint">农历按 1900–2100 的公历表换算，只算日子和闰月，不算节气、干支和宜忌；关掉后行高不变。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">04</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">平铺展示</text>
							<text class="demo-section__desc">不写 popup 就是普通块，点选当场写回模型。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-calendar-board">
							<vx-calendar v-model="calendarInlineValue" show-lunar />
						</view>
						<view class="demo-datetime-status">
							<text class="demo-datetime-status__text">已选：{{ calendarInlineValue.length > 0 ? calendarInlineValue : '还没选' }}</text>
							<text class="demo-datetime-status__meta">popup=false</text>
						</view>
						<text class="demo-hint">平铺模式不带底色、描边和阴影，宽度跟随父级；这里外面套了一层 surface 区块，放进 vx-card 也一样。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">05</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">可选范围与翻月</text>
							<text class="demo-section__desc">范围之外转灰不可选，箭头跟着自动禁用。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="限定 10-10 到 11-20"
									@click="onCalendarLimit" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" type="default" text="只能切换月份"
									@click="onCalendarMonthOnly" />
							</view>
						</view>
						<vx-button block size="sm" type="default" text="恢复完整日历"
							@click="onCalendarLimitReset" />
						<text class="demo-hint">min-date / max-date 是闭区间；show-year-arrow 关掉后外侧的双箭头消失，只剩按月翻。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">06</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">标记</text>
							<text class="demo-section__desc">按日期补一层底色、文案或对勾，适合打卡和排班。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-calendar-board">
							<vx-calendar v-model="calendarMarksValue" :marks="calendarMarks" show-lunar />
						</view>
						<view class="demo-datetime-status">
							<text class="demo-datetime-status__text">标记 {{ calendarMarks.length }} 天</text>
							<text class="demo-datetime-status__meta">marks</text>
						</view>
						<text class="demo-hint">选中和区间优先于标记：既被选中又有标记时只显示选中态；不可选的日子也不显示标记颜色。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">07</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">自定义颜色</text>
							<text class="demo-section__desc">type 决定选中底色、区间浅底、文字和确定按钮。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="主色" @click="onCalendarType('primary')" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="成功" @click="onCalendarType('success')" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" type="default" text="危险" @click="onCalendarType('danger')" />
							</view>
						</view>
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="警告" @click="onCalendarType('warning')" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" type="default" text="中性" @click="onCalendarType('default')" />
							</view>
						</view>
						<text class="demo-hint">warning 的琥珀底配深色字，区间用 warning-ink；default 是中性选中，底色取正文色、文字取反色。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">08</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">标题、区间文字与遮罩</text>
							<text class="demo-section__desc">title 在头部正中，端点小字和遮罩色都能换。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-button block type="default" text="选择出行日期" @click="onCalendarTrip" />
						<text class="demo-hint">start-text / end-text 只在区间模式生效，建议 2 个字以内；maskColor 是字面值，不跟随主题。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">09</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">方法与事件</text>
							<text class="demo-section__desc">ref 上暴露 open() / close() / confirm()，confirm、cancel、change 各走各的。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="open()" @click="onCalendarOpen" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="close()" @click="onCalendarClose" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" type="default" text="confirm()" @click="onCalendarApply" />
							</view>
						</view>
						<view class="demo-datetime-status">
							<text class="demo-datetime-status__text">最近动作：{{ calendarLastEvent }}</text>
							<text class="demo-datetime-status__meta">change · confirm · cancel</text>
						</view>
						<text class="demo-hint">close() 只收起，不抛 cancel，也不改模型。confirm() 写回草稿并收起；没选完时直接返回。关掉底部按钮后，用它提交。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">10</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">组合</text>
							<text class="demo-section__desc">只读行点击打开；单日期和区间各用一个实例。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-input v-model="stayDate" label="入住日期" readonly arrow placeholder="请选择日期"
							@click="stayVisible = true" />
						<vx-input :model-value="calendarTripText" label="行程日期" readonly arrow placeholder="请选择日期"
							@click="tripVisible = true" />
						<text class="demo-hint">一个值一个实例：入住用 v-model，行程用 v-model:start / v-model:end，互不干扰。</text>
					</view>
				</view>

				<view class="demo-page-nav">
					<view class="demo-page-nav__item"
						:class="prevPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goPrev">
						<text class="demo-page-nav__label">上一个</text>
						<text class="demo-page-nav__name">{{ prevName }}</text>
					</view>
					<view class="demo-page-nav__item demo-page-nav__item--next"
						:class="nextPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goNext">
						<text class="demo-page-nav__label">下一个</text>
						<text class="demo-page-nav__name">{{ nextName }}</text>
					</view>
				</view>

				<view class="demo-footer">
					<text class="demo-footer__text">元汽UI · MIT</text>
					<text class="demo-footer__meta">VAPORIX UI · 组件演示 · v0.59.0</text>
				</view>
			</view>
		</scroll-view>

		<!-- 日历弹层同样挂在页面根上，遮罩才盖得住滚动容器和固定页脚。 -->
		<vx-calendar ref="calendarRef" v-model="calendarValue" v-model:start="calendarStart"
			v-model:end="calendarEnd" v-model:show="calendarVisible" popup :mode="calendarMode"
			:title="calendarTitle" :type="calendarType" :show-lunar="calendarShowLunar"
			:show-year-arrow="calendarYearArrow" :min-date="calendarMinDate" :max-date="calendarMaxDate"
			:start-text="calendarStartText" :end-text="calendarEndText" :mask-color="calendarMaskColor"
			@confirm="onCalendarConfirm" @cancel="onCalendarCancel" @change="onCalendarChange"
			@month-change="onCalendarMonthChange" />

		<!-- 组合里的两个值各一个实例：入住用 v-model，行程用 v-model:start / v-model:end。 -->
		<vx-calendar v-model="stayDate" v-model:show="stayVisible" popup title="选择入住日期" />

		<vx-calendar v-model:start="tripStart" v-model:end="tripEnd" v-model:show="tripVisible" popup
			mode="range" title="选择行程日期" />
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	// 日历：一个共享弹层实例跑完实验室，平铺示例和表单组合各自独立。
	type CalendarDemoMode = 'single' | 'range'

	type CalendarDemoSemantic = 'primary' | 'success' | 'info' | 'warning' | 'danger' | 'default'

	type CalendarDemoMark = {
		date: string
		text?: string
		bgColor?: string
		color?: string
		done?: boolean
	}

	type CalendarDemoApi = {
		open?: () => void
		close?: () => void
		confirm?: () => void
	}

	const calendarRef = ref<CalendarDemoApi | null>(null)

	const calendarVisible = ref(false)

	const calendarMode = ref<CalendarDemoMode>('single')

	const calendarValue = ref('2026-10-26')

	const calendarStart = ref('2026-10-06')

	const calendarEnd = ref('2026-10-18')

	const calendarTitle = ref('选择日期')

	const calendarType = ref<CalendarDemoSemantic>('primary')

	const calendarShowLunar = ref(false)

	const calendarYearArrow = ref(true)

	const calendarMinDate = ref('')

	const calendarMaxDate = ref('')

	const calendarStartText = ref('开始')

	const calendarEndText = ref('结束')

	const calendarMaskColor = ref('')

	const calendarLastEvent = ref('还没有操作')

	// 平铺的两个实例常驻在滚动容器里：一个空选看效果，一个挂满标记。
	const calendarInlineValue = ref('2026-10-26')

	const calendarMarksValue = ref('')

	const calendarMarks = ref<Array<CalendarDemoMark>>([])

	// 入住和行程各一个实例，写入两端模型。
	const stayDate = ref('')

	const stayVisible = ref(false)

	const tripStart = ref('')

	const tripEnd = ref('')

	const tripVisible = ref(false)

	const calendarRangeText = computed((): string => {
		if (calendarStart.value.length === 0) return '还没选'
		if (calendarEnd.value.length === 0) return `${calendarStart.value} 至 还没选终点`
		return `${calendarStart.value} 至 ${calendarEnd.value}`
	})

	const calendarTripText = computed((): string => {
		if (tripStart.value.length === 0) return ''
		return `${tripStart.value} 至 ${tripEnd.value}`
	})

	// 每次点按钮都把共享实例重配一遍再打开：模式和文案在打开前就位，弹层不会先闪一下旧配置。
	const applyCalendarConfig = (mode: CalendarDemoMode, title: string) => {
		calendarMode.value = mode
		calendarTitle.value = title
		calendarVisible.value = true
	}

	const onCalendarSingle = () => {
		calendarType.value = 'primary'
		calendarShowLunar.value = false
		calendarYearArrow.value = true
		calendarMinDate.value = ''
		calendarMaxDate.value = ''
		calendarStartText.value = '开始'
		calendarEndText.value = '结束'
		calendarMaskColor.value = ''
		applyCalendarConfig('single', '选择日期')
	}

	const onCalendarRange = () => {
		calendarStartText.value = '开始'
		calendarEndText.value = '结束'
		calendarMaskColor.value = ''
		applyCalendarConfig('range', '选择日期区间')
	}

	const onCalendarLunar = (visible: boolean) => {
		calendarMode.value = 'single'
		calendarShowLunar.value = visible
		applyCalendarConfig('single', visible ? '选择日期 · 农历' : '选择日期')
	}

	const onCalendarLimit = () => {
		calendarShowLunar.value = false
		calendarYearArrow.value = true
		calendarMinDate.value = '2026-10-10'
		calendarMaxDate.value = '2026-11-20'
		applyCalendarConfig('single', '可选范围 10-10 到 11-20')
	}

	const onCalendarMonthOnly = () => {
		calendarMinDate.value = ''
		calendarMaxDate.value = ''
		calendarYearArrow.value = false
		applyCalendarConfig('single', '只能切换月份')
	}

	const onCalendarLimitReset = () => {
		calendarMinDate.value = ''
		calendarMaxDate.value = ''
		calendarYearArrow.value = true
		applyCalendarConfig('single', '选择日期')
	}

	const onCalendarType = (semantic: CalendarDemoSemantic) => {
		calendarType.value = semantic
		applyCalendarConfig(calendarMode.value, calendarTitle.value)
	}

	const onCalendarTrip = () => {
		calendarType.value = 'danger'
		calendarStartText.value = '出发'
		calendarEndText.value = '返程'
		calendarMaskColor.value = 'rgba(43, 107, 224, 0.28)'
		applyCalendarConfig('range', '选择出行日期')
	}

	const onCalendarOpen = () => {
		calendarLastEvent.value = 'open()'
		calendarRef.value?.open?.()
	}

	const onCalendarClose = () => {
		calendarLastEvent.value = 'close()'
		calendarRef.value?.close?.()
	}

	const onCalendarApply = () => {
		calendarRef.value?.confirm?.()
	}

	const onCalendarConfirm = () => {
		calendarLastEvent.value = 'confirm'
	}

	const onCalendarCancel = () => {
		calendarLastEvent.value = 'cancel'
	}

	const onCalendarChange = () => {
		calendarLastEvent.value = 'change'
	}

	const onCalendarMonthChange = (year: number, month: number) => {
		calendarLastEvent.value = `monthChange · ${year}-${month}`
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/picker/picker'
	const nextPath: string = '/pages/demo/form/form'
	const prevName = '联动选择'
	const nextName = '表单'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>
