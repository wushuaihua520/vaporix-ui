<template>
	<view :class="pageClass">
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<view class="demo-shell">
				<view class="demo-pagebar">
					<view class="demo-crumb">
						<view class="demo-crumb__back" hover-class="demo-crumb__back--pressed" @click="goCatalog">
							<vx-icon name="chevron-left" size="sm" />
							<text class="demo-crumb__back-text">组件</text>
						</view>
						<text class="demo-crumb__sep">/</text>
						<text class="demo-crumb__current">表单</text>
					</view>
					<view class="demo-theme-toggle" hover-class="demo-theme-toggle--pressed"
						@click="toggleDemoPageTheme">
						<vx-icon :name="isDark ? 'sun' : 'moon'" size="md" />
					</view>
				</view>

				<view class="demo-hero">
					<text class="demo-hero__eyebrow">VAPORIX UI · vx-input</text>
					<view class="demo-hero__top">
						<view class="demo-hero__icon">
							<vx-icon name="edit" size="lg" type="primary" />
						</view>
						<view class="demo-hero__heading">
							<view class="demo-hero__title-wrap">
								<text class="demo-hero__title">输入框</text>
								<text class="demo-hero__title demo-hero__title--accent">8 组示例</text>
							</view>
						</view>
					</view>
					<text class="demo-hero__lead">描边盒与表单行两种形态，标题与内容同字号，靠字重和颜色分层。</text>
					<view class="demo-hero__chips">
						<view class="demo-chip">
							<text class="demo-chip__text">表单</text>
						</view>
						<view class="demo-chip demo-chip--neutral">
							<text class="demo-chip__text demo-chip__text--neutral">vx-input</text>
						</view>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">01</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">基础用法</text>
							<text class="demo-section__desc">三档尺寸，输入即更新 v-model。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="personName" placeholder="请输入姓名" clearable />
						</view>
						<view class="demo-field">
							<vx-input size="lg" placeholder="大号输入框 · 48" />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input size="sm" placeholder="小号输入框 · 32" />
						</view>
						<text class="demo-hint">v-model 当前值：{{ personName.length > 0 ? personName : '未填写' }}</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">02</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">标题与必填</text>
							<text class="demo-section__desc">label 放标题，required 加星号，label-width 对齐。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="contactName" label="姓名" label-width="80px" placeholder="请输入姓名" />
						</view>
						<view class="demo-field">
							<vx-input v-model="contactPhone" label="联系电话" label-width="80px" required type="number"
								placeholder="请输入手机号" />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input v-model="companyName" label="公司" label-width="80px" required clearable
								placeholder="请输入公司名称" />
						</view>
						<text class="demo-hint">label-width 带单位。不传则按文字宽度。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">清除与单位</text>
							<text class="demo-section__desc">有值才出现清除。unit 只展示，不进值。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="searchKeyword" label="关键词" label-width="80px" clearable
								placeholder="有值时出现清除" />
						</view>
						<view class="demo-field">
							<vx-input v-model="percentValue" label="百分比" label-width="80px" align="right" unit="%"
								type="digit" placeholder="请输入百分比" />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input v-model="amountValue" label="金额" label-width="80px" align="right" unit="元"
								type="digit" placeholder="请输入金额" />
						</view>
						<text class="demo-hint">百分比：{{ percentValue.length > 0 ? percentValue : '未填写' }} · 金额：{{ amountValue.length > 0 ? amountValue : '未填写' }}</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">04</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">形态与轮廓</text>
							<text class="demo-section__desc">outline 描边盒，line 只留底边。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input placeholder="默认描边 · rounded" />
						</view>
						<view class="demo-field">
							<vx-input placeholder="胶囊 · pill" shape="pill" />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input placeholder="平角 · square" shape="square" />
						</view>
					</view>
					<view class="demo-card demo-card--flush demo-card--spaced">
						<vx-input v-model="formName" variant="line" label="姓名" label-width="80px" placeholder="line 表单行" />
						<vx-input v-model="formPhone" variant="line" label="联系电话" label-width="80px" required type="number"
							placeholder="line 表单行" />
						<vx-input model-value="不可编辑" variant="line" label="备注" label-width="80px" disabled />
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">05</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">前后缀</text>
							<text class="demo-section__desc">prefix 放前面，suffix 放后面。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="prefixPhone" label="手机号" label-width="80px" type="number" clearable
								placeholder="请输入手机号">
								<template #prefix>
									<text class="demo-affix">+86</text>
								</template>
							</vx-input>
						</view>
						<view class="demo-field">
							<vx-input v-model="verifyCode" label="验证码" label-width="80px" type="number" :maxlength="6"
								placeholder="请输入验证码">
								<template #suffix>
									<vx-button size="sm" type="primary" variant="soft" text="获取验证码"
										:loading="sendingCode" @click="onSendCode" />
								</template>
							</vx-input>
						</view>
						<view class="demo-field demo-field--last">
							<vx-input v-model="searchWord" shape="pill" clearable placeholder="搜索关键词">
								<template #suffix>
									<vx-button size="sm" type="primary" variant="link" text="搜索" @click="onSearch" />
								</template>
							</vx-input>
						</view>
						<text class="demo-hint">插槽里的按钮尺寸不变。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">06</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">只读与选择</text>
							<text class="demo-section__desc">readonly 不弹键盘，点整行触发 click。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="regionValue" label="地区" label-width="80px" required readonly arrow
								@click="onPickRegion" />
						</view>
						<view class="demo-field">
							<vx-input v-model="dateValue" label="日期" label-width="80px" readonly arrow
								placeholder="请选择日期" @click="onPickDate" />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input v-model="levelValue" label="等级" label-width="80px" readonly arrow align="right" />
						</view>
						<text class="demo-hint">这里只弹提示。选择器自己接。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">07</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">状态</text>
							<text class="demo-section__desc">聚焦、错误、禁用。错误只改描边。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="nicknameValue" label="昵称" label-width="80px" clearable
								placeholder="点按查看聚焦态" />
						</view>
						<view class="demo-field">
							<vx-input v-model="emailValue" label="邮箱" label-width="80px" invalid clearable
								placeholder="请输入邮箱" />
						</view>
						<view class="demo-field">
							<vx-input model-value="张三" label="姓名" label-width="80px" disabled />
						</view>
						<view class="demo-field demo-field--last">
							<vx-input model-value="13888889999" label="联系电话" label-width="80px" disabled />
						</view>
						<text class="demo-hint">禁用只改颜色，不改尺寸。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">08</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">登录表单</text>
							<text class="demo-section__desc">和按钮一起做成表单。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-field">
							<vx-input v-model="loginPhone" label="手机号" label-width="80px" type="number" :maxlength="11"
								clearable placeholder="请输入手机号">
								<template #prefix>
									<text class="demo-affix">+86</text>
								</template>
							</vx-input>
						</view>
						<view class="demo-field">
							<vx-input v-model="loginCode" label="验证码" label-width="80px" type="number" :maxlength="6"
								placeholder="请输入验证码">
								<template #suffix>
									<vx-button size="sm" type="primary" variant="soft" text="获取验证码"
										:loading="sendingCode" :disabled="loginPhone.length === 0" @click="onSendCode" />
								</template>
							</vx-input>
						</view>
						<view class="demo-field">
							<vx-input v-model="loginPassword" label="密码" label-width="80px" password clearable
								placeholder="请输入密码" />
						</view>
						<view class="demo-field demo-field--last">
							<vx-button block type="primary" text="登录" :loading="signingIn" @click="onSignIn" />
						</view>
						<text class="demo-hint">演示，不发请求。</text>
					</view>
				</view>

				<view class="demo-page-nav">
					<view class="demo-page-nav__item"
						:class="prevPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goPrev">
						<text class="demo-page-nav__label">上一个</text>
						<text class="demo-page-nav__name">{{ prevName }}</text>
					</view>
					<view class="demo-page-nav__item demo-page-nav__item--next"
						:class="nextPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goNext">
						<text class="demo-page-nav__label">下一个</text>
						<text class="demo-page-nav__name">{{ nextName }}</text>
					</view>
				</view>

				<view class="demo-footer">
					<text class="demo-footer__text">元汽UI · MIT</text>
					<text class="demo-footer__meta">VAPORIX UI · 组件演示 · v0.59.0</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	type ToastSemantic = 'primary' | 'success' | 'info' | 'warning' | 'danger' | 'default'

	type ToastIcon = 'check-circle' | 'close-circle' | 'alert-circle' | 'info' | 'heart'

	type ToastOptions = {
		text: string
		type: ToastSemantic
		duration?: number
		icon?: ToastIcon | null
		image?: string
		showIcon?: boolean
		bgColor?: string
		bgOpacity?: number
		color?: string
	}

	const toastText = ref('')

	const toastType = ref<ToastSemantic>('default')

	const toastDuration = ref(2000)

	const toastIcon = ref<ToastIcon | null>(null)

	const toastImage = ref('')

	const toastShowIcon = ref(true)

	const toastBgColor = ref('')

	const toastBgOpacity = ref(0.9)

	const toastColor = ref('')

	const toastRef = ref<VxToastComponentPublicInstance | null>(null)

	const personName = ref('')

	const contactName = ref('')

	const contactPhone = ref('')

	const companyName = ref('')

	const searchKeyword = ref('元汽UI')

	const percentValue = ref('')

	const amountValue = ref('')

	const formName = ref('')

	const formPhone = ref('')

	const prefixPhone = ref('')

	const verifyCode = ref('')

	const searchWord = ref('')

	const regionValue = ref('上海市浦东新区')

	const dateValue = ref('')

	const levelValue = ref('黄金会员')

	const nicknameValue = ref('')

	const emailValue = ref('name@invalid')

	const loginPhone = ref('')

	const loginCode = ref('')

	const loginPassword = ref('')

	const sendingCode = ref(false)

	const signingIn = ref(false)

	const onSendCode = () => {
		if (sendingCode.value) return
		sendingCode.value = true
		setTimeout(() => {
			sendingCode.value = false
			uni.showToast({ title: '演示：验证码已发送', icon: 'none' })
		}, 1000)
	}

	const onSignIn = () => {
		if (signingIn.value) return
		signingIn.value = true
		setTimeout(() => {
			signingIn.value = false
			uni.showToast({ title: '演示：登录成功', icon: 'none' })
		}, 1200)
	}

	const onPickRegion = () => {
		uni.showToast({ title: '演示：打开地区选择', icon: 'none' })
	}

	const onPickDate = () => {
		uni.showToast({ title: '演示：打开日期选择', icon: 'none' })
	}

	const onSearch = () => {
		uni.showToast({ title: '演示：开始搜索', icon: 'none' })
	}

	// 先改状态再调 open()：同一条提示连点也重新计时，不用先关再开。
	const showToast = (options: ToastOptions) => {
		toastType.value = options.type
		toastText.value = options.text
		toastDuration.value = options.duration != null ? options.duration : 2000
		toastIcon.value = options.icon != null ? options.icon : null
		toastImage.value = options.image != null ? options.image : ''
		toastShowIcon.value = options.showIcon != null ? options.showIcon : true
		toastBgColor.value = options.bgColor != null ? options.bgColor : ''
		toastBgOpacity.value = options.bgOpacity != null ? options.bgOpacity : 0.9
		toastColor.value = options.color != null ? options.color : ''
		toastRef.value?.open?.()
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/badge/badge'
	const nextPath: string = '/pages/demo/textarea/textarea'
	const prevName = '徽章'
	const nextName = '多行输入框'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>
