						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">基础</text>
							<text class="demo-section__desc">三个 span=8 正好占满一行；行本身不画底色和描边。</text>
						</view>
					</view>
					<view class="demo-row-stage">
						<vx-row :gutter="12">
							<vx-col :span="8">
