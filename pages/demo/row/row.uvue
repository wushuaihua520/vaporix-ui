								<view class="demo-row-card">
									<text class="demo-row-card__title">优惠券</text>
									<text class="demo-row-card__desc">3 张本周到期</text>
								</view>
							</vx-col>
							<vx-col :span="24" :sm="12" :md="8" :lg="6">
								<view class="demo-row-card">
									<text class="demo-row-card__title">专属客服</text>
									<text class="demo-row-card__desc">9:00–21:00 在线</text>
								</view>
							</vx-col>
							<vx-col :span="24" :sm="12" :md="8" :lg="6">
								<view class="demo-row-card">
