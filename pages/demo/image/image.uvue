									radius="circle" />
							</view>
							<view class="demo-img-size__copy">
								<text class="demo-img-size__name">80 × 80</text>
								<text class="demo-img-size__meta">正方形配 circle，就是一张头像。</text>
							</view>
						</view>
						<view class="demo-img-size-row demo-img-size-row--last">
							<view class="demo-img-size__box demo-img-size__box--wide">
								<vx-image src="/static/demo/card/cover.jpg" height="120px" radius="md" />
							</view>
							<view class="demo-img-size__copy">
								<text class="demo-img-size__name">100% × 120</text>
								<text class="demo-img-size__meta">只给高度，宽度跟随父级。</text>
							</view>
						</view>
					</view>
					<text class="demo-hint demo-img-hint">width 默认 100%；height 空串且 ratio 为 0 时高度取 100%，由父级容器决定。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="按比例" desc="width 240px + ratio 1 / 1.78 / 0.75；最后一行用 240rpx，随屏宽换算。" />
					<view class="demo-img-ratio">
						<view class="demo-img-ratio__row">
							<view class="demo-img-ratio__copy">
								<text class="demo-img-ratio__name">1 : 1</text>
