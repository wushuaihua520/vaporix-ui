								<text class="demo-img-ratio__name">1.78 : 1</text>
								<text class="demo-img-ratio__meta">240 × 135</text>
							</view>
							<view class="demo-img-ratio__media">
								<vx-image src="/static/demo/card/cover.jpg" width="240px" :ratio="1.78" radius="md" />
							</view>
						</view>
						<view class="demo-img-ratio__row">
							<view class="demo-img-ratio__copy">
								<text class="demo-img-ratio__name">0.75 : 1</text>
								<text class="demo-img-ratio__meta">240 × 320</text>
							</view>
							<view class="demo-img-ratio__media">
								<vx-image src="/static/demo/card/grid-5.jpg" width="240px" :ratio="0.75" radius="md" />
							</view>
						</view>
						<view class="demo-img-ratio__row demo-img-ratio__row--last">
							<view class="demo-img-ratio__copy">
								<text class="demo-img-ratio__name">240rpx · 1.78</text>
								<text class="demo-img-ratio__meta">随屏宽换算</text>
							</view>
							<view class="demo-img-ratio__media">
								<vx-image src="/static/demo/card/grid-7.jpg" width="240rpx" :ratio="1.78" radius="md" />
							</view>
						</view>
					</view>
					<text class="demo-hint demo-img-hint">ratio 只在 width 是 px 或 rpx 时生效：px 直接算，rpx 按 750 基准换算；百分比宽度下不生效，开发时会提示一次。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="mode 四档" desc="同一张 1200 × 640 的横图放进 140 × 140 的盒子，裁切方式一眼能分开。" />
					<view class="demo-img-modes">
						<view class="demo-img-modes__item">
							<view class="demo-img-modes__media">
								<vx-image src="/static/demo/card/cover.jpg" width="140px" height="140px" radius="md" />
							</view>
							<text class="demo-img-modes__name">aspectFill</text>
							<text class="demo-img-modes__meta">裁切填满</text>
						</view>
						<view class="demo-img-modes__item">
							<view class="demo-img-modes__media">
								<vx-image src="/static/demo/card/cover.jpg" width="140px" height="140px" radius="md"
									mode="aspectFit" />
							</view>
							<text class="demo-img-modes__name">aspectFit</text>
							<text class="demo-img-modes__meta">完整显示</text>
						</view>
						<view class="demo-img-modes__item">
							<view class="demo-img-modes__media">
								<vx-image src="/static/demo/card/cover.jpg" width="140px" height="140px" radius="md"
									mode="scaleToFill" />
							</view>
							<text class="demo-img-modes__name">scaleToFill</text>
							<text class="demo-img-modes__meta">拉伸填满</text>
						</view>
						<view class="demo-img-modes__item">
							<view class="demo-img-modes__media">
								<vx-image src="/static/demo/card/cover.jpg" width="140px" height="140px" radius="md"
									mode="center" />
							</view>
							<text class="demo-img-modes__name">center</text>
							<text class="demo-img-modes__meta">不缩放取中间</text>
						</view>
					</view>
					<text class="demo-hint demo-img-hint">aspectFit 的留白落在占位底色上；默认 aspectFill，其它值一律回落到 aspectFill。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="事件与淡入" desc="load / error / click 只抛事件；fade=false 去掉 200ms 淡入。" />
					<view class="demo-card">
						<view class="demo-img-event__media">
							<vx-image :key="eventKey" :src="eventSrc" height="120px" radius="md" :fade="fadeEnabled"
								@load="onEventLoad" @error="onEventError" @click="onEventClick" />
						</view>
						<view class="demo-img-event__bar">
							<view class="demo-img-event__actions">
								<view class="demo-img-event__action">
									<vx-button size="sm" type="primary" variant="soft" text="换一张" @click="switchSource" />
								</view>
								<view class="demo-img-event__action">
									<vx-button size="sm" type="default" variant="soft"
										:text="fadeEnabled ? '关掉淡入' : '打开淡入'" @click="toggleFade" />
								</view>
							</view>
							<text class="demo-img-event__state">最近事件：{{ lastEvent }}</text>
							<text class="demo-img-event__meta">fade = {{ fadeEnabled ? 'true' : 'false' }}</text>
						</view>
						<view class="demo-img-event__fade">
							<vx-image src="/static/demo/card/grid-6.jpg" height="96px" radius="md" :fade="false" />
						</view>
						<text class="demo-img-event__caption">下面这组固定 fade=false：不挂过渡，加载完直接出现。</text>
					</view>
					<text class="demo-hint demo-img-hint">点图片只会抛 click，不会打开预览；预览、长按保存和裁剪分别属于 vx-gallery、业务和裁剪件。</text>
				</view>

				<demo-page-nav current-key="image" />

				<demo-footer />
