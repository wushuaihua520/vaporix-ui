</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/popup/popup'
	const nextPath: string = '/pages/demo/divider/divider'
	const prevName = '弹出层'
	const nextName = '分割线'

	// 重新挂载 = 重新走一遍加载中 → 成功；key 变一次就够。
	const basicKey = ref(0)
	const basicState = ref('等待加载')

	// 事件演示：换图会重置成加载中，fade 开关只影响淡入。
	const eventKey = ref(0)
	const eventSrc = ref('/static/demo/card/grid-1.jpg')
	const eventCount = ref(0)
	const lastEvent = ref('还没有触发')
	const fadeEnabled = ref(true)

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	const onBasicLoad = () => {
		basicState.value = '加载完成'
	}

	const onBasicError = () => {
		basicState.value = '加载失败'
	}

	const replayBasic = () => {
		basicKey.value += 1
		basicState.value = '加载中…'
	}

	const onEventLoad = () => {
		lastEvent.value = 'load · 图片已加载'
	}

	const onEventError = () => {
		lastEvent.value = 'error · 地址读不到'
	}

	const onEventClick = () => {
		eventCount.value += 1
		lastEvent.value = 'click · 第 ' + eventCount.value + ' 次点击'
	}

	const switchSource = () => {
		eventSrc.value = eventSrc.value.indexOf('grid-1') >= 0
			? '/static/demo/card/grid-2.jpg'
			: '/static/demo/card/grid-1.jpg'
		eventKey.value += 1
	}

	const toggleFade = () => {
		fadeEnabled.value = !fadeEnabled.value
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>

