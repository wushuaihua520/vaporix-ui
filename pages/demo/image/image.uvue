						<view class="demo-img-lab__item">
							<view class="demo-img-lab__media">
								<vx-image src="/static/demo/card/grid-2.jpg" width="64px" height="64px" radius="md" />
							</view>
							<text class="demo-img-lab__name">md</text>
							<text class="demo-img-lab__meta">8px</text>
						</view>
						<view class="demo-img-lab__item">
