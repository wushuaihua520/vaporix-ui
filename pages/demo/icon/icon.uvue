<template>
	<view :class="pageClass">
		<demo-topbar title="图标" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="icon" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="尺寸" desc="14 / 18 / 22。绘制区大约是字号的 0.9。" />
					<view class="demo-card">
						<view class="demo-size-row">
							<view class="demo-size-row__key">
								<text class="demo-size-row__name">lg</text>
								<text class="demo-size-row__meta">22</text>
							</view>
							<view class="demo-size-row__control">
								<view class="demo-icon-row">
									<view class="demo-icon-row__item">
										<vx-icon name="search" size="lg" />
									</view>
									<view class="demo-icon-row__item">
										<vx-icon name="calendar" size="lg" />
									</view>
									<view class="demo-icon-row__item">
										<vx-icon name="user" size="lg" />
									</view>
									<view class="demo-icon-row__item demo-icon-row__item--last">
										<vx-icon name="settings" size="lg" />
									</view>
								</view>
							</view>
						</view>
						<view class="demo-size-row">
							<view class="demo-size-row__key">
								<text class="demo-size-row__name">md</text>
								<text class="demo-size-row__meta">18</text>
							</view>
							<view class="demo-size-row__control">
								<view class="demo-icon-row">
									<view class="demo-icon-row__item">
										<vx-icon name="search" />
									</view>
									<view class="demo-icon-row__item">
										<vx-icon name="calendar" />
									</view>
									<view class="demo-icon-row__item">
										<vx-icon name="user" />
									</view>
									<view class="demo-icon-row__item demo-icon-row__item--last">
										<vx-icon name="settings" />
									</view>
								</view>
							</view>
						</view>
						<view class="demo-size-row demo-size-row--last">
							<view class="demo-size-row__key">
								<text class="demo-size-row__name">sm</text>
								<text class="demo-size-row__meta">14</text>
							</view>
							<view class="demo-size-row__control">
								<view class="demo-icon-row">
									<view class="demo-icon-row__item">
										<vx-icon name="search" size="sm" />
									</view>
									<view class="demo-icon-row__item">
										<vx-icon name="calendar" size="sm" />
									</view>
									<view class="demo-icon-row__item">
										<vx-icon name="user" size="sm" />
									</view>
									<view class="demo-icon-row__item demo-icon-row__item--last">
										<vx-icon name="settings" size="sm" />
									</view>
								</view>
							</view>
						</view>
						<text class="demo-hint">14px 只放箭头、关闭、勾。复杂图形用 18 或 22。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="语义色" desc="五种语义色。反白和灰色用 color。" />
					<view class="demo-card">
						<view class="demo-icon-row">
							<view class="demo-icon-row__item">
								<vx-icon name="close" size="lg" />
							</view>
							<view class="demo-icon-row__item">
								<vx-icon name="chevron-down" type="primary" size="lg" />
							</view>
							<view class="demo-icon-row__item">
								<vx-icon name="check" type="success" size="lg" />
							</view>
							<view class="demo-icon-row__item">
								<vx-icon name="info" type="info" size="lg" />
							</view>
							<view class="demo-icon-row__item">
								<vx-icon name="calendar" type="warning" size="lg" />
							</view>
							<view class="demo-icon-row__item">
								<vx-icon name="trash" type="danger" size="lg" />
							</view>
							<view class="demo-icon-row__item demo-icon-row__item--last">
								<vx-icon name="eye" color="var(--vx-color-text-secondary)" size="lg" />
							</view>
						</view>
						<text class="demo-hint">默认文字色。type 是语义色，color 临时改色。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="按钮与输入框" desc="反白和灰色自己传。前缀图标跟输入框尺寸。" />
					<view class="demo-card">
						<view class="demo-stack">
							<view class="demo-stack__item">
								<vx-button block type="primary" text="继续">
									<view class="demo-icon-inline">
										<vx-icon name="chevron-right" color="var(--vx-color-on-primary)" />
									</view>
								</vx-button>
							</view>
							<view class="demo-stack__item">
								<vx-button block type="primary" text="继续" variant="plain">
									<view class="demo-icon-inline">
										<vx-icon name="chevron-right" color="var(--vx-color-primary-pressed)" />
									</view>
								</vx-button>
							</view>
							<view class="demo-stack__item">
								<vx-button block type="primary" text="已保存" variant="soft">
									<view class="demo-icon-inline">
										<vx-icon name="check" color="var(--vx-color-primary-pressed)" />
									</view>
								</vx-button>
							</view>
							<view class="demo-stack__item">
								<vx-button block type="primary" text="继续" variant="link">
									<view class="demo-icon-inline">
										<vx-icon name="chevron-right" color="var(--vx-color-primary-pressed)" />
									</view>
								</vx-button>
							</view>
							<view class="demo-stack__item">
								<vx-button block type="primary" text="禁用" disabled>
									<view class="demo-icon-inline">
										<vx-icon name="chevron-right" color="var(--vx-color-disabled-text)" />
									</view>
								</vx-button>
							</view>
							<view class="demo-stack__item demo-stack__item--last">
								<vx-button block type="primary" text="加载中" loading>
									<view class="demo-icon-inline">
										<vx-icon name="chevron-right" color="var(--vx-color-on-primary)" />
									</view>
								</vx-button>
							</view>
						</view>
					</view>
					<view class="demo-card demo-card--spaced">
						<view class="demo-field">
							<vx-input v-model="iconSearchWord" placeholder="搜索关键词">
								<template #prefix>
									<vx-icon name="search" color="var(--vx-color-text-secondary)" />
								</template>
							</vx-input>
						</view>
						<view class="demo-field">
							<vx-input v-model="iconDateValue" placeholder="选择日期" readonly arrow>
								<template #prefix>
									<vx-icon name="calendar" color="var(--vx-color-text-secondary)" />
								</template>
							</vx-input>
						</view>
						<view class="demo-field demo-field--last">
							<vx-input model-value="不可编辑" disabled>
								<template #prefix>
									<vx-icon name="user" color="var(--vx-color-disabled-text)" />
								</template>
							</vx-input>
						</view>
						<text class="demo-hint">前缀跟输入框尺寸。反白用 color 传。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="核心图标" desc="core 112 个。extend 1000 个要另外引入样式。" />
					<view class="demo-card">
						<view class="demo-icon-switch">
							<view class="demo-icon-switch__item">
								<vx-button size="sm" :variant="iconVariant === 'regular' ? 'solid' : 'plain'" :type="iconVariant === 'regular' ? 'primary' : 'default'" text="Regular" @click="iconVariant = 'regular'" />
							</view>
							<view class="demo-icon-switch__item demo-icon-switch__item--last">
								<vx-button size="sm" :variant="iconVariant === 'fill' ? 'solid' : 'plain'" :type="iconVariant === 'fill' ? 'primary' : 'default'" text="Fill" @click="iconVariant = 'fill'" />
							</view>
						</view>
						<view class="demo-icon-grid">
							<view v-for="name in visibleIconNames" :key="name" class="demo-icon-cell">
								<vx-icon :name="name" :variant="iconVariant" size="lg" />
								<text class="demo-icon-cell__name">{{ name }}</text>
							</view>
						</view>
						<view v-if="hiddenIconCount > 0" class="demo-icon-switch">
							<view class="demo-icon-switch__item demo-icon-switch__item--last">
								<vx-button size="sm" type="default" variant="plain" :text="iconMoreText" @click="showAllIcons" />
							</view>
						</view>
						<text class="demo-hint">先渲染 {{ visibleIconNames.length }} 个，整表 {{ iconNames.length }} 个。字体在包里，扩展字体要另外引入。</text>
					</view>
				</view>

				<demo-page-nav current-key="icon" />

				<demo-footer />
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'
	import { VX_ICON_CORE_NAMES } from '@/uni_modules/vaporix-ui/libs/icons/codepoints'

	const iconSearchWord = ref('')

	const iconDateValue = ref('')

	const iconVariant = ref<'regular' | 'fill'>('regular')

	const iconNames = VX_ICON_CORE_NAMES
	const iconPreviewLimit = ref(40)

	const visibleIconNames = computed((): string[] => {
		const limit = iconPreviewLimit.value < iconNames.length ? iconPreviewLimit.value : iconNames.length
		const list: string[] = []
		for (let index = 0; index < limit; index++) {
			list.push(iconNames[index])
		}
		return list
	})

	const hiddenIconCount = computed((): number => {
		return iconNames.length - visibleIconNames.value.length
	})

	const iconMoreText = computed((): string => {
		return '再看 ' + hiddenIconCount.value + ' 个'
	})

	const showAllIcons = () => {
		iconPreviewLimit.value = iconNames.length
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>
