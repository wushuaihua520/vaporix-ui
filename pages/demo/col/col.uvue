</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 多端适配演示：断点按窗口宽度算，这里把当前宽度和档位读出来给用户对照。
	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const windowWidth = ref(0)

	const tier = computed((): string => {
		if (windowWidth.value >= 1200) return 'xl · 宽屏'
		if (windowWidth.value >= 992) return 'lg · 桌面'
		if (windowWidth.value >= 768) return 'md · 平板横屏'
		if (windowWidth.value >= 576) return 'sm · 平板竖屏'
		return 'span · 手机'
	})


	onShow(() => {
		syncDemoTheme()
		windowWidth.value = uni.getWindowInfo().windowWidth
	})
</script>

<style>
	.demo-col-stage {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-md);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-md);
		padding-left: var(--vx-space-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-surface);
	}

	.demo-col-stage--next {
		margin-top: var(--vx-space-md);
	}

	.demo-col-label {
		margin-bottom: var(--vx-space-sm);
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	.demo-col-box {
		box-sizing: border-box;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding-top: var(--vx-space-sm);
		padding-bottom: var(--vx-space-sm);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-sm);
		background-color: var(--vx-color-bg);
	}

	.demo-col-box--soft {
		border-color: var(--vx-color-primary-soft);
		background-color: var(--vx-color-primary-soft);
	}

	.demo-col-box--hidden {
		border-color: var(--vx-color-border);
		background-color: var(--vx-color-surface);
	}

	.demo-col-box__text {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	.demo-col-box__text--soft {
		color: var(--vx-color-primary-pressed);
	}

	.demo-col-box__text--hidden {
		color: var(--vx-color-disabled-text);
	}

	/* 窗口宽度读数：断点不是猜的，这一行就是列正在用的那个数。
	   数值和档位按中线对齐；App 的 align-items 不支持 baseline。 */
	.demo-col-meter {
		flex-direction: row;
		align-items: center;
		margin-bottom: var(--vx-space-md);
	}

	.demo-col-meter__value {
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		font-weight: var(--vx-weight-medium);
		color: var(--vx-color-text);
	}

	.demo-col-meter__tier {
		margin-left: var(--vx-space-sm);
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	.demo-col-card {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-md);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-md);
		padding-left: var(--vx-space-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-surface);
	}

	.demo-col-card--plain {
		background-color: var(--vx-color-bg);
	}

	.demo-col-card__value {
		font-size: var(--vx-font-xl);
		line-height: var(--vx-line-xl);
		font-weight: var(--vx-weight-bold);
		color: var(--vx-color-text);
	}

	.demo-col-card__label {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* 趋势条只是占位图形：演示的是栅格，不是图表。 */
	.demo-col-chart {
		flex-direction: row;
		align-items: flex-end;
		height: 64px;
		margin-top: var(--vx-space-md);
	}

	.demo-col-chart__bar {
		flex: 1;
		margin-right: var(--vx-space-xs);
		border-radius: 3px;
		background-color: var(--vx-color-primary-soft);
	}

	.demo-col-chart__bar--1 {
		height: 40%;
	}

	.demo-col-chart__bar--2 {
		height: 64%;
	}

	.demo-col-chart__bar--3 {
		height: 32%;
	}

	.demo-col-chart__bar--4 {
		height: 84%;
	}

	.demo-col-chart__bar--5 {
		height: 56%;
	}

	.demo-col-chart__bar--6 {
		height: 72%;
	}

	.demo-col-chart__bar--7 {
		height: 48%;
		margin-right: 0;
	}
</style>
