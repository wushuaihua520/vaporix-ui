									<text class="demo-col-box__text">8</text>
								</view>
							</vx-col>
						</vx-row>
					</view>
					<text class="demo-hint">span=0 是 display: none，不是不渲染；切回宽屏时不用重建。断点也能传 0，例如 md=0 表示桌面收起。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="断点" desc="span=24 sm=12 md=8 lg=6，按窗口宽度往上覆盖。" />
					<view class="demo-col-stage">
						<view class="demo-col-meter">
							<text class="demo-col-meter__value">窗口 {{ windowWidth }}px</text>
							<text class="demo-col-meter__tier">当前档位 {{ tier }}</text>
						</view>
						<vx-row :gutter="12" :line-gutter="12">
							<vx-col :span="24" :sm="12" :md="8" :lg="6">
								<view class="demo-col-box demo-col-box--soft">
									<text class="demo-col-box__text demo-col-box__text--soft">A</text>
								</view>
							</vx-col>
							<vx-col :span="24" :sm="12" :md="8" :lg="6">
								<view class="demo-col-box demo-col-box--soft">
									<text class="demo-col-box__text demo-col-box__text--soft">B</text>
								</view>
							</vx-col>
							<vx-col :span="24" :sm="12" :md="8" :lg="6">
								<view class="demo-col-box demo-col-box--soft">
									<text class="demo-col-box__text demo-col-box__text--soft">C</text>
								</view>
							</vx-col>
							<vx-col :span="24" :sm="12" :md="8" :lg="6">
								<view class="demo-col-box demo-col-box--soft">
									<text class="demo-col-box__text demo-col-box__text--soft">D</text>
								</view>
							</vx-col>
						</vx-row>
					</view>
					<text class="demo-hint">断点只改 span，offset / push / pull 在所有宽度上同一个值；sm / md / lg / xl 分别从 576 / 768 / 992 / 1200 起。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="组合" desc="四个数据格排两行，下面一张通栏卡片。" />
