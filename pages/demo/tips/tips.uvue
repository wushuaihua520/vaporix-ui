<template>
	<view :class="pageClass">
		<demo-topbar title="消息提示" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="tips" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="位置" desc="顶部铺满整条，居中、底部收成圆角浮层。" />
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" :type="tipsPosition === 'top' ? 'primary' : 'default'"
									text="顶部提示" @click="onTipsPosition('top')" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" :type="tipsPosition === 'center' ? 'primary' : 'default'"
									text="居中提示" @click="onTipsPosition('center')" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" :type="tipsPosition === 'bottom' ? 'primary' : 'default'"
									text="底部提示" @click="onTipsPosition('bottom')" />
							</view>
						</view>
						<text class="demo-hint">切换位置会立刻弹一条。top 是横幅，center / bottom 是浮层。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="类型" desc="六种语义色，跟随当前选中的位置。" />
					<view class="demo-card">
						<view class="demo-cluster">
							<view class="demo-cluster__item">
								<vx-button size="sm" text="一般提示" @click="onTipsDefault" />
							</view>
							<view class="demo-cluster__item">
								<vx-button size="sm" text="成功提示" @click="onTipsSuccess" />
							</view>
							<view class="demo-cluster__item">
								<vx-button size="sm" text="警告提示" @click="onTipsWarning" />
							</view>
							<view class="demo-cluster__item">
								<vx-button size="sm" text="错误提示" @click="onTipsDanger" />
							</view>
							<view class="demo-cluster__item">
								<vx-button size="sm" text="其他提示" @click="onTipsInfo" />
							</view>
							<view class="demo-cluster__item demo-cluster__item--last">
								<vx-button size="sm" text="主色提示" @click="onTipsPrimary" />
							</view>
						</view>
						<text class="demo-hint">实心底配对应的 on-* 前景；warning 的琥珀底用深色字，不用白字。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="长文案" desc="超出最大宽度就换行，浮层跟着长高。" />
					<view class="demo-card">
						<vx-button block type="default" text="长文字消息提示" @click="onTipsLong" />
						<text class="demo-hint demo-tips-note">maxWidth 默认 320px，行高 22，浮层跟着长高，不裁掉后面的行。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="时长" desc="默认 2000ms，0 表示常驻。" />
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" text="1 秒" @click="onTipsShort" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" text="4 秒" @click="onTipsLonger" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="常驻" @click="onTipsSticky" />
							</view>
						</view>
						<text class="demo-hint">duration 单位毫秒。常驻的提示要配 closable，否则只能由业务调 close()。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="图标与关闭" desc="图标在文案前，closable 显示关闭并让整条可点。" />
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" text="带图标" @click="onTipsIcon" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="可关闭" @click="onTipsClosable" />
							</view>
						</view>
						<text class="demo-hint">图标颜色跟前景走；关闭图标贴右，顶部横幅的正文仍按整条居中。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="自定义颜色" desc="底色和文字各管一处，不随主题推导。" />
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="default" text="深色底 + 浅色字"
									@click="onTipsCustomColor" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="半透明底色" @click="onTipsTranslucent" />
							</view>
						</view>
						<text class="demo-hint demo-tips-note">自定义色是字面值；只传一项时，其余项继续跟 type。bgOpacity 只调底色，默认 1。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="透明度" desc="opacity 让整条一起淡；bgOpacity 只压底色，两者相乘。" />
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="primary" text="整条 60%" @click="onTipsOpacity" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="底色 × 整条" @click="onTipsOpacityMixed" />
							</view>
						</view>
						<text class="demo-hint demo-tips-note">两条都按顶部横幅弹，方便看清压在导航栏下面。低于 1 时正文对比度归业务。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="默认插槽" desc="两行内容用插槽，颜色和字号自己带。" />
					<view class="demo-card">
						<vx-button block type="success" text="两行内容" @click="onTipsRich" />
						<text class="demo-hint demo-tips-note">传了默认插槽就不再渲染 text；插槽内容不继承前景色。</text>
					</view>
				</view>

				<view class="demo-section">
					<demo-section-head title="方法" desc="ref 拿实例，open() 重新计时，close() 立刻收起。" />
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="primary" text="open() 打开" @click="onTipsOpen" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="close() 关闭" @click="onTipsClose" />
							</view>
						</view>
						<text class="demo-hint">open() 重新计时；close() 立刻收起并抛 close，自动关闭也一样。</text>
					</view>
				</view>

				<demo-page-nav current-key="tips" />

				<demo-footer />
			</view>
		</scroll-view>

		<!-- 提示也挂在页面根上，和滚动容器平级；放进 scroll-view 会被滚动和裁剪。 -->
		<vx-tips ref="tipsRef" v-model:show="tipsVisible" :text="tipsText" :type="tipsType"
			:position="tipsPosition" :duration="tipsDuration" :icon="tipsIcon" :closable="tipsClosable"
			:bg-color="tipsBgColor" :bg-opacity="tipsBgOpacity" :color="tipsColor" :opacity="tipsOpacity" />

		<!-- 默认插槽会替换 text，两行内容用独立实例，不去抢主实例的插槽。 -->
		<vx-tips v-model:show="richTipsVisible" type="success" :duration="4000" closable>
			<view class="demo-tips-rich">
				<text class="demo-tips-rich__title">文件已上传</text>
				<text class="demo-tips-rich__meta">3 个文件 · 12.4 MB</text>
			</view>
		</vx-tips>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	type TipsSemantic = 'primary' | 'success' | 'info' | 'warning' | 'danger' | 'default'

	type TipsPosition = 'top' | 'center' | 'bottom'

	type TipsIcon = 'check-circle' | 'alert-triangle' | 'close-circle'

	type TipsOptions = {
		text: string
		type: TipsSemantic
		duration?: number
		icon?: TipsIcon | null
		closable?: boolean
		bgColor?: string
		bgOpacity?: number
		color?: string
		opacity?: number
	}

	// 提示只放一个实例演示全部位置和类型：先改状态再显示，文案和类型不会串到上一条。
	const tipsVisible = ref(false)

	const tipsText = ref('')

	const tipsType = ref<TipsSemantic>('default')

	const tipsPosition = ref<TipsPosition>('center')

	const tipsDuration = ref(2000)

	const tipsIcon = ref<TipsIcon | null>(null)

	const tipsClosable = ref(false)

	const tipsBgColor = ref('')

	const tipsBgOpacity = ref(1)

	const tipsColor = ref('')

	const tipsOpacity = ref(1)

	const richTipsVisible = ref(false)

	const tipsRef = ref<VxTipsComponentPublicInstance | null>(null)

	const note = ref('')

	// 先改状态再调 open()：同一条提示连点也重新计时，不用先关再开。
	const showTips = (position: TipsPosition, options: TipsOptions) => {
		tipsPosition.value = position
		tipsText.value = options.text
		tipsType.value = options.type
		tipsDuration.value = options.duration != null ? options.duration : 2000
		tipsIcon.value = options.icon != null ? options.icon : null
		tipsClosable.value = options.closable != null ? options.closable : false
		tipsBgColor.value = options.bgColor != null ? options.bgColor : ''
		tipsBgOpacity.value = options.bgOpacity != null ? options.bgOpacity : 1
		tipsColor.value = options.color != null ? options.color : ''
		tipsOpacity.value = options.opacity != null ? options.opacity : 1
		// 一屏同时只显示一条：切到主实例时收起插槽那条。
		richTipsVisible.value = false
		tipsRef.value?.open?.()
	}

	const onTipsPosition = (position: TipsPosition) => {
		if (position === 'top') showTips(position, { text: '顶部消息提示~', type: 'primary' })
		else if (position === 'bottom') showTips(position, { text: '底部消息提示~', type: 'primary' })
		else showTips(position, { text: '居中消息提示~', type: 'primary' })
	}

	const onTipsDefault = () => {
		showTips(tipsPosition.value, { text: '一般消息提示~', type: 'default' })
	}

	const onTipsSuccess = () => {
		showTips(tipsPosition.value, { text: '成功消息提示~', type: 'success' })
	}

	const onTipsWarning = () => {
		showTips(tipsPosition.value, { text: '警告消息提示~', type: 'warning' })
	}

	const onTipsDanger = () => {
		showTips(tipsPosition.value, { text: '错误消息提示~', type: 'danger' })
	}

	const onTipsInfo = () => {
		showTips(tipsPosition.value, { text: '其他消息提示~', type: 'info' })
	}

	const onTipsPrimary = () => {
		showTips(tipsPosition.value, { text: '主色消息提示~', type: 'primary' })
	}

	const onTipsLong = () => {
		showTips(tipsPosition.value, {
			text: '这条提示有四十多个字，用来检查浮层在最大宽度内换行时，行高、上下留白和圆角是否仍然稳定。',
			type: 'default',
			duration: 3000
		})
	}

	const onTipsShort = () => {
		showTips(tipsPosition.value, { text: '1 秒后自动收起', type: 'info', duration: 1000 })
	}

	const onTipsLonger = () => {
		showTips(tipsPosition.value, { text: '4 秒后自动收起', type: 'info', duration: 4000 })
	}

	const onTipsSticky = () => {
		showTips(tipsPosition.value, { text: '常驻提示，点一下关闭', type: 'warning', duration: 0, closable: true })
	}

	const onTipsIcon = () => {
		showTips(tipsPosition.value, { text: '已同步到全部设备', type: 'success', icon: 'check-circle' })
	}

	const onTipsClosable = () => {
		showTips(tipsPosition.value, { text: '点提示任意位置都能关闭', type: 'default', duration: 0, closable: true })
	}

	const onTipsCustomColor = () => {
		showTips(tipsPosition.value, {
			text: '自定义底色和文字色',
			type: 'default',
			bgColor: '#142033',
			color: '#c8d3e3'
		})
	}

	const onTipsTranslucent = () => {
		showTips(tipsPosition.value, {
			text: '半透明底色，文字保持不透明',
			type: 'default',
			bgColor: '#142033',
			bgOpacity: 0.7,
			color: '#c8d3e3'
		})
	}

	const onTipsOpacity = () => {
		showTips('top', { text: '整条 60% 不透明', type: 'primary', opacity: 0.6 })
	}

	const onTipsOpacityMixed = () => {
		showTips('top', {
			text: '底色 0.7 × 整条 0.8',
			type: 'primary',
			opacity: 0.8,
			bgOpacity: 0.7
		})
	}

	const onTipsRich = () => {
		tipsVisible.value = false
		richTipsVisible.value = true
	}

	const onTipsOpen = () => {
		tipsPosition.value = 'center'
		tipsText.value = '由 open() 打开，2 秒后自动收起'
		tipsType.value = 'success'
		tipsIcon.value = 'check-circle'
		tipsDuration.value = 2000
		tipsClosable.value = false
		tipsBgColor.value = ''
		tipsBgOpacity.value = 1
		tipsColor.value = ''
		tipsOpacity.value = 1
		richTipsVisible.value = false
		tipsRef.value?.open?.()
	}

	const onTipsClose = () => {
		tipsRef.value?.close?.()
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>
