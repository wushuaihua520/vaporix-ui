								<view class="demo-no-data-tile__body">
									<vx-no-data size="sm" text="暂无消息">
										<template #icon>
											<view class="demo-no-data-art">
												<vx-icon name="inbox" size="lg" color="var(--vx-color-text-secondary)" />
											</view>
										</template>
									</vx-no-data>
								</view>
							</view>
						</view>
					</view>
					<text class="demo-hint">image 优先于 icon，icon 插槽优先于两者；自定义插图按方框等比展示，方框和线稿同宽。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">类型</text>
