								</view>
								<text class="demo-no-data-type__label">danger</text>
							</view>
							<view class="demo-no-data-type">
								<view class="demo-no-data-type__body">
									<vx-no-data size="sm" icon="alert-triangle" type="warning" text="库存不足" />
								</view>
								<text class="demo-no-data-type__label">warning</text>
							</view>
							<view class="demo-no-data-type">
								<view class="demo-no-data-type__body">
									<vx-no-data size="sm" icon="search" type="primary" text="没有找到" />
								</view>
								<text class="demo-no-data-type__label">primary</text>
							</view>
							<view class="demo-no-data-type">
								<view class="demo-no-data-type__body">
									<vx-no-data size="sm" icon="check-circle" type="success" text="都已处理" />
								</view>
								<text class="demo-no-data-type__label">success</text>
							</view>
							<view class="demo-no-data-type">
								<view class="demo-no-data-type__body">
									<vx-no-data size="sm" icon="info" type="info" text="暂无公告" />
								</view>
								<text class="demo-no-data-type__label">info</text>
							</view>
							<view class="demo-no-data-type">
								<view class="demo-no-data-type__body">
									<vx-no-data size="sm" text="暂无数据" />
								</view>
								<text class="demo-no-data-type__label">default</text>
							</view>
						</view>
					</view>
					<text class="demo-hint">线稿的纸边和加号跟 type 走，warning 取 warning-ink；图标圆用对应 *-soft 底。类型不是装饰，只在有状态含义时传。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
