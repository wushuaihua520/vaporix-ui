							<vx-text weight="medium" text="15123452222" />
						</view>
					</view>
					<text class="demo-hint">同一行多段文字各用一个实例，父级用 flex-direction: row; flex-wrap: wrap，间距由父级给。组件不加外边距、内边距和底色。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="类型" desc="default 和 secondary 是正文层级，其余语义色只表达状态。" />
					<view class="demo-tx-stage">
						<vx-text block text="default · 正文与主要内容" />
						<view class="demo-tx-gap">
							<vx-text block type="secondary" text="secondary · 次要说明与补充" />
						</view>
						<view class="demo-tx-gap">
							<vx-text block type="primary" text="primary · 品牌与当前状态" />
						</view>
						<view class="demo-tx-gap">
							<vx-text block type="success" text="success · 已完成" />
						</view>
						<view class="demo-tx-gap">
							<vx-text block type="info" text="info · 中性信息" />
						</view>
						<view class="demo-tx-gap">
							<vx-text block type="warning" text="warning · 需要留意" />
						</view>
						<view class="demo-tx-gap">
							<vx-text block type="danger" text="danger · 失败与风险" />
						</view>
					</view>
					<text class="demo-hint">warning 文本取 warning-ink，不直接用琥珀原色；语义色不要拿来装饰标题。</text>
