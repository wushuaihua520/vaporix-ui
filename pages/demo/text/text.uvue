						<view class="demo-tx-divider"></view>
						<text class="demo-tx-label">最近一次：{{ lastAction }}</text>
					</view>
					<text class="demo-hint">copyable 按下同样压到 0.8，长按才复制；Web 桌面端没有长按，要另给可见的复制按钮。</text>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">09</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">状态与组合</text>
