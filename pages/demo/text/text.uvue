</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	// 文本演示：只演示组件本身，标签用原生 text，避免把两个文本组件叠在一起看。
	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const lastAction = ref('还没有操作')

	const onCopy = (text: string) => {
		lastAction.value = '复制了「' + text + '」'
	}

	const onTextClick = (text: string) => {
		lastAction.value = '点击了「' + text + '」'
	}

	const prevPath: string = '/pages/demo/textarea/textarea'
	const nextPath: string = '/pages/demo/link/link'
	const prevName = '多行输入框'
	const nextName = '超链接'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
	/* 文本本身不加底色，演示用底板把每一组框出来。 */
	.demo-tx-stage {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-md);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-md);
		padding-left: var(--vx-space-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-surface);
	}

	.demo-tx-gap {
		margin-top: var(--vx-space-sm);
	}

	/* 标签和值按中线对齐；App 的 align-items 不支持 baseline。 */
	.demo-tx-row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		margin-top: var(--vx-space-sm);
	}

	.demo-tx-divider {
		width: 100%;
		height: 1px;
		margin-top: var(--vx-space-md);
		margin-bottom: var(--vx-space-md);
		background-color: var(--vx-color-divider);
	}

	.demo-tx-label {
		width: 116px;
		margin-right: var(--vx-space-sm);
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* 组合演示：一张用文本拼出来的订单卡。 */
	.demo-tx-card {
		box-sizing: border-box;
		width: 100%;
		padding-top: var(--vx-space-sm);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-sm);
		padding-left: var(--vx-space-md);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-sm);
		background-color: var(--vx-color-bg);
	}

	.demo-tx-card__row {
		flex-direction: row;
		align-items: center;
		padding-top: 6px;
		padding-bottom: 6px;
	}

	.demo-tx-card__label {
		width: 72px;
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}
</style>
