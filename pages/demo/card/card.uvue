<template>
	<view :class="pageClass">
		<demo-topbar title="卡片" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="card" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="默认卡片" desc="头像、标题、时间、正文和底部。头部默认带分割线。" />
					<view class="demo-card-lab">
						<view class="demo-card-lab__item">
							<vx-card title="CSDN云计算" meta="1小时前" avatar="/static/demo/card/avatar-cs.png"
								content="默认卡片内容部分 slot=>body" footer="默认卡片底部 slot=>footer" />
						</view>
						<view class="demo-card-lab__item demo-card-lab__item--last">
							<vx-card title="CSDN云计算" content="没有头像和右侧文字时，头部只渲染标题。"
								footer="底部仍可放来源或补充说明。" />
						</view>
					</view>
					<text class="demo-hint demo-card-hint">header 由 avatar / title / meta 组成，三者都可选；prefix / extra 插槽也能让头部出现，全空时才不渲染。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="头部设置" desc="头像形状、标题和时间颜色、头部底色与分割线。" />
					<view class="demo-card-lab">
						<view class="demo-card-lab__item">
							<vx-card title="标题文本" meta="1小时前" avatar="/static/demo/card/avatar-js.png"
								avatar-shape="circle" title-color="var(--vx-color-warning-ink)"
								meta-color="var(--vx-color-warning-ink)"
								content="头像换成圆形，标题和时间用同一个语义色。" footer="颜色是字面值，不跟随主题。" />
						</view>
						<view class="demo-card-lab__item">
							<vx-card title="CSDN云计算" meta="1小时前" avatar="/static/demo/card/avatar-cs.png"
								header-bg="var(--vx-color-default-soft)" :header-divider="false"
								meta-color="var(--vx-color-text)" content="头部底色单独设置，分割线可以关掉。"
								footer="headerBg 只改 header 底色。" />
						</view>
						<view class="demo-card-lab__item demo-card-lab__item--last">
							<vx-card title="Vaporix UI">
								<template #prefix>
									<view class="demo-card-icon">
										<vx-icon name="grid-2x2" size="lg" type="primary" />
									</view>
								</template>
								<template #extra>
									<vx-icon name="more-horizontal" size="sm"
										color="var(--vx-color-text-secondary)" />
								</template>
								<text class="demo-card-copy">prefix 放自定义图标，extra 放头部右侧操作；两者分别替换头像和 meta。</text>
							</vx-card>
						</view>
					</view>
					<text class="demo-hint demo-card-hint">avatarShape 切圆形；titleColor / metaColor 只覆盖对应文字；插槽内容不继承卡片颜色。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="尺寸" desc="sm / md / lg 改内边距、头像和标题；正文 sm 用 13。" />
					<view class="demo-card-lab">
						<view class="demo-card-lab__item">
							<vx-card size="sm" title="小号卡片" meta="sm" avatar="/static/demo/card/avatar-cs.png"
								content="正文 13 / 20，内边距 12。" footer="头像 32 · 标题 13" />
						</view>
						<view class="demo-card-lab__item">
							<vx-card title="常规卡片" meta="md" avatar="/static/demo/card/avatar-cs.png"
								content="正文 15 / 22，内边距 16。" footer="头像 40 · 标题 15" />
						</view>
						<view class="demo-card-lab__item demo-card-lab__item--last">
							<vx-card size="lg" title="大号卡片" meta="lg" avatar="/static/demo/card/avatar-cs.png"
								content="正文仍是 15 / 22，内边距 24。" footer="头像 48 · 标题 17" />
						</view>
					</view>
					<text class="demo-hint demo-card-hint">尺寸只改卡片自己的节奏；正文 lg 仍用 15 / 22，标题才跟到 17。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="通栏" desc="去掉左右描边和圆角，留下上下描边；默认的描边卡片不加阴影。" />
					<view class="demo-card-bleed">
						<vx-card full title="通栏卡片" meta="full" avatar="/static/demo/card/avatar-cs.png"
							header-bg="var(--vx-color-default-soft)" :header-divider="false"
							content="通栏卡片贴住内容区两侧，去掉左右描边和圆角。"
							footer="上下描边保留，用来和相邻区块分开。" />
					</view>
					<text class="demo-hint demo-card-hint">full 只处理左右描边和圆角；页面左右边距和卡片之间的距离仍由外层决定。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="富内容" desc="封面、文章行和展开操作；bodyPadded=false 让内容贴边。" />
					<view class="demo-card-lab">
						<view class="demo-card-lab__item demo-card-lab__item--last">
							<vx-card title="JavaScript" meta="昨天" avatar="/static/demo/card/avatar-js.png"
								:body-padded="false">
								<view class="demo-card-feature">
									<image class="demo-card-feature__image" src="/static/demo/card/cover.jpg"
										mode="aspectFill" />
									<view class="demo-card-feature__copy">
										<text class="demo-card-feature__eyebrow">前端 · 全栈</text>
										<text class="demo-card-feature__title">Vue + Node + 高德地图 + ECharts 做一款出行可视化全栈 WebApp</text>
										<text class="demo-card-feature__meta">3 小时前 · 1.2 万阅读</text>
									</view>
								</view>
								<vx-list-cell title=".NET Core 使用 Exceptionless 分布式日志收集"
									description="后端 · 8 分钟阅读" @click="onCardAction('Exceptionless 日志收集')">
									<template #prefix>
										<view class="demo-card-thumb">
											<image class="demo-card-thumb__image"
												src="/static/demo/card/thumb-2.jpg" mode="aspectFill" />
										</view>
									</template>
								</vx-list-cell>
								<vx-list-cell title="高德地图 + ECharts 做一款出行可视化全栈"
									description="前端 · 12 分钟阅读" :divider="cardFeedExpanded"
									@click="onCardAction('出行可视化')">
									<template #prefix>
										<view class="demo-card-thumb">
											<image class="demo-card-thumb__image"
												src="/static/demo/card/thumb-3.jpg" mode="aspectFill" />
										</view>
									</template>
								</vx-list-cell>
								<view v-if="cardFeedExpanded">
									<vx-list-cell title="Vue + Node 全栈出行可视化实战" description="实战 · 16 分钟阅读"
										@click="onCardAction('全栈出行可视化')">
										<template #prefix>
											<view class="demo-card-thumb">
												<image class="demo-card-thumb__image"
													src="/static/demo/card/thumb-1.jpg" mode="aspectFill" />
											</view>
										</template>
									</vx-list-cell>
									<vx-list-cell title="设计系统里的卡片应该怎么用" description="设计 · 6 分钟阅读"
										@click="onCardAction('卡片设计')">
										<template #prefix>
											<view class="demo-card-thumb">
												<image class="demo-card-thumb__image"
													src="/static/demo/card/grid-4.jpg" mode="aspectFill" />
											</view>
										</template>
									</vx-list-cell>
									<vx-list-cell title="Vaporix UI 0.22.0 更新说明" description="产品 · 3 分钟阅读"
										:divider="false" @click="onCardAction('0.22.0 更新说明')">
										<template #prefix>
											<view class="demo-card-thumb">
												<image class="demo-card-thumb__image"
													src="/static/demo/card/grid-5.jpg" mode="aspectFill" />
											</view>
										</template>
									</vx-list-cell>
								</view>
								<template #suffix>
									<view class="demo-card-more" hover-class="demo-card-more--pressed"
										@click="onCardFeedToggle">
										<text class="demo-card-more__text">{{ cardMoreLabel }}</text>
										<view class="demo-card-more__icon">
											<vx-icon :name="cardMoreIcon" size="sm"
												color="var(--vx-color-text-secondary)" />
										</view>
									</view>
								</template>
							</vx-card>
						</view>
					</view>
					<text class="demo-hint demo-card-hint">封面和列表贴边来自 bodyPadded=false；suffix 放展开操作。最近点击：{{ cardLastAction }}。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="图文网格" desc="一段正文加九宫格，底部放地点和时间。" />
					<view class="demo-card-lab">
						<view class="demo-card-lab__item demo-card-lab__item--last">
							<vx-card title="CSDN云计算" meta="7小时前" avatar="/static/demo/card/avatar-cs.png"
								footer="深圳 · 世界之窗 · 7 小时前">
								<text class="demo-card-quote">现实是此岸，成功是彼岸，中间隔着湍急的河流，兴趣便是河上的桥，只要行动就可以通过。</text>
								<view class="demo-card-grid">
									<view v-for="image in cardGridImages" :key="image" class="demo-card-grid__item">
										<image class="demo-card-grid__image" :src="image" mode="widthFix" />
									</view>
								</view>
							</vx-card>
						</view>
					</view>
					<text class="demo-hint demo-card-hint">默认插槽承载富内容；图片网格自己排三列，卡片只提供边界和内边距。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="可点击卡片" desc="整卡可点时按下变淡并抛 click；卡片里不要再放按钮和链接。" />
					<view class="demo-card-lab">
						<view class="demo-card-lab__item demo-card-lab__item--last">
							<vx-card clickable title="可点击卡片" avatar="/static/demo/card/avatar-cs.png"
								content="整卡可点时按下变淡，点击抛 click。卡片里不要再放入口、按钮和链接。"
								footer="点击整卡更新下面这行状态。" @click="onCardAction('可点击卡片')">
								<template #extra>
									<view class="demo-card-extra">
										<text class="demo-card-extra__meta">1小时前</text>
										<view class="demo-card-extra__icon">
											<vx-icon name="chevron-right" size="sm"
												color="var(--vx-color-text-secondary)" />
										</view>
									</view>
								</template>
							</vx-card>
						</view>
					</view>
					<text class="demo-hint demo-card-hint">最近点击：{{ cardLastAction }}。其他分区的卡片保持静态，整卡默认不可点。</text>
				</view>

				<demo-page-nav current-key="card" />

				<demo-footer />
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 卡片演示：展开状态、最近点击和九宫格图集共用一份数据。
	const cardLastAction = ref('还没有点击')

	const cardFeedExpanded = ref(false)

	const onCardAction = (label: string) => {
		cardLastAction.value = label
	}

	const onCardFeedToggle = () => {
		cardFeedExpanded.value = !cardFeedExpanded.value
	}

	const cardMoreLabel = computed((): string => {
		return cardFeedExpanded.value ? '收起' : '余下 3 篇'
	})

	const cardMoreIcon = computed((): string => {
		return cardFeedExpanded.value ? 'chevron-up' : 'chevron-down'
	})

	const cardGridImages: string[] = [
		'/static/demo/card/grid-1.jpg',
		'/static/demo/card/grid-2.jpg',
		'/static/demo/card/grid-3.jpg',
		'/static/demo/card/grid-4.jpg',
		'/static/demo/card/grid-5.jpg',
		'/static/demo/card/grid-6.jpg',
		'/static/demo/card/grid-7.jpg',
		'/static/demo/card/grid-8.jpg',
		'/static/demo/card/grid-9.jpg'
	]

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})


	onShow(() => {
		syncDemoTheme()
	})
</script>
