						<view class="demo-section__copy">
							<text class="demo-section__title">富内容</text>
							<text class="demo-section__desc">封面、文章行和展开操作；bodyPadded=false 让内容贴边。</text>
						</view>
					</view>
					<view class="demo-card-lab">
						<view class="demo-card-lab__item demo-card-lab__item--last">
