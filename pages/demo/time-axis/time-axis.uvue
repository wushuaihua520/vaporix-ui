			icon: 'close-circle',
			type: 'danger'
		},
		{ title: '等待揽收', description: 'default · 待处理', time: '14:00', icon: 'clock' }
	]

	const timeAxisSizeEntries: TimeAxisDemoEntry[] = [
		{
			title: '运输中',
			description: '包裹已到达北京转运中心',
			time: '10-25 09:20',
			icon: 'truck',
			type: 'primary'
		},
		{ description: '已离开上海转运中心', time: '10-25 06:10' }
	]

	const timeAxisEventEntries: TimeAxisDemoEntry[] = [
		{
			title: '运输中',
			description: '您的包裹正在运输途中',
			time: '10-25 09:20',
			icon: 'truck',
			type: 'primary'
		},
		{ description: '已到达北京转运中心', time: '10-25 09:20' },
		{ description: '已离开上海转运中心', time: '10-25 06:10' },
		{ description: '包裹已揽收', time: '10-24 21:40' },
		{ title: '仓库处理中', description: '打包完成，等待揽收', time: '10-24 18:30', icon: 'home' }
