	const timeAxisTypeEntries: TimeAxisDemoEntry[] = [
		{ title: '派送中', description: 'primary · 当前进度', time: '16:29', icon: 'user', type: 'primary' },
		{ title: '已签收', description: 'success · 已完成', time: '18:48', icon: 'check', type: 'success' },
		{ title: '运输中', description: 'info · 中性信息', time: '16:17', icon: 'truck', type: 'info' },
		{
			title: '天气延误',
			description: 'warning · 需要留意',
			time: '15:02',
			icon: 'alert-triangle',
			type: 'warning'
