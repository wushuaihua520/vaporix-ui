	}

	.demo-ws-panel__title {
		font-size: var(--vx-font-lg);
		line-height: var(--vx-line-lg);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
		margin-bottom: var(--vx-space-xs);
	}

	.demo-ws-panel__body {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* 三档和自定义高度共用一套刻度：左标签、右轨道。 */
	.demo-ws-scale {
		flex-direction: column;
		width: 100%;
	}

	.demo-ws-scale__row {
		flex-direction: row;
		align-items: center;
		width: 100%;
		margin-bottom: var(--vx-space-md);
	}

	.demo-ws-scale__row--last {
		margin-bottom: 0;
	}

	.demo-ws-scale__copy {
		flex-direction: column;
		flex-shrink: 0;
		width: 64px;
		margin-right: var(--vx-space-md);
	}

	.demo-ws-scale__name {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		color: var(--vx-color-text);
	}

	.demo-ws-scale__meta {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* flex 基准是 0，内边距要算进这一份宽度；content-box 会把轨道撑出这一行。 */
	.demo-ws-scale__track {
		box-sizing: border-box;
		flex: 1;
		flex-direction: column;
		min-width: 0;
		padding-top: var(--vx-space-md);
		padding-right: var(--vx-space-md);
		padding-bottom: var(--vx-space-md);
		padding-left: var(--vx-space-md);
		border-radius: var(--vx-radius-md);
		background-color: var(--vx-color-bg);
	}

	/* 宽度 100% 再加描边，content-box 会溢出轨道。不写死高度，行高 20 加描边才裁不到字。 */
	.demo-ws-bar {
		box-sizing: border-box;
		flex-direction: row;
		align-items: center;
		width: 100%;
		padding-left: var(--vx-space-sm);
		border-width: var(--vx-border-width);
		border-style: solid;
		border-color: var(--vx-color-border);
		border-radius: var(--vx-radius-sm);
		background-color: var(--vx-color-surface);
	}

	.demo-ws-bar__text {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* 页面节奏：一张真实卡片内部的纵向排布。 */
	.demo-ws-article {
		width: 100%;
	}

	.demo-ws-article__eyebrow {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		font-weight: var(--vx-weight-semibold);
		letter-spacing: 1px;
		color: var(--vx-color-primary);
	}

	.demo-ws-article__title {
		font-size: var(--vx-font-xl);
		line-height: var(--vx-line-xl);
		font-weight: var(--vx-weight-bold);
		color: var(--vx-color-text);
	}

	.demo-ws-article__body {
		font-size: var(--vx-font-md);
		line-height: var(--vx-line-md);
		color: var(--vx-color-text-secondary);
	}

	.demo-ws-article__tags {
		flex-direction: row;
		align-items: center;
	}

	/* 标签自带 align-self: flex-start，外面包一层对齐行高并留 8。 */
	.demo-ws-article__tag {
		flex-direction: row;
		align-items: center;
		margin-right: var(--vx-space-sm);
	}

	.demo-ws-article__tag--last {
		margin-right: 0;
	}

	.demo-ws-article__footer {
		padding-top: var(--vx-space-md);
		border-top-width: var(--vx-border-width);
		border-top-style: solid;
		border-top-color: var(--vx-color-border);
	}

	.demo-ws-article__footer-text {
		font-size: var(--vx-font-sm);
		line-height: var(--vx-line-sm);
		color: var(--vx-color-text-secondary);
	}

	/* 背景色带：留白本身透明，传 bgColor 后才成为一条平的色块。 */
	.demo-ws-band {
		width: 100%;
		margin-bottom: var(--vx-space-lg);
