				<demo-page-nav current-key="radio" />

				<demo-footer />
			</view>
		</scroll-view>
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 单选演示：整组共用一个 v-model，单项只带自己的 value 和文案。
	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const plan = ref('pro')
	const channel = ref('wechat')
	const sizeDemo = ref('s')
	const tone = ref('p')
	const colorDemo = ref('a')

	const onPlanChange = (value: string) => {
		// value 已经写回 v-model；请求和埋点放这里
	}


	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
