<template>
	<view :class="pageClass">
		<demo-topbar title="单项选择器" />
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<demo-hero current-key="radio" />

			<view class="demo-shell">
				<view class="demo-section">
					<demo-section-head title="基础" desc="v-model 绑选中项的 value；点已选中项不重复抛 change。" />
					<view class="demo-rd-stage">
						<vx-radio-group v-model="plan" @change="onPlanChange">
							<vx-radio value="basic" label="基础版" />
							<vx-radio value="pro" label="专业版" />
							<vx-radio value="team" label="团队版" />
						</vx-radio-group>
					</view>
					<text class="demo-hint">当前选中：{{ plan }}。整组只认一个值，父级写进来的值不在选项里时不显示任何一项。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="列表与卡片" desc="layout=&quot;list&quot; 一项一行；配 card 收进描边卡片，divider 画分割线。" />
					<view class="demo-rd-stage">
						<vx-radio-group v-model="channel" layout="list" card>
							<vx-radio value="sms" label="短信" description="发到 151****2222" />
							<vx-radio value="wechat" label="微信" description="服务号推送" />
							<vx-radio value="mail" label="邮件" description="hi@vaporix.dev" />
						</vx-radio-group>
					</view>
					<view class="demo-rd-stage demo-rd-stage--next">
						<text class="demo-rd-label">layout="list" · 无卡片 · 无分割线</text>
						<vx-radio-group v-model="channel" layout="list" :card="false" :divider="false">
							<vx-radio value="sms" label="短信" />
							<vx-radio value="wechat" label="微信" />
							<vx-radio value="mail" label="邮件" />
						</vx-radio-group>
					</view>
					<text class="demo-hint">card 只在 list 下生效；分割线默认打开，最后一项不画。</text>
				</view>

				<view class="demo-section">
					<demo-section-head title="标记位置" desc="placement=&quot;start&quot; 在文案前，end 推到行尾。" />
