<template>
	<view :class="pageClass">
		<scroll-view id="demo-scroll" class="demo-scroll" direction="vertical">
			<view class="demo-shell">
				<view class="demo-pagebar">
					<view class="demo-crumb">
						<view class="demo-crumb__back" hover-class="demo-crumb__back--pressed" @click="goCatalog">
							<vx-icon name="chevron-left" size="sm" />
							<text class="demo-crumb__back-text">组件</text>
						</view>
						<text class="demo-crumb__sep">/</text>
						<text class="demo-crumb__current">反馈</text>
					</view>
					<view class="demo-theme-toggle" hover-class="demo-theme-toggle--pressed"
						@click="toggleDemoPageTheme">
						<vx-icon :name="isDark ? 'sun' : 'moon'" size="md" />
					</view>
				</view>

				<view class="demo-hero">
					<text class="demo-hero__eyebrow">VAPORIX UI · vx-toast</text>
					<view class="demo-hero__top">
						<view class="demo-hero__icon">
							<vx-icon name="check-circle" size="lg" type="primary" />
						</view>
						<view class="demo-hero__heading">
							<view class="demo-hero__title-wrap">
								<text class="demo-hero__title">轻提示</text>
								<text class="demo-hero__title demo-hero__title--accent">8 组示例</text>
							</view>
						</view>
					</view>
					<text class="demo-hero__lead">图标加一句文案，点浮层可以提前关闭；默认半透明底，字和图标始终不透明。</text>
					<view class="demo-hero__chips">
						<view class="demo-chip">
							<text class="demo-chip__text">反馈</text>
						</view>
						<view class="demo-chip demo-chip--neutral">
							<text class="demo-chip__text demo-chip__text--neutral">vx-toast</text>
						</view>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">01</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">基础用法</text>
							<text class="demo-section__desc">成功、失败、信息三种结果，图标跟着 type 换。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" text="操作成功" @click="onToastSuccess" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" text="操作失败" @click="onToastDanger" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="提示信息" @click="onToastInfo" />
							</view>
						</view>
						<text class="demo-hint">盒子固定用正文色的反相底，亮暗主题自动互换；结果由图标形状和文案表达。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">02</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">无图标</text>
							<text class="demo-section__desc">关掉 showIcon，只留一行文案。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-button block type="default" text="提示信息，无icon" @click="onToastNoIcon" />
						<text class="demo-hint">没有图标时不占那一行高度，盒子的最小宽度和左右留白不变。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">03</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">多行文本</text>
							<text class="demo-section__desc">超过最大宽度就换行，盒子跟着长高。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-button block type="success" text="操作成功，多行文本" @click="onToastLong" />
						<text class="demo-hint">maxWidth 默认 240px，行高 22；超过三行说明信息量太大，改用页面区块。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">04</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">自定义图标</text>
							<text class="demo-section__desc">字体图标传名字，图片传地址，图片优先。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" text="字体图标" @click="onToastCustomIcon" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="图片地址" @click="onToastCustomImage" />
							</view>
						</view>
						<text class="demo-hint demo-toast-note">icon 取图标名，image 传图片地址；两个都传时图片优先，固定 40 × 40 等比展示。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">05</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">显示时间</text>
							<text class="demo-section__desc">duration 单位毫秒，0 常驻。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" text="1 秒" @click="onToastShort" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" text="3 秒" @click="onToastLonger" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="常驻" @click="onToastSticky" />
							</view>
						</view>
						<text class="demo-hint">常驻提示点浮层或调 close() 收起，不会把页面永久挡住。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">06</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">自定义颜色</text>
							<text class="demo-section__desc">底色和文字各管一处，不随主题切换。</text>
						</view>
					</view>
					<view class="demo-card">
						<vx-button block type="default" text="深色底 + 浅色字" @click="onToastCustomColor" />
						<text class="demo-hint">bgColor 改底色，color 改文案和字体图标；图片不参与着色。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">07</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">透明度</text>
							<text class="demo-section__desc">底色默认 0.9，只调底色，文字和图标不跟着淡。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" text="0.9 默认" @click="onToastOpacity(0.9)" />
							</view>
							<view class="demo-actions__item">
								<vx-button block size="sm" text="0.7" @click="onToastOpacity(0.7)" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="1 不透明" @click="onToastOpacity(1)" />
							</view>
						</view>
						<text class="demo-hint">bgOpacity 范围 0–1；低于默认值时，底色和页面内容的对比度由业务保证。</text>
					</view>
				</view>

				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">08</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">方法</text>
							<text class="demo-section__desc">ref 拿实例，open() 重新计时，close() 立刻收起。</text>
						</view>
					</view>
					<view class="demo-card">
						<view class="demo-actions">
							<view class="demo-actions__item">
								<vx-button block size="sm" type="primary" text="open() 打开" @click="onToastOpen" />
							</view>
							<view class="demo-actions__item demo-actions__item--last">
								<vx-button block size="sm" text="close() 关闭" @click="onToastClose" />
							</view>
						</view>
						<text class="demo-hint">open() 重新计时；close() 立刻收起并抛 close，自动关闭和点浮层也一样。</text>
					</view>
				</view>

				<view class="demo-page-nav">
					<view class="demo-page-nav__item"
						:class="prevPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goPrev">
						<text class="demo-page-nav__label">上一个</text>
						<text class="demo-page-nav__name">{{ prevName }}</text>
					</view>
					<view class="demo-page-nav__item demo-page-nav__item--next"
						:class="nextPath === '' ? 'demo-page-nav__item--disabled' : ''"
						hover-class="demo-page-nav__item--pressed" @click="goNext">
						<text class="demo-page-nav__label">下一个</text>
						<text class="demo-page-nav__name">{{ nextName }}</text>
					</view>
				</view>

				<view class="demo-footer">
					<text class="demo-footer__text">元汽UI · MIT</text>
					<text class="demo-footer__meta">VAPORIX UI · 组件演示 · v0.59.0</text>
				</view>
			</view>
		</scroll-view>

		<!-- 轻提示是全屏浮层，挂在页面根上；放进 scroll-view 会被滚动和裁剪。 -->
		<vx-toast ref="toastRef" v-model:show="toastVisible" :text="toastText" :type="toastType"
			:duration="toastDuration" :icon="toastIcon" :image="toastImage" :show-icon="toastShowIcon"
			:bg-color="toastBgColor" :bg-opacity="toastBgOpacity" :color="toastColor" />
	</view>
</template>

<script setup>
	import { demoIsDark, syncDemoTheme, toggleDemoPageTheme } from '@/pages/demo/shared/theme'

	type ToastSemantic = 'primary' | 'success' | 'info' | 'warning' | 'danger' | 'default'

	type ToastIcon = 'check-circle' | 'close-circle' | 'alert-circle' | 'info' | 'heart'

	type ToastOptions = {
		text: string
		type: ToastSemantic
		duration?: number
		icon?: ToastIcon | null
		image?: string
		showIcon?: boolean
		bgColor?: string
		bgOpacity?: number
		color?: string
	}

	// 轻提示同样只放一个实例：先改状态再 open()，图标、图片和时长不会串到下一条。
	const toastVisible = ref(false)

	const toastText = ref('')

	const toastType = ref<ToastSemantic>('default')

	const toastDuration = ref(2000)

	const toastIcon = ref<ToastIcon | null>(null)

	const toastImage = ref('')

	const toastShowIcon = ref(true)

	const toastBgColor = ref('')

	const toastBgOpacity = ref(0.9)

	const toastColor = ref('')

	const toastRef = ref<VxToastComponentPublicInstance | null>(null)

	// 演示用的小图，业务换成自己的 icon 地址即可。
	const toastCustomImage = '/static/demo/toast-custom.png'

	const note = ref('')

	// 先改状态再调 open()：同一条提示连点也重新计时，不用先关再开。
	const showToast = (options: ToastOptions) => {
		toastType.value = options.type
		toastText.value = options.text
		toastDuration.value = options.duration != null ? options.duration : 2000
		toastIcon.value = options.icon != null ? options.icon : null
		toastImage.value = options.image != null ? options.image : ''
		toastShowIcon.value = options.showIcon != null ? options.showIcon : true
		toastBgColor.value = options.bgColor != null ? options.bgColor : ''
		toastBgOpacity.value = options.bgOpacity != null ? options.bgOpacity : 0.9
		toastColor.value = options.color != null ? options.color : ''
		toastRef.value?.open?.()
	}

	const onToastSuccess = () => {
		showToast({ text: '操作成功', type: 'success' })
	}

	const onToastDanger = () => {
		showToast({ text: '操作失败', type: 'danger' })
	}

	const onToastInfo = () => {
		showToast({ text: '提示信息', type: 'info' })
	}

	const onToastNoIcon = () => {
		showToast({ text: '提示信息，无icon', type: 'info', showIcon: false })
	}

	const onToastLong = () => {
		showToast({
			text: '操作成功，这是一条多行文本，用来检查换行、行高和盒子高度是否稳定。',
			type: 'success',
			duration: 3000
		})
	}

	const onToastCustomIcon = () => {
		showToast({ text: '已加入收藏', type: 'success', icon: 'heart', duration: 2500 })
	}

	const onToastCustomImage = () => {
		showToast({ text: '已加入收藏', type: 'success', image: toastCustomImage, duration: 2500 })
	}

	const onToastShort = () => {
		showToast({ text: '1 秒后自动收起', type: 'info', duration: 1000 })
	}

	const onToastLonger = () => {
		showToast({ text: '3 秒后自动收起', type: 'info', duration: 3000 })
	}

	const onToastSticky = () => {
		showToast({ text: '常驻提示，点一下收起', type: 'default', duration: 0 })
	}

	const onToastCustomColor = () => {
		showToast({
			text: '自定义底色和文字色',
			type: 'default',
			bgColor: '#142033',
			color: '#c8d3e3'
		})
	}

	const onToastOpacity = (value: number) => {
		showToast({ text: `底色不透明度 ${value}`, type: 'success', bgOpacity: value })
	}

	const onToastOpen = () => {
		showToast({ text: '由 open() 打开，2 秒后自动收起', type: 'success' })
	}

	const onToastClose = () => {
		toastRef.value?.close?.()
	}

	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const prevPath: string = '/pages/demo/tips/tips'
	const nextPath: string = '/pages/demo/loading/loading'
	const prevName = '消息提示'
	const nextName = '加载与尾部'

	const goCatalog = () => {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
			return
		}
		uni.switchTab({ url: '/pages/index/index' })
	}

	const goPrev = () => {
		if (prevPath === '') return
		uni.redirectTo({ url: prevPath })
	}

	const goNext = () => {
		if (nextPath === '') return
		uni.redirectTo({ url: nextPath })
	}

	onShow(() => {
		syncDemoTheme()
	})
</script>
