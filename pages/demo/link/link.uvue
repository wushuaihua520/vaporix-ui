				<view class="demo-section">
					<view class="demo-section__head">
						<view class="demo-section__num">
							<text class="demo-section__num-text">07</text>
						</view>
						<view class="demo-section__copy">
							<text class="demo-section__title">状态与组合</text>
							<text class="demo-section__desc">禁用转 disabled-text 且不抛事件；下面是一段夹着链接的协议文案。</text>
						</view>
					</view>
					<view class="demo-lk-stage">
						<vx-link block disabled href="https://gitee.com/DonkeySmall/vaporix-ui" text="已停用 · 不响应点按" @click="onClick" />
