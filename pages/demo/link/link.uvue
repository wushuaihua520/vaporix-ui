							<vx-link href="https://gitee.com/DonkeySmall/vaporix-ui" text="《服务协议》" @click="onClick" />
							<text class="demo-lk-flow__text">和</text>
							<vx-link href="https://gitee.com/DonkeySmall/vaporix-ui" text="《隐私政策》" @click="onClick" />
							<text class="demo-lk-flow__text">，并授权我们处理订单信息。</text>
						</view>
					</view>
