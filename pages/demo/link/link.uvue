</template>

<script setup>
	import { demoIsDark, syncDemoTheme } from '@/pages/demo/shared/theme'

	// 链接演示：点击只记录，打开和复制由组件按平台处理。
	const isDark = demoIsDark

	const pageClass = computed((): string => {
		return isDark.value ? 'demo-page vx-theme-dark' : 'demo-page vx-theme-light'
	})

	const lastAction = ref('还没有操作')

	const onClick = (href: string) => {
		lastAction.value = '点击了「' + href + '」'
	}

	const onCopy = (value: string) => {
		lastAction.value = '复制了「' + value + '」'
	}


	onShow(() => {
		syncDemoTheme()
	})
</script>

<style>
	/* 链接本身不加底色，演示用底板把每一组框出来。 */
