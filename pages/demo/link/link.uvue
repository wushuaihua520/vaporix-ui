							<text class="demo-lk-label">action="none" · 只抛事件</text>
							<vx-link block href="https://gitee.com/DonkeySmall/vaporix-ui" text="交给业务处理，组件不打开也不复制" action="none" @click="onClick" />
						</view>
						<view class="demo-lk-divider"></view>
						<text class="demo-lk-label">tel: 与 mailto:</text>
						<vx-link href="tel:10086" text="拨号 10086" @click="onClick" />
						<view class="demo-lk-gap">
							<vx-link href="mailto:hi@vaporix.dev" text="发邮件 hi@vaporix.dev" @click="onClick" />
						</view>
					</view>
					<text class="demo-hint">App 和小程序不能直接打开外部网页，默认复制并提示；要打开浏览器就 action="none" 接 openSchema 插件。最近一次：{{ lastAction }}。</text>
